const inner = paths[name] ?? '';
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={width}
  height={height}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  style={style}
  aria-hidden={ariaHidden}
  set:html={inner}
/>
