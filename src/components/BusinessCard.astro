---
import siteConfig from '../lib/site-config';
import { formatPhone } from '../lib/site-config';
---

<aside
  aria-label="Business information"
  class="mt-14 p-6 sm:p-8 rounded-[var(--radius-lg)] flex flex-col sm:flex-row gap-6"
  style="background:var(--color-neutral-50,#f9fafb); border:1px solid #e4e4e7;"
>
  <div class="flex flex-col gap-3 flex-1">
    <p class="text-base font-bold text-[var(--color-text)]">{siteConfig.name}</p>

    <address class="not-italic flex flex-col gap-2 text-sm" style="color:var(--color-text-muted);">
      {siteConfig.address && (
        <span class="flex items-start gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>
            {siteConfig.address}<br />
            {siteConfig.city}, {siteConfig.state} {siteConfig.zip}
          </span>
        </span>
      )}

      {siteConfig.phone && (
        <a href={`tel:${siteConfig.phone.replace(/\D/g, '')}`} class="flex items-center gap-2 hover:text-[var(--color-brand)] transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.36a2 2 0 0 1 1.99-2.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.06 6.06l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          {formatPhone(siteConfig.phone)}
        </a>
      )}

      {siteConfig.email && (
        <a href={`mailto:${siteConfig.email}`} class="flex items-center gap-2 hover:text-[var(--color-brand)] transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          {siteConfig.email}
        </a>
      )}
    </address>
  </div>

  {siteConfig.gbpUrl && (
    <div class="flex sm:flex-col items-start sm:items-end justify-start gap-3 shrink-0">
      <a
        href={siteConfig.gbpUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-[var(--radius-md)] text-sm font-semibold transition-opacity hover:opacity-90"
        style="background-color:var(--rs-brand); color:var(--rs-on-brand);"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        View on Google Maps
      </a>
    </div>
  )}
</aside>
