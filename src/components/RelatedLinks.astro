---
/**
 * RelatedLinks.astro
 *
 * Renders the `relatedLinks` array sent per-page in the publish payload
 * from the RankSite app (internal_linking_enabled). Each entry has:
 *   { title: string, url: string, description?: string }
 *
 * The block is only rendered when the page's frontmatter includes a
 * non-empty relatedLinks array. It slots after the main prose/FAQ
 * sections as a cross-link band.
 */

export interface RelatedLink {
  title: string;
  url: string;
  description?: string;
}

interface Props {
  links: RelatedLink[];
  heading?: string;
}

const { links, heading = 'Related Pages' } = Astro.props;
const safeLinks = (links || []).filter((l) => l && l.title && l.url);
---

{safeLinks.length > 0 && (
  <section class="related-links-section" aria-labelledby="related-links-heading">
    <h2 id="related-links-heading" class="related-links-heading">{heading}</h2>
    <div class="related-links-grid">
      {safeLinks.map((link) => (
        <a href={link.url} class="related-link-card">
          <div class="related-link-card__body">
            <p class="related-link-card__title">{link.title}</p>
            {link.description && (
              <p class="related-link-card__desc">{link.description}</p>
            )}
          </div>
          <svg class="related-link-card__arrow" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-links-section {
    margin-top: 3rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--rs-border, #e5e7eb);
  }
  .related-links-heading {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text, #1f2937);
    margin: 0 0 1.25rem 0;
    letter-spacing: -0.01em;
  }
  .related-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.75rem;
  }
  .related-link-card {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1rem;
    border-radius: var(--radius-md, 10px);
    background: var(--rs-surface-2, #f9fafb);
    border: 1px solid var(--rs-border, #e5e7eb);
    text-decoration: none;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
  }
  .related-link-card:hover {
    border-color: color-mix(in srgb, var(--rs-brand, #2563eb) 40%, transparent);
    box-shadow: 0 2px 8px color-mix(in srgb, var(--rs-brand, #2563eb) 10%, transparent);
    transform: translateY(-1px);
  }
  .related-link-card__body {
    flex: 1;
    min-width: 0;
  }
  .related-link-card__title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text, #1f2937);
    margin: 0;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .related-link-card__desc {
    font-size: 0.75rem;
    color: var(--color-text-muted, #6b7280);
    margin: 0.1875rem 0 0 0;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .related-link-card__arrow {
    flex-shrink: 0;
    color: var(--rs-brand-text, #2563eb);
    opacity: 0.6;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }
  .related-link-card:hover .related-link-card__arrow {
    opacity: 1;
    transform: translateX(2px);
  }
  [data-skin="dark"] .related-link-card {
    background: var(--rs-surface-2, #1e1e2e);
    border-color: var(--rs-border, #2e2e3e);
  }
  [data-skin="dark"] .related-link-card__title {
    color: var(--color-text, #e5e7eb);
  }
  [data-skin="dark"] .related-link-card__desc {
    color: var(--color-text-muted, #9ca3af);
  }
</style>
