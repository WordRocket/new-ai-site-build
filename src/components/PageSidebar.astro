---
import siteConfig, { formatPhone } from '../lib/site-config';
import { getPreset } from '../lib/business-presets';
import { iconSvg } from '../lib/icons';

interface ServiceItem {
  slug: string;
  title: string;
}

interface LocationItem {
  slug: string;
  city: string;
  service: string;
}

interface Props {
  pageType: 'service' | 'location';
  currentSlug: string;
  serviceTitle?: string;  // service page: d.title; location page: d.service
  city?: string;          // location page only: d.city
  services: ServiceItem[];
  locations: LocationItem[];
}

const { pageType, currentSlug, serviceTitle, city, services, locations } = Astro.props;

const preset = getPreset((siteConfig as any).businessType || 'other');
const signals = preset.trustSignals;

const phoneDigits = siteConfig.phone ? siteConfig.phone.replace(/\D/g, '') : '';
const showPhone = !!siteConfig.phone;
const openingHours = (siteConfig as any).openingHours as string[] | undefined;
const showHours = Array.isArray(openingHours) && openingHours.length > 0;

// ── Block visibility booleans ─────────────────────────────────────────────
// Each is a single clear boolean; extend to an explicit user toggle here later.
const showCta      = true;
const showTrust    = signals.length > 0;
const showServices = services.length > 0;

// "Service Areas" (service page) or "Other Areas" (location page)
let areasToShow: Array<{ href: string; label: string }> = [];
if (pageType === 'service') {
  // Normalize for case/whitespace to prevent silent mismatch
  const normalised = (serviceTitle ?? '').trim().toLowerCase();
  areasToShow = locations
    .filter(l => l.service.trim().toLowerCase() === normalised)
    .map(l => ({ href: `/${l.slug.replace(/^\/+/, '')}`, label: l.city }));
} else {
  // Sibling location pages — exclude the current one
  areasToShow = locations
    .filter(l => l.slug !== currentSlug)
    .map(l => ({ href: `/${l.slug.replace(/^\/+/, '')}`, label: l.city }));
}

// Show area block if we have links, OR as a service page fallback with siteConfig.city
const showAreas =
  areasToShow.length > 0 ||
  (pageType === 'service' && locations.length === 0 && !!siteConfig.city);

// "Services in [city]" — location pages only
const showCityServices = pageType === 'location' && services.length > 0;

const areasHeading       = pageType === 'service' ? 'Service Areas' : 'Other Areas';
const cityServicesHeading = city ? `Services in ${city}` : 'Our Services';
---

<div class="sb-wrap">

  <!-- ① CTA card — always shown, visual anchor of the sidebar -->
  <div class="sb-card sb-cta-card">
    <p class="sb-eyebrow">Prefer to talk?</p>
    {showPhone && (
      <a href={`tel:${phoneDigits}`} class="sb-phone" aria-label={`Call ${siteConfig.name}`}>
        {formatPhone(siteConfig.phone)}
      </a>
    )}
    <a href="/contact" class="sb-cta-btn">
      Get a Free Quote
    </a>
    {showHours && (
      <ul class="sb-hours" aria-label="Business hours">
        {openingHours!.map((h: string) => (
          <li>{h}</li>
        ))}
      </ul>
    )}
  </div>

  <!-- ② Trust badges — hidden on mobile (TrustBar handles mobile trust signals) -->
  {showTrust && (
    <div class="sb-card sb-trust-card sb-trust-mobile-hide" aria-label="Why choose us">
      {signals.map(({ icon, label }) => (
        <div class="sb-trust-item">
          <span class="sb-trust-icon" aria-hidden="true">
            <Fragment set:html={iconSvg(icon, 16)} />
          </span>
          <span class="sb-trust-label">{label}</span>
        </div>
      ))}
    </div>
  )}

  <!-- ③ Our Services — crawlable <a> links (SEO silo) -->
  {showServices && (
    <div class="sb-card sb-links-card">
      <p class="sb-block-heading">Our Services</p>
      <ul class="sb-link-list">
        {services.map(s => (
          <li>
            <a
              href={`/services/${s.slug}`}
              class={[
                'sb-link',
                pageType === 'service' && s.slug === currentSlug ? 'sb-link--active' : '',
              ].filter(Boolean).join(' ')}
            >
              <span>{s.title}</span>
              <svg class="sb-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}

  <!-- ④ Service Areas / Other Areas — crawlable links or city fallback -->
  {showAreas && (
    <div class="sb-card sb-links-card">
      <p class="sb-block-heading">{areasHeading}</p>
      {areasToShow.length > 0 ? (
        <ul class="sb-link-list">
          {areasToShow.map(a => (
            <li>
              <a
                href={a.href}
                class={[
                  'sb-link',
                  a.href === `/${currentSlug}` ? 'sb-link--active' : '',
                ].filter(Boolean).join(' ')}
              >
                <span>{a.label}</span>
                <svg class="sb-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="sb-fallback">{siteConfig.city}, {siteConfig.state}</p>
      )}
    </div>
  )}

  <!-- ⑤ Services in [city] — location page only, links back up the content hierarchy -->
  {showCityServices && (
    <div class="sb-card sb-links-card">
      <p class="sb-block-heading">{cityServicesHeading}</p>
      <ul class="sb-link-list">
        {services.map(s => (
          <li>
            <a href={`/services/${s.slug}`} class="sb-link">
              <span>{s.title}</span>
              <svg class="sb-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}

</div>

<style>
  .sb-wrap {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* ── Base card ──────────────────────────────────────────────────────────── */
  .sb-card {
    border-radius: var(--radius-md, 12px);
    overflow: hidden;
  }

  /* ── ① CTA card ──────────────────────────────────────────────────────────
     Tinted brand background gives it more presence than the plain link cards.
     Uses --rs-brand-tint + --rs-brand-tint-border (both defined in :root and
     overridden in [data-skin="dark"]) so it adapts to every skin.             */
  .sb-cta-card {
    padding: 1.5rem;
    background: var(--rs-brand-subtle);
    border: 1px solid var(--rs-brand-tint-border);
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .sb-eyebrow {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--rs-text-muted);
    margin: 0;
    line-height: 1;
  }

  /* Large brand-colored phone — the visual hero of the CTA card */
  .sb-phone {
    display: block;
    font-size: 1.625rem;
    font-weight: 800;
    line-height: 1.1;
    color: var(--rs-brand-text);
    text-decoration: none;
    letter-spacing: -0.02em;
    transition: opacity 0.15s ease;
  }
  .sb-phone:hover { opacity: 0.75; }

  /* Full-width primary button */
  .sb-cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.625rem 1rem;
    border-radius: var(--radius-md, 8px);
    background: linear-gradient(135deg, var(--rs-accent) 0%, color-mix(in srgb, var(--rs-accent) 78%, #fff) 100%);
    color: var(--rs-on-brand);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    text-align: center;
    box-shadow: 0 4px 14px color-mix(in srgb, var(--rs-accent) 28%, transparent);
    transition: opacity 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .sb-cta-btn:hover {
    opacity: 0.92;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px color-mix(in srgb, var(--rs-accent) 40%, transparent);
  }
  .sb-cta-btn:active { transform: none; opacity: 1; }

  .sb-hours {
    list-style: none;
    margin: 0.125rem 0 0;
    padding: 0.75rem 0 0;
    border-top: 1px solid var(--rs-border);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .sb-hours li {
    font-size: 0.8125rem;
    color: var(--rs-text-muted);
    line-height: 1.5;
  }

  /* ── ② Trust badges ───────────────────────────────────────────────────── */
  .sb-trust-card {
    padding: 1.25rem 1.5rem;
    background: var(--rs-surface);
    border: 1px solid var(--rs-border);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Hidden on mobile — TrustBar already shows trust signals below the hero */
  @media (max-width: 1023px) {
    .sb-trust-mobile-hide { display: none; }
  }

  .sb-trust-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .sb-trust-icon {
    flex-shrink: 0;
    color: var(--rs-brand-text);
    display: flex;
    align-items: center;
  }

  .sb-trust-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--rs-text);
    line-height: 1.3;
  }

  /* ── ③④⑤ Link list cards ─────────────────────────────────────────────── */
  .sb-links-card {
    padding: 1.25rem 1.5rem;
    background: var(--rs-surface);
    border: 1px solid var(--rs-border);
  }

  /* Eyebrow block heading with a thin brand-tinted underline */
  .sb-block-heading {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--rs-text-muted);
    margin: 0 0 0.875rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid color-mix(in srgb, var(--rs-accent) 18%, transparent);
  }

  .sb-link-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Thin separator between items — slightly faded so it doesn't feel heavy */
  .sb-link-list li + li {
    border-top: 1px solid color-mix(in srgb, var(--rs-border) 70%, transparent);
  }

  .sb-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5625rem 0;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--rs-text);
    text-decoration: none;
    transition: color 0.15s ease, padding-left 0.15s ease;
  }
  .sb-link:hover {
    color: var(--rs-brand-text);
    padding-left: 0.25rem;
  }
  .sb-link--active {
    color: var(--rs-brand-text);
    font-weight: 600;
  }

  /* Chevron arrow nudges right on hover */
  .sb-chevron {
    flex-shrink: 0;
    opacity: 0.35;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .sb-link:hover .sb-chevron  { opacity: 1; transform: translateX(2px); }
  .sb-link--active .sb-chevron { opacity: 0.65; }

  .sb-fallback {
    font-size: 0.875rem;
    color: var(--rs-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .sb-link, .sb-phone, .sb-cta-btn, .sb-chevron { transition: none; }
    .sb-link:hover { padding-left: 0; }
    .sb-cta-btn:hover { transform: none; }
  }
</style>
