---
import { imgUrl, imgSrcset } from '../lib/image';

interface Props {
  title: string;
  description?: string;
  image?: string;
  href: string;
  icon?: string;
  class?: string;
}

const { title, description, image, href, icon, class: className } = Astro.props;
const optimizedImage = image ? imgUrl(image, { w: 800, h: 450 }) : undefined;
const srcset = image ? imgSrcset(image, [400, 800], { q: 82 }) : '';
---

<article class:list={['sc-card', className]}>
  <div class="sc-media">
    {optimizedImage ? (
      <img
        class="sc-img"
        src={optimizedImage}
        srcset={srcset || undefined}
        sizes={srcset ? '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw' : undefined}
        alt=""
        role="presentation"
        loading="lazy"
        decoding="async"
        width="800"
        height="450"
      />
    ) : (
      <div class="sc-icon" aria-hidden="true">
        {icon && <Fragment set:html={icon} />}
      </div>
    )}
  </div>

  <div class="sc-body">
    <h3 class="sc-title">{title}</h3>
    {description && <p class="sc-desc">{description}</p>}
    <a href={href} class="sc-link" aria-label={`Learn more about ${title}`}>
      Learn More <span class="sc-arrow">→</span>
    </a>
  </div>
</article>

<style>
  .sc-card {
    display: flex;
    flex-direction: column;
    background: var(--rs-surface);
    border: 1px solid var(--rs-border);
    border-radius: var(--rs-radius-md);
    overflow: hidden;
    box-shadow: var(--rs-shadow-card);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    height: 100%;
  }
  .sc-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--rs-shadow-card-hover);
  }
  @media (prefers-reduced-motion: reduce) {
    .sc-card { transition: box-shadow 0.2s ease; }
    .sc-card:hover { transform: none; }
  }

  .sc-media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--rs-surface-2);
  }

  .sc-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .sc-card:hover .sc-img {
    transform: scale(1.04);
  }
  @media (prefers-reduced-motion: reduce) {
    .sc-card:hover .sc-img { transform: none; }
  }

  .sc-icon {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--rs-brand-tint);
    color: var(--rs-brand);
  }

  .sc-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 1.5rem 1.5rem;
    flex: 1;
  }

  .sc-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--rs-text);
    line-height: 1.3;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .sc-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--rs-text-muted);
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .sc-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--rs-brand);
    text-decoration: none;
    margin-top: auto;
    padding-top: 0.75rem;
    transition: gap 0.15s ease;
  }
  .sc-link:hover { gap: 0.5rem; }

  .sc-arrow {
    display: inline-block;
    transition: transform 0.15s ease;
  }
  .sc-link:hover .sc-arrow { transform: translateX(3px); }
</style>
