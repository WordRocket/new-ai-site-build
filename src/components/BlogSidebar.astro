---
import siteConfig, { formatPhone } from '../lib/site-config';
import { getPreset } from '../lib/business-presets';
import { iconSvg } from '../lib/icons';
import SmartImage from './SmartImage.astro';
import { getCollection } from 'astro:content';
import { isLocalSite } from '../lib/siteMode';

interface Heading {
  text: string;
  slug: string;
}

interface RelatedPost {
  slug: string;
  title: string;
  datePublished: string;
}

interface Props {
  currentSlug: string;
  readingTime: number;
  datePublished: string;
  tags?: string[];
  headings: Heading[];
  relatedPosts: RelatedPost[];
}

const { currentSlug, readingTime, datePublished, tags = [], headings, relatedPosts } = Astro.props;

const preset = getPreset((siteConfig as any).businessType || 'other');
const signals = preset.trustSignals;

const phoneDigits = siteConfig.phone ? siteConfig.phone.replace(/\D/g, '') : '';
const showPhone = !!siteConfig.phone;

const sidebarImage: string = ((siteConfig as any).sidebarImage ?? '').trim();
const hasSidebarImage = sidebarImage.length > 0;

const showToc     = headings.length >= 3;
const showTags    = tags.length > 0;
const showRelated = relatedPosts.length > 0;
const displayTags = tags.slice(0, 5);

// Review data — appended to the inline trust list inside the CTA card
const reviewRating      = (siteConfig as any).reviewRating;
const reviewCount       = (siteConfig as any).reviewCount;
const reviewPlatform    = ((siteConfig as any).reviewPlatform  || 'Google').trim();
const reviewPlatformUrl = ((siteConfig as any).reviewPlatformUrl ?? '').trim();
const hasReview         = !!reviewRating && String(reviewRating).trim() !== '';

function formatCount(n: string | number): string {
  const num = Number(n);
  return isNaN(num) ? String(n) : num.toLocaleString('en-US');
}

const ratingDisplay = hasReview ? String(reviewRating).trim() : '';
const countDisplay  = hasReview && reviewCount ? formatCount(reviewCount) : '';
const reviewHasUrl  = reviewPlatformUrl.length > 0;

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}

const showTrustSection = signals.length > 0 || hasReview;
---

<div class="sb-wrap">

  <!-- ① CTA card — sticky, always shown -->
  <div class="sb-card sb-cta-card" data-has-image={hasSidebarImage ? 'true' : undefined}>
    {hasSidebarImage && (
      <div class="sb-cta-bg" aria-hidden="true">
        <SmartImage
          src={sidebarImage}
          alt=""
          aspect="4/3"
          loading="lazy"
          style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;"
        />
        <div class="sb-cta-scrim"></div>
      </div>
    )}
    <div class="sb-cta-content">
      <p class="sb-eyebrow">Prefer to talk?</p>
      {showPhone && (
        <a href={`tel:${phoneDigits}`} class="sb-phone" aria-label={`Call ${siteConfig.name}`}>
          {formatPhone(siteConfig.phone)}
        </a>
      )}
      <a href="/contact" class="sb-cta-btn">
        {isLocalSite() ? 'Get a Free Quote' : 'Get in Touch'}
      </a>

      {showTrustSection && (
        <ul class="sb-trust-inline" aria-label="Why choose us">
          {signals.slice(0, 3).map(({ icon, label }) => (
            <li class="sb-trust-inline-item">
              <span class="sb-trust-icon" aria-hidden="true">
                <Fragment set:html={iconSvg(icon, 14)} />
              </span>
              <span>{label}</span>
            </li>
          ))}

          {hasReview && (
            <li class={`sb-trust-inline-item sb-review-item${signals.length > 0 ? ' sb-review-divider' : ''}`}>
              {reviewHasUrl ? (
                <a
                  href={reviewPlatformUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="sb-review-link"
                  aria-label={`${ratingDisplay} · ${countDisplay ? `${countDisplay} ` : ''}${reviewPlatform} Reviews — opens in new tab`}
                >
                  <span class="sb-review-inner">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="var(--rs-star)" class="sb-review-star" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    <strong class="sb-review-rating">{ratingDisplay}</strong>
                    <span class="sb-review-meta"> · {countDisplay ? `${countDisplay} ` : ''}{reviewPlatform} Reviews</span>
                  </span>
                  <svg class="sb-review-ext" xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              ) : (
                <span class="sb-review-inner">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="var(--rs-star)" class="sb-review-star" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  <strong class="sb-review-rating">{ratingDisplay}</strong>
                  <span class="sb-review-meta"> · {countDisplay ? `${countDisplay} ` : ''}{reviewPlatform} Reviews</span>
                </span>
              )}
            </li>
          )}
        </ul>
      )}
    </div>
  </div>

  <!-- ② TOC card -->
  {showToc && (
    <div class="sb-card sb-links-card">
      <p class="sb-block-heading">In This Article</p>
      <ol class="sb-toc-list">
        {headings.map((h) => (
          <li>
            <a href={`#${h.slug}`} class="sb-toc-link">{h.text}</a>
          </li>
        ))}
      </ol>
    </div>
  )}

  <!-- ③ Reading time + meta card -->
  <div class="sb-card sb-meta-card">
    <div class="sb-meta-row">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="sb-meta-icon"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <span class="sb-meta-label">{readingTime} min read</span>
    </div>
    <div class="sb-meta-row">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="sb-meta-icon"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      <time datetime={datePublished} class="sb-meta-label">{formatDate(datePublished)}</time>
    </div>
    {showTags && (
      <div class="sb-tags">
        {displayTags.map((tag) => (
          <span class="sb-tag">{tag}</span>
        ))}
      </div>
    )}
  </div>

  <!-- ④ Related posts card -->
  {showRelated && (
    <div class="sb-card sb-links-card">
      <p class="sb-block-heading">Related Articles</p>
      <ul class="sb-link-list">
        {relatedPosts.map((p) => (
          <li class="sb-related-item">
            <a href={`/blog/${p.slug}`} class="sb-related-link">{p.title}</a>
            <time datetime={p.datePublished} class="sb-related-date">{formatDate(p.datePublished)}</time>
          </li>
        ))}
      </ul>
    </div>
  )}

</div>

<style>
  .sb-wrap {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .sb-card {
    border-radius: var(--radius-md, 12px);
    overflow: hidden;
  }

  /* ── CTA card ─────────────────────────────────────────────────────── */
  .sb-cta-card {
    position: relative;
    background: var(--rs-brand-subtle);
    border: 1px solid var(--rs-brand-tint-border);
    display: flex;
    flex-direction: column;
  }
  .sb-cta-card[data-has-image] {
    background: none;
    border-color: transparent;
  }
  .sb-cta-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    overflow: hidden;
  }
  .sb-cta-scrim {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    z-index: 1;
  }
  .sb-cta-content {
    position: relative;
    z-index: 2;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .sb-cta-card[data-has-image] .sb-eyebrow { color: rgba(255,255,255,0.75); }
  .sb-cta-card[data-has-image] .sb-phone   { color: #fff; }

  .sb-eyebrow {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--rs-text-muted);
    margin: 0;
    line-height: 1;
  }
  .sb-phone {
    display: block;
    font-size: 1.625rem;
    font-weight: 800;
    line-height: 1.1;
    color: var(--rs-brand-text);
    text-decoration: none;
    letter-spacing: -0.02em;
    transition: opacity 0.15s ease;
  }
  .sb-phone:hover { opacity: 0.75; }
  .sb-cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.625rem 1rem;
    border-radius: var(--radius-md, 8px);
    background: linear-gradient(135deg, var(--rs-brand) 0%, color-mix(in srgb, var(--rs-brand) 80%, #fff) 100%);
    color: var(--rs-on-brand);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    text-align: center;
    box-shadow: 0 4px 14px color-mix(in srgb, var(--rs-brand) 28%, transparent);
    transition: opacity 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .sb-cta-btn:hover {
    opacity: 0.92;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px color-mix(in srgb, var(--rs-brand) 40%, transparent);
  }
  .sb-cta-btn:active { transform: none; opacity: 1; }

  /* Trust + review inline list */
  .sb-trust-inline {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0.75rem 0 0;
    border-top: 1px solid var(--rs-border);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .sb-cta-card[data-has-image] .sb-trust-inline {
    border-top-color: rgba(255,255,255,0.2);
  }
  .sb-trust-inline-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--rs-text);
  }
  .sb-cta-card[data-has-image] .sb-trust-inline-item { color: rgba(255,255,255,0.9); }
  .sb-trust-icon {
    flex-shrink: 0;
    color: var(--rs-brand-text);
    display: flex;
    align-items: center;
  }
  .sb-cta-card[data-has-image] .sb-trust-icon { color: rgba(255,255,255,0.85); }

  /* Review item inside trust list */
  .sb-review-item { align-items: center; }
  .sb-review-divider {
    margin-top: 0.35rem;
    padding-top: 0.65rem;
    border-top: 1px solid var(--rs-border);
  }
  .sb-cta-card[data-has-image] .sb-review-divider {
    border-top-color: rgba(255,255,255,0.15);
  }
  .sb-review-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 1;
    gap: 0.375rem;
    text-decoration: none;
    color: inherit;
  }
  .sb-review-inner {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex: 1;
  }
  .sb-review-star { flex-shrink: 0; display: flex; }
  .sb-review-rating {
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--rs-text);
    transition: color 0.15s ease;
  }
  .sb-cta-card[data-has-image] .sb-review-rating { color: #fff; }
  a.sb-review-link:hover .sb-review-rating { color: var(--rs-brand-text); }
  .sb-review-meta {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--rs-text-muted);
  }
  .sb-cta-card[data-has-image] .sb-review-meta { color: rgba(255,255,255,0.65); }
  .sb-review-ext {
    flex-shrink: 0;
    color: var(--rs-text-muted);
    opacity: 0.55;
    transition: opacity 0.15s ease;
  }
  a.sb-review-link:hover .sb-review-ext { opacity: 1; }

  /* ── Shared link/info cards ──────────────────────────────────────── */
  .sb-links-card {
    padding: 1.25rem 1.5rem;
    background: var(--rs-surface);
    border: 1px solid var(--rs-border);
  }
  .sb-block-heading {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--rs-text-muted);
    margin: 0 0 0.875rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid color-mix(in srgb, var(--rs-brand) 18%, transparent);
  }

  /* TOC */
  .sb-toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: toc;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .sb-toc-list li { counter-increment: toc; }
  .sb-toc-link {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.375rem 0;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--rs-text);
    text-decoration: none;
    line-height: 1.4;
    transition: color 0.15s ease, padding-left 0.15s ease;
  }
  .sb-toc-link::before {
    content: counter(toc);
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--rs-brand) 12%, transparent);
    color: var(--rs-brand-text);
    font-size: 0.6875rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
  .sb-toc-link:hover {
    color: var(--rs-brand-text);
    padding-left: 0.25rem;
  }
  .sb-toc-list li + li {
    border-top: 1px solid color-mix(in srgb, var(--rs-border) 70%, transparent);
  }

  /* Meta card */
  .sb-meta-card {
    padding: 1rem 1.5rem;
    background: var(--rs-surface);
    border: 1px solid var(--rs-border);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .sb-meta-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .sb-meta-icon { flex-shrink: 0; color: var(--rs-text-muted); }
  .sb-meta-label { font-size: 0.8125rem; color: var(--rs-text-muted); }
  .sb-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.25rem;
    padding-top: 0.5rem;
    border-top: 1px solid color-mix(in srgb, var(--rs-border) 70%, transparent);
  }
  .sb-tag {
    padding: 0.25rem 0.625rem;
    border-radius: 99px;
    font-size: 0.75rem;
    font-weight: 600;
    background: color-mix(in srgb, var(--rs-brand) 10%, transparent);
    color: var(--rs-brand-text);
    line-height: 1.4;
  }

  /* Related posts */
  .sb-link-list { list-style: none; margin: 0; padding: 0; }
  .sb-link-list li + li {
    border-top: 1px solid color-mix(in srgb, var(--rs-border) 70%, transparent);
  }
  .sb-related-item {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.5625rem 0;
  }
  .sb-related-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--rs-text);
    text-decoration: none;
    line-height: 1.4;
    transition: color 0.15s ease;
  }
  .sb-related-link:hover { color: var(--rs-brand-text); text-decoration: underline; }
  .sb-related-date { font-size: 0.75rem; color: var(--rs-text-muted); }

  @media (prefers-reduced-motion: reduce) {
    .sb-phone, .sb-cta-btn, .sb-toc-link,
    .sb-review-rating, .sb-review-ext { transition: none; }
    .sb-toc-link:hover { padding-left: 0; }
    .sb-cta-btn:hover  { transform: none; }
  }
</style>
