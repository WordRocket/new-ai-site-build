---
import RoiCalculator from '@ranksite/blocks/blocks/RoiCalculator';
import type { BlockInstance } from '../lib/block-renderer';

interface Props {
  block: BlockInstance;
}

const { block } = Astro.props;

if (block.blockKey !== 'interactive.roiCalculator') {
  throw new Error(`[InteractiveBlockRenderer] blockKey "${block.blockKey}" is not a known interactive component`);
}
---

<RoiCalculator {...block.props} id={block.id} client:visible />
