---
import { RoiCalculator, FaqAccordion } from '@ranksite/blocks';
import type { BlockInstance } from '../lib/block-renderer';

interface Props {
  block: BlockInstance;
}

const { block } = Astro.props;
---

{block.blockKey === 'interactive.roiCalculator' && (
  <RoiCalculator {...block.props} id={block.id} client:visible />
)}
{block.blockKey === 'faq.accordion' && (
  <FaqAccordion {...block.props} id={block.id} client:visible />
)}
