---
/**
 * ChatbotWidget.astro
 *
 * A lightweight, self-contained site chatbot that ships in two modes:
 *
 *  Model A — Retrieval-only (default, zero cost)
 *    Reads chatbotAnswerPack from site-config.json (built and shipped
 *    from Railway). Uses fuse.js to fuzzy-match visitor questions
 *    against curated answer-pack entries (keywords: 0.55, question:
 *    0.35, answer: 0.10, threshold 0.45). Returns the top match's
 *    answer. If no match, tries fallbacks (page excerpts). If still
 *    nothing, returns noAnswer (contact details).
 *
 *  Model B — AI synthesis (opt-in, chatbotEnableAi: true)
 *    Same retrieval layer runs first, then the top matches + the
 *    user's question are sent to the RankSite AI proxy endpoint for
 *    a grounded, conversational answer. The customer's API key is
 *    held server-side by the proxy — it never ships to the browser.
 *
 * Starter chips: clickable prompt buttons shown below the input,
 * sourced from answerPack.starters.
 */

import Fuse from 'fuse.js';
import siteConfig from '../data/site-config.json';

const enabled = (siteConfig as any).chatbotEnabled === true;
const introMessage: string =
  (siteConfig as any).chatbotIntroMessage?.trim() ||
  'Hi! Ask me about our services.';
const enableAi = (siteConfig as any).chatbotEnableAi === true;
const siteId: string = (siteConfig as any).chatbotSiteId?.trim() || '';
const proxyUrl: string = (siteConfig as any).chatbotProxyUrl?.trim() || '';

// Answer pack — built and shipped from Railway publish payload
type AnswerEntry = {
  id?: string;
  keywords?: string[];
  question?: string;
  answer: string;
  url?: string;
};
type FallbackEntry = { title?: string; text: string; url?: string };
type AnswerPack = {
  entries?: AnswerEntry[];
  fallbacks?: FallbackEntry[];
  starters?: string[];
  noAnswer?: string;
};

const answerPack: AnswerPack = (siteConfig as any).chatbotAnswerPack || {};
const entries: AnswerEntry[] = Array.isArray(answerPack.entries) ? answerPack.entries : [];
const fallbacks: FallbackEntry[] = Array.isArray(answerPack.fallbacks) ? answerPack.fallbacks : [];
const starters: string[] = Array.isArray(answerPack.starters) ? answerPack.starters : [];
const noAnswerText: string = (answerPack.noAnswer || '').trim();

// Build fuse index at build time — entries are static content
const fuseIndex = entries.map((e, i) => ({
  id: e.id || `entry-${i}`,
  keywords: Array.isArray(e.keywords) ? e.keywords.join(' ') : (e.keywords || ''),
  question: e.question || '',
  answer: e.answer || '',
  url: e.url || '',
  _answer: e.answer,
}));

const fuseOptions = {
  keys: [
    { name: 'keywords', weight: 0.55 },
    { name: 'question', weight: 0.35 },
    { name: 'answer', weight: 0.10 },
  ],
  threshold: 0.45,
  includeScore: true,
  ignoreLocation: true,
  minMatchCharLength: 2,
};

// Serialize fuse index + options for client-side initialization
const fuseData = JSON.stringify(fuseIndex);
const fuseOptsJson = JSON.stringify(fuseOptions);
const fallbacksJson = JSON.stringify(fallbacks);
const startersJson = JSON.stringify(starters);
const noAnswerJson = JSON.stringify(noAnswerText);
---

{enabled && (
  <>
    {/* ── Floating launcher button ──────────────────────────────────── */}
    <button
      id="cb-launcher"
      class="cb-launcher"
      aria-label="Open chat assistant"
      aria-expanded="false"
      aria-controls="cb-panel"
      type="button"
    >
      <svg class="cb-launcher__icon cb-launcher__icon--open" xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3C6.5 3 2 6.5 2 11c0 2 .8 3.8 2.2 5.2L3 21l5-1.2c1.2.4 2.6.6 4 .6 5.5 0 10-3.5 10-8s-4.5-8-10-8z"/>
        <path d="M8 11h.01M12 11h.01M16 11h.01"/>
      </svg>
      <svg class="cb-launcher__icon cb-launcher__icon--close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12"/>
      </svg>
    </button>

    {/* ── Chat panel ─────────────────────────────────────────────────── */}
    <div
      id="cb-panel"
      class="cb-panel"
      role="dialog"
      aria-modal="false"
      aria-label="Chat assistant"
      data-hidden="true"
    >
      {/* Header */}
      <div class="cb-header">
        <div class="cb-header__info">
          <div class="cb-header__avatar" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3C6.5 3 2 6.5 2 11c0 2 .8 3.8 2.2 5.2L3 21l5-1.2c1.2.4 2.6.6 4 .6 5.5 0 10-3.5 10-8s-4.5-8-10-8z"/>
              <path d="M8 11h.01M12 11h.01M16 11h.01"/>
            </svg>
          </div>
          <div>
            <p class="cb-header__title">Ask {siteConfig.name || 'Us'}</p>
            <p class="cb-header__status" id="cb-status">
              <span class="cb-header__dot" aria-hidden="true"></span>
              <span>{enableAi ? 'AI-powered' : 'Search-based'}</span>
            </p>
          </div>
        </div>
        <button id="cb-close" class="cb-header__close" type="button" aria-label="Close chat">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>

      {/* Messages */}
      <div id="cb-messages" class="cb-messages" aria-live="polite" aria-atomic="false">
        <div class="cb-msg cb-msg--bot">
          <div class="cb-msg__bubble">{introMessage}</div>
        </div>
      </div>

      {/* Starter chips */}
      {starters.length > 0 && (
        <div id="cb-starters" class="cb-starters" aria-label="Suggested questions">
          {starters.map((s) => (
            <button type="button" class="cb-chip" data-query={s}>{s}</button>
          ))}
        </div>
      )}

      {/* Input */}
      <form id="cb-form" class="cb-input-row" autocomplete="off">
        <input
          id="cb-input"
          class="cb-input"
          type="text"
          placeholder="Type your question…"
          aria-label="Type your question"
          maxlength="500"
        />
        <button id="cb-send" class="cb-send" type="submit" aria-label="Send message">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14.536 21.086a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/>
            <path d="m21.3 4.3-7.9 7.9"/>
          </svg>
        </button>
      </form>

      {/* Footer */}
      <div class="cb-footer">
        <a href="https://ranksite.com" target="_blank" rel="noopener noreferrer" class="cb-footer__link">Powered by RankSite</a>
      </div>
    </div>

    {/* ── Client logic ──────────────────────────────────────────────── */}
    <script type="module" define:vars={{
      enableAi,
      introMessage,
      siteId,
      proxyUrl,
      fuseData,
      fuseOptsJson,
      fallbacksJson,
      startersJson,
      noAnswerJson,
    }}>
      (() => {
        'use strict';

        // ── Config from build-time site-config.json ───────────────────
        const aiActive = enableAi;
        const EMBED_URL = '/chatbot-embeddings.json';
        const TOP_K = 3;

        // ── Answer pack data (serialized from build) ──────────────────
        const fuseIndexData = JSON.parse(fuseData);
        const fuseOptions = JSON.parse(fuseOptsJson);
        const fallbacks = JSON.parse(fallbacksJson);
        const starters = JSON.parse(startersJson);
        const noAnswerText = JSON.parse(noAnswerJson);

        // ── Fuse.js initialization ────────────────────────────────────
        // fuse.js is imported as an ES module via the Astro script bundler.
        // We use the dynamic import to get the bundled Fuse class.
        let fuse = null;

        async function initFuse() {
          if (fuse) return fuse;
          const FuseModule = await import('fuse.js');
          const FuseClass = FuseModule.default || FuseModule;
          fuse = new FuseClass(fuseIndexData, fuseOptions);
          return fuse;
        }

        // ── Embeddings (page excerpts for fallback search) ────────────
        let embeddings = null;
        let embeddingsLoaded = false;

        async function loadEmbeddings() {
          try {
            const res = await fetch(EMBED_URL, { cache: 'force-cache' });
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            const data = await res.json();
            embeddings = Array.isArray(data) ? data : (data.chunks || data.embeddings || []);
            embeddingsLoaded = true;
          } catch (err) {
            embeddings = [];
            embeddingsLoaded = true;
          }
        }

        // ── State ──────────────────────────────────────────────────────
        let isTyping = false;
        const chatHistory = [];

        // ── DOM refs ───────────────────────────────────────────────────
        const launcher = document.getElementById('cb-launcher');
        const panel = document.getElementById('cb-panel');
        const closeBtn = document.getElementById('cb-close');
        const form = document.getElementById('cb-form');
        const input = document.getElementById('cb-input');
        const messages = document.getElementById('cb-messages');
        const sendBtn = document.getElementById('cb-send');
        const startersContainer = document.getElementById('cb-starters');

        if (!launcher || !panel || !form || !input || !messages) return;

        // ── Panel toggle ───────────────────────────────────────────────
        function openPanel() {
          panel.setAttribute('data-hidden', 'false');
          panel.classList.add('cb-panel--open');
          launcher.setAttribute('aria-expanded', 'true');
          launcher.classList.add('cb-launcher--active');
          if (!embeddingsLoaded) loadEmbeddings();
          setTimeout(() => { try { input.focus(); } catch(e){} }, 320);
        }

        function closePanel() {
          panel.setAttribute('data-hidden', 'true');
          panel.classList.remove('cb-panel--open');
          launcher.setAttribute('aria-expanded', 'false');
          launcher.classList.remove('cb-launcher--active');
        }

        launcher.addEventListener('click', () => {
          if (panel.classList.contains('cb-panel--open')) closePanel();
          else openPanel();
        });
        closeBtn.addEventListener('click', closePanel);

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && panel.classList.contains('cb-panel--open')) {
            closePanel();
          }
        });

        // ── Starter chips ──────────────────────────────────────────────
        if (startersContainer) {
          startersContainer.addEventListener('click', (e) => {
            const chip = e.target.closest('.cb-chip');
            if (!chip) return;
            const query = chip.getAttribute('data-query');
            if (!query) return;
            input.value = query;
            form.requestSubmit();
          });
        }

        // ── Text utilities ─────────────────────────────────────────────
        function escapeHtml(s) {
          const div = document.createElement('div');
          div.textContent = s;
          return div.innerHTML;
        }

        function tokenize(text) {
          return (text || '').toLowerCase().replace(/[^\w\s]/g, ' ').replace(/\s+/g, ' ').trim().split(' ').filter(t => t.length > 1);
        }

        // Simple word-overlap score for fallback embeddings search
        function keywordScore(queryTokens, chunkText) {
          const chunkTokens = new Set(tokenize(chunkText));
          if (chunkTokens.size === 0) return 0;
          let hits = 0;
          for (const t of queryTokens) { if (chunkTokens.has(t)) hits++; }
          return hits / queryTokens.length;
        }

        // ── Answer pack search (fuse.js) ───────────────────────────────
        async function searchAnswerPack(query) {
          const f = await initFuse();
          const results = f.search(query, { limit: TOP_K });
          if (results.length === 0) return null;

          const best = results[0];
          // fuse.js score: 0 = perfect match, 1 = no match.
          // threshold 0.45 already filters, but double-check.
          if (best.score > 0.45) return null;

          const item = best.item;
          const answer = item._answer || item.answer || '';
          if (!answer) return null;

          const sourceLink = item.url ? ` <a href="${item.url}" class="cb-source-link">Read more</a>` : '';
          return { text: answer + sourceLink, matches: [{ title: item.question || '', text: answer, url: item.url }] };
        }

        // ── Fallback search (page excerpts) ────────────────────────────
        function searchFallbacks(query) {
          // First try the answer pack fallbacks array
          if (fallbacks.length > 0) {
            const qTokens = tokenize(query);
            let best = null;
            let bestScore = 0;
            for (const fb of fallbacks) {
              const combinedText = (fb.title || '') + ' ' + (fb.text || '');
              const score = keywordScore(qTokens, combinedText);
              if (score > bestScore) { bestScore = score; best = fb; }
            }
            if (best && bestScore > 0.15) {
              const sourceLink = best.url ? ` <a href="${best.url}" class="cb-source-link">Read more</a>` : '';
              return { text: (best.title ? `<strong>${escapeHtml(best.title)}</strong><br>` : '') + escapeHtml(best.text) + sourceLink, matches: [{ title: best.title || '', text: best.text, url: best.url }] };
            }
          }

          // Then try the embeddings file (page excerpts generated at build)
          if (embeddings && embeddings.length > 0) {
            const qTokens = tokenize(query);
            if (qTokens.length === 0) return null;

            const scored = embeddings.map(chunk => {
              const combinedText = (chunk.title ? chunk.title + ' ' : '') + (chunk.text || '');
              return { chunk, score: keywordScore(qTokens, combinedText) };
            });

            const top = scored
              .filter(s => s.score > 0.15)
              .sort((a, b) => b.score - a.score)
              .slice(0, TOP_K);

            if (top.length > 0) {
              const parts = top.map(s => {
                const m = s.chunk;
                const sourceLink = m.url ? ` <a href="${m.url}" class="cb-source-link">Read more</a>` : '';
                return `<p><strong>${escapeHtml(m.title || m.section || '')}</strong>${sourceLink}<br>${escapeHtml(m.text)}</p>`;
              });
              return { text: parts.join(''), matches: top.map(s => s.chunk) };
            }
          }

          return null;
        }

        // ── No-answer fallback (contact details) ───────────────────────
        function buildNoAnswer() {
          if (noAnswerText) {
            return noAnswerText;
          }
          return "I don't have that information right now. Try rephrasing your question, or contact us directly for help.";
        }

        // ── AI synthesis (Model B) ─────────────────────────────────────
        async function synthesizeAnswer(query, matches) {
          if (!proxyUrl || !siteId) {
            throw new Error('AI proxy not configured');
          }
          const context = matches.map((m, i) =>
            `[${i+1}] ${m.title || ''}\n${m.text}`
          ).join('\n\n');

          const res = await fetch(proxyUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ siteId, question: query, context })
          });

          if (!res.ok) throw new Error(`AI proxy request failed: ${res.status}`);
          const data = await res.json();
          const answer = data?.answer?.trim();
          if (!answer) throw new Error('Empty AI response');
          return answer;
        }

        // ── Message rendering ──────────────────────────────────────────
        function addMessage(role, html) {
          const wrapper = document.createElement('div');
          wrapper.className = `cb-msg cb-msg--${role === 'user' ? 'user' : 'bot'}`;
          const bubble = document.createElement('div');
          bubble.className = 'cb-msg__bubble';
          bubble.innerHTML = html;
          wrapper.appendChild(bubble);
          messages.appendChild(wrapper);
          messages.scrollTop = messages.scrollHeight;
          chatHistory.push({ role, content: html });
        }

        function addTypingIndicator() {
          const wrapper = document.createElement('div');
          wrapper.className = 'cb-msg cb-msg--bot cb-msg--typing';
          wrapper.id = 'cb-typing';
          const bubble = document.createElement('div');
          bubble.className = 'cb-msg__bubble cb-typing-bubble';
          bubble.innerHTML = '<span class="cb-typing-dot"></span><span class="cb-typing-dot"></span><span class="cb-typing-dot"></span>';
          wrapper.appendChild(bubble);
          messages.appendChild(wrapper);
          messages.scrollTop = messages.scrollHeight;
        }

        function removeTypingIndicator() {
          const el = document.getElementById('cb-typing');
          if (el) el.remove();
        }

        // ── Form submit ────────────────────────────────────────────────
        async function handleSubmit(query) {
          if (!query || isTyping) return;

          addMessage('user', escapeHtml(query));
          input.value = '';
          input.disabled = true;
          sendBtn.disabled = true;
          isTyping = true;
          addTypingIndicator();

          try {
            if (!embeddingsLoaded) await loadEmbeddings();

            let answerHtml = null;
            let matches = [];

            // Step 1: Search answer pack entries with fuse.js
            const packResult = await searchAnswerPack(query);
            if (packResult) {
              answerHtml = packResult.text;
              matches = packResult.matches;
            }

            // Step 2: If no match, try fallbacks (page excerpts)
            if (!answerHtml) {
              const fbResult = searchFallbacks(query);
              if (fbResult) {
                answerHtml = fbResult.text;
                matches = fbResult.matches;
              }
            }

            // Step 3: If still nothing, return noAnswer (contact details)
            if (!answerHtml) {
              answerHtml = buildNoAnswer();
            }

            // Model B: AI synthesis on top of retrieval
            if (aiActive && proxyUrl && siteId && matches.length > 0) {
              try {
                const aiAnswer = await synthesizeAnswer(query, matches);
                let aiHtml = escapeHtml(aiAnswer);
                const links = matches
                  .filter(m => m.url)
                  .slice(0, 3)
                  .map(m => `<a href="${m.url}" class="cb-source-link">Read more</a>`)
                  .join(' ');
                if (links) aiHtml += ` <span class="cb-sources">${links}</span>`;
                answerHtml = aiHtml;
              } catch (aiErr) {
                // Fall back to retrieval-only answer on AI error
              }
            }

            removeTypingIndicator();
            addMessage('assistant', answerHtml);
          } catch (err) {
            removeTypingIndicator();
            addMessage('assistant', "Sorry, something went wrong. Please try again or contact us directly.");
          } finally {
            isTyping = false;
            input.disabled = false;
            sendBtn.disabled = false;
            try { input.focus(); } catch(e){}
          }
        }

        form.addEventListener('submit', (e) => {
          e.preventDefault();
          handleSubmit(input.value.trim());
        });

        // Expose for debugging if needed
        window.__cb = { open: openPanel, close: closePanel };
      })();
    </script>

    <style>
      /* ── Launcher ───────────────────────────────────────────────────── */
      .cb-launcher {
        position: fixed;
        bottom: 1.25rem;
        right: 1.25rem;
        z-index: 9998;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, var(--rs-brand, #2563eb) 0%, color-mix(in srgb, var(--rs-brand, #2563eb) 75%, #000) 100%);
        color: #fff;
        box-shadow: 0 6px 24px color-mix(in srgb, var(--rs-brand, #2563eb) 40%, transparent);
        transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
        -webkit-tap-highlight-color: transparent;
      }
      .cb-launcher:hover {
        transform: scale(1.08);
        box-shadow: 0 8px 32px color-mix(in srgb, var(--rs-brand, #2563eb) 55%, transparent);
      }
      .cb-launcher:active { transform: scale(0.96); }
      .cb-launcher__icon { position: absolute; transition: opacity 0.15s ease, transform 0.2s ease; }
      .cb-launcher__icon--close { opacity: 0; transform: rotate(-90deg) scale(0.8); }
      .cb-launcher--active .cb-launcher__icon--open { opacity: 0; transform: rotate(90deg) scale(0.8); }
      .cb-launcher--active .cb-launcher__icon--close { opacity: 1; transform: rotate(0) scale(1); }

      /* ── Panel ──────────────────────────────────────────────────────── */
      .cb-panel {
        position: fixed;
        bottom: 5.5rem;
        right: 1.25rem;
        z-index: 9999;
        width: 380px;
        max-width: calc(100vw - 2.5rem);
        max-height: min(600px, calc(100vh - 8rem));
        display: flex;
        flex-direction: column;
        border-radius: 16px;
        overflow: hidden;
        background: var(--rs-surface, #fff);
        border: 1px solid var(--rs-border, #e5e7eb);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18), 0 4px 12px rgba(0, 0, 0, 0.08);
        opacity: 0;
        transform: translateY(16px) scale(0.96);
        pointer-events: none;
        transition: opacity 0.25s ease, transform 0.25s ease;
      }
      .cb-panel--open {
        opacity: 1;
        transform: translateY(0) scale(1);
        pointer-events: auto;
      }
      [data-skin="dark"] .cb-panel {
        background: var(--rs-surface, #1e1e2e);
        border-color: var(--rs-border, #2e2e3e);
        box-shadow: 0 20px 60px rgba(0,0,0,0.5), 0 4px 12px rgba(0,0,0,0.3);
      }

      /* ── Header ─────────────────────────────────────────────────────── */
      .cb-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.875rem 1rem;
        background: linear-gradient(135deg, var(--rs-brand, #2563eb) 0%, color-mix(in srgb, var(--rs-brand, #2563eb) 72%, #000) 100%);
        color: #fff;
        flex-shrink: 0;
      }
      .cb-header__info { display: flex; align-items: center; gap: 0.625rem; }
      .cb-header__avatar {
        width: 36px; height: 36px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: rgba(255, 255, 255, 0.18);
        flex-shrink: 0;
      }
      .cb-header__title { font-size: 0.9375rem; font-weight: 700; margin: 0; line-height: 1.2; }
      .cb-header__status { display: flex; align-items: center; gap: 0.375rem; font-size: 0.6875rem; margin: 0; opacity: 0.8; line-height: 1.2; }
      .cb-header__dot { width: 7px; height: 7px; border-radius: 50%; background: #4ade80; flex-shrink: 0; }
      .cb-header__close {
        background: none; border: none; color: rgba(255,255,255,0.8);
        cursor: pointer; padding: 4px; border-radius: 6px;
        display: flex; align-items: center; justify-content: center;
        transition: color 0.15s ease, background 0.15s ease;
      }
      .cb-header__close:hover { color: #fff; background: rgba(255,255,255,0.15); }

      /* ── Messages ───────────────────────────────────────────────────── */
      .cb-messages {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
      }
      .cb-messages::-webkit-scrollbar { width: 5px; }
      .cb-messages::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--rs-border, #ccc) 80%, transparent); border-radius: 3px; }
      .cb-messages::-webkit-scrollbar-track { background: transparent; }

      .cb-msg { display: flex; max-width: 88%; animation: cb-msg-in 0.3s ease; }
      .cb-msg--user { margin-left: auto; justify-content: flex-end; }
      .cb-msg--bot { margin-right: auto; justify-content: flex-start; }
      @keyframes cb-msg-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

      .cb-msg__bubble {
        padding: 0.625rem 0.875rem;
        border-radius: 14px;
        font-size: 0.875rem;
