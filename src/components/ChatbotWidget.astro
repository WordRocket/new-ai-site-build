---
/**
 * ChatbotWidget.astro
 *
 * A lightweight, self-contained site chatbot that ships in two modes:
 *
 *  Model A — Retrieval-only (default, zero cost)
 *    Loads /chatbot-embeddings.json (pre-generated at publish time),
 *    performs semantic + keyword search, and returns matching content
 *    chunks as-is. Works for ~80% of typical visitor questions
 *    (hours, services, locations, pricing from FAQs, contact info).
 *
 *  Model B — AI synthesis (opt-in, user supplies their own API key)
 *    Same retrieval layer runs first, then the top matches + the user's
 *    question are sent to the RankSite AI proxy endpoint for a grounded,
 *    conversational answer. The customer's API key is held server-side
 *    by the proxy — it never ships to the browser. No key configured →
 *    silently falls back to Model A.
 *
 * The widget is entirely client-side: embeddings are fetched once on
 * open, search is in-browser, and chat history lives in memory only.
 * It renders only when siteConfig.chatbotEnabled === true.
 *
 * "Powered by RankSite" footer link is always visible in the panel.
 */

import siteConfig from '../data/site-config.json';

const enabled = (siteConfig as any).chatbotEnabled === true;
const introMessage: string =
  (siteConfig as any).chatbotIntroMessage?.trim() ||
  'Hi! Ask me about our services.';
const enableAi = (siteConfig as any).chatbotEnableAi === true;
const aiActive = enableAi;
---

{enabled && (
  <>
    {/* ── Floating launcher button ──────────────────────────────────── */}
    <button
      id="cb-launcher"
      class="cb-launcher"
      aria-label="Open chat assistant"
      aria-expanded="false"
      aria-controls="cb-panel"
      type="button"
    >
      <svg class="cb-launcher__icon cb-launcher__icon--open" xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3C6.5 3 2 6.5 2 11c0 2 .8 3.8 2.2 5.2L3 21l5-1.2c1.2.4 2.6.6 4 .6 5.5 0 10-3.5 10-8s-4.5-8-10-8z"/>
        <path d="M8 11h.01M12 11h.01M16 11h.01"/>
      </svg>
      <svg class="cb-launcher__icon cb-launcher__icon--close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12"/>
      </svg>
    </button>

    {/* ── Chat panel ─────────────────────────────────────────────────── */}
    <div
      id="cb-panel"
      class="cb-panel"
      role="dialog"
      aria-modal="false"
      aria-label="Chat assistant"
      data-hidden="true"
    >
      {/* Header */}
      <div class="cb-header">
        <div class="cb-header__info">
          <div class="cb-header__avatar" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3C6.5 3 2 6.5 2 11c0 2 .8 3.8 2.2 5.2L3 21l5-1.2c1.2.4 2.6.6 4 .6 5.5 0 10-3.5 10-8s-4.5-8-10-8z"/>
              <path d="M8 11h.01M12 11h.01M16 11h.01"/>
            </svg>
          </div>
          <div>
            <p class="cb-header__title">Ask {siteConfig.name || 'Us'}</p>
            <p class="cb-header__status" id="cb-status">
              <span class="cb-header__dot" aria-hidden="true"></span>
              <span>{aiActive ? 'AI-powered' : 'Search-based'}</span>
            </p>
          </div>
        </div>
        <button id="cb-close" class="cb-header__close" type="button" aria-label="Close chat">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>

      {/* Messages */}
      <div id="cb-messages" class="cb-messages" aria-live="polite" aria-atomic="false">
        <div class="cb-msg cb-msg--bot">
          <div class="cb-msg__bubble">{introMessage}</div>
        </div>
      </div>

      {/* Input */}
      <form id="cb-form" class="cb-input-row" autocomplete="off">
        <input
          id="cb-input"
          class="cb-input"
          type="text"
          placeholder="Type your question…"
          aria-label="Type your question"
          maxlength="500"
        />
        <button id="cb-send" class="cb-send" type="submit" aria-label="Send message">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14.536 21.086a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/>
            <path d="m21.3 4.3-7.9 7.9"/>
          </svg>
        </button>
      </form>

      {/* Footer */}
      <div class="cb-footer">
        <a href="https://ranksite.com" target="_blank" rel="noopener noreferrer" class="cb-footer__link">Powered by RankSite</a>
      </div>
    </div>

    {/* ── Client logic ──────────────────────────────────────────────── */}
    <script type="module" define:vars={{ aiActive, introMessage }}>
      (() => {
        'use strict';

        // ── State ──────────────────────────────────────────────────────
        let embeddings = null;       // Array<{id,text,title,section,url,embedding?:number[]}>
        let embeddingsLoaded = false;
        let isTyping = false;
        const chatHistory = [];       // {role:'user'|'assistant', content:string}
        const EMBED_URL = '/chatbot-embeddings.json';
        const TOP_K = 3;
        const SIM_THRESHOLD = 0.15;

        // ── DOM refs ───────────────────────────────────────────────────
        const launcher = document.getElementById('cb-launcher');
        const panel = document.getElementById('cb-panel');
        const closeBtn = document.getElementById('cb-close');
        const form = document.getElementById('cb-form');
        const input = document.getElementById('cb-input') ;
        const messages = document.getElementById('cb-messages');
        const sendBtn = document.getElementById('cb-send');

        if (!launcher || !panel || !form || !input || !messages) return;

        // ── Panel toggle ───────────────────────────────────────────────
        function openPanel() {
          panel.setAttribute('data-hidden', 'false');
          panel.classList.add('cb-panel--open');
          launcher.setAttribute('aria-expanded', 'true');
          launcher.classList.add('cb-launcher--active');
          // Lazy-load embeddings on first open
          if (!embeddingsLoaded) loadEmbeddings();
          // Focus input after CSS transition
          setTimeout(() => { try { input.focus(); } catch(e){} }, 320);
        }

        function closePanel() {
          panel.setAttribute('data-hidden', 'true');
          panel.classList.remove('cb-panel--open');
          launcher.setAttribute('aria-expanded', 'false');
          launcher.classList.remove('cb-launcher--active');
        }

        launcher.addEventListener('click', () => {
          if (panel.classList.contains('cb-panel--open')) closePanel();
          else openPanel();
        });
        closeBtn.addEventListener('click', closePanel);

        // Close on Escape
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && panel.classList.contains('cb-panel--open')) {
            closePanel();
          }
        });

        // ── Load embeddings ────────────────────────────────────────────
        async function loadEmbeddings() {
          try {
            const res = await fetch(EMBED_URL, { cache: 'force-cache' });
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            const data = await res.json();
            embeddings = Array.isArray(data) ? data : (data.chunks || data.embeddings || []);
            embeddingsLoaded = true;
          } catch (err) {
            embeddings = [];
            embeddingsLoaded = true;
          }
        }

        // ── Text utilities ─────────────────────────────────────────────
        function normalize(text) {
          return (text || '').toLowerCase().replace(/[^\w\s]/g, ' ').replace(/\s+/g, ' ').trim();
        }

        function tokenize(text) {
          return normalize(text).split(' ').filter(t => t.length > 1);
        }

        // Simple word-overlap score (works without pre-computed vectors)
        function keywordScore(queryTokens, chunkText) {
          const chunkTokens = new Set(tokenize(chunkText));
          if (chunkTokens.size === 0) return 0;
          let hits = 0;
          for (const t of queryTokens) { if (chunkTokens.has(t)) hits++; }
          // Coverage-weighted: how many query tokens matched
          return hits / queryTokens.length;
        }

        // Cosine similarity for pre-computed embeddings (if present)
        function cosine(a, b) {
          if (!a || !b || a.length !== b.length) return 0;
          let dot = 0, magA = 0, magB = 0;
          for (let i = 0; i < a.length; i++) {
            dot += a[i] * b[i];
            magA += a[i] * a[i];
            magB += b[i] * b[i];
          }
          const denom = Math.sqrt(magA) * Math.sqrt(magB);
          return denom === 0 ? 0 : dot / denom;
        }

        // ── Retrieval ─────────────────────────────────────────────────
        function search(query) {
          if (!embeddings || embeddings.length === 0) return [];
          const qTokens = tokenize(query);
          if (qTokens.length === 0) return [];

          const hasVectors = embeddings.some(c => c.embedding && c.embedding.length > 0);
          const scored = embeddings.map(chunk => {
            const combinedText = (chunk.title ? chunk.title + ' ' : '') + (chunk.text || '');
            let score;
            if (hasVectors && chunk.embedding) {
              // Semantic search via cosine similarity (vector mode)
              score = cosine(qTokens, chunk.embedding);
            } else {
              // Keyword fallback (Model A without vectors)
              score = keywordScore(qTokens, combinedText);
            }
            return { chunk, score };
          });

          return scored
            .filter(s => s.score > SIM_THRESHOLD)
            .sort((a, b) => b.score - a.score)
            .slice(0, TOP_K)
            .map(s => s.chunk);
        }

        // ── Response building (Model A) ────────────────────────────────
        function buildRetrievalAnswer(matches) {
          if (matches.length === 0) {
            return "I don't have that information right now. Try rephrasing your question, or contact us directly for help.";
          }
          if (matches.length === 1) {
            const m = matches[0];
            const sourceLink = m.url ? ` <a href="${m.url}" class="cb-source-link">Read more</a>` : '';
            return `${m.text}${sourceLink}`;
          }
          const parts = matches.map((m, i) => {
            const sourceLink = m.url ? ` <a href="${m.url}" class="cb-source-link">Read more</a>` : '';
            return `<p><strong>${m.title || m.section || ('Result ' + (i+1))}</strong>${sourceLink}<br>${m.text}</p>`;
          });
          return parts.join('');
        }

        // ── AI synthesis (Model B) ─────────────────────────────────────
        // AI calls route through the RankSite proxy endpoint so the
        // customer's API key never reaches the browser. The proxy holds
        // the key server-side; the browser only sends the question +
        // retrieved context chunks.
        const AI_PROXY_URL = 'https://api.ranksite.com/v1/chatbot/synthesize';

        async function synthesizeAnswer(query, matches) {
          const context = matches.map((m, i) =>
            `[${i+1}] ${m.title || m.section || ''}\n${m.text}`
          ).join('\n\n');

          const res = await fetch(AI_PROXY_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              question: query,
              context
            })
          });

          if (!res.ok) throw new Error(`AI proxy request failed: ${res.status}`);
          const data = await res.json();
          const answer = data?.answer?.trim();
          if (!answer) throw new Error('Empty AI response');
          return answer;
        }

        // ── Message rendering ──────────────────────────────────────────
        function addMessage(role, html) {
          const wrapper = document.createElement('div');
          wrapper.className = `cb-msg cb-msg--${role === 'user' ? 'user' : 'bot'}`;
          const bubble = document.createElement('div');
          bubble.className = 'cb-msg__bubble';
          bubble.innerHTML = html;
          wrapper.appendChild(bubble);
          messages.appendChild(wrapper);
          messages.scrollTop = messages.scrollHeight;
          chatHistory.push({ role, content: html });
        }

        function addTypingIndicator() {
          const wrapper = document.createElement('div');
          wrapper.className = 'cb-msg cb-msg--bot cb-msg--typing';
          wrapper.id = 'cb-typing';
          const bubble = document.createElement('div');
          bubble.className = 'cb-msg__bubble cb-typing-bubble';
          bubble.innerHTML = '<span class="cb-typing-dot"></span><span class="cb-typing-dot"></span><span class="cb-typing-dot"></span>';
          wrapper.appendChild(bubble);
          messages.appendChild(wrapper);
          messages.scrollTop = messages.scrollHeight;
        }

        function removeTypingIndicator() {
          const el = document.getElementById('cb-typing');
          if (el) el.remove();
        }

        function escapeHtml(s) {
          const div = document.createElement('div');
          div.textContent = s;
          return div.innerHTML;
        }

        // ── Form submit ────────────────────────────────────────────────
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const query = input.value.trim();
          if (!query || isTyping) return;

          addMessage('user', escapeHtml(query));
          input.value = '';
          input.disabled = true;
          sendBtn.disabled = true;
          isTyping = true;
          addTypingIndicator();

          try {
            // Ensure embeddings are loaded
            if (!embeddingsLoaded) await loadEmbeddings();

            const matches = search(query);

            let answerHtml;
            if (aiActive) {
              try {
                const aiAnswer = await synthesizeAnswer(query, matches);
                answerHtml = escapeHtml(aiAnswer);
                // Append source links
                if (matches.length > 0) {
                  const links = matches
                    .filter(m => m.url)
                    .slice(0, 3)
                    .map(m => `<a href="${m.url}" class="cb-source-link">Read more</a>`)
                    .join(' ');
                  if (links) answerHtml += ` <span class="cb-sources">${links}</span>`;
                }
              } catch (aiErr) {
                // Fall back to retrieval-only on AI error
                answerHtml = buildRetrievalAnswer(matches);
              }
            } else {
              answerHtml = buildRetrievalAnswer(matches);
            }

            removeTypingIndicator();
            addMessage('assistant', answerHtml);
          } catch (err) {
            removeTypingIndicator();
            addMessage('assistant', "Sorry, something went wrong. Please try again or contact us directly.");
          } finally {
            isTyping = false;
            input.disabled = false;
            sendBtn.disabled = false;
            try { input.focus(); } catch(e){}
          }
        });

        // Expose for debugging if needed
        window.__cb = { open: openPanel, close: closePanel };
      })();
    </script>

    <style>
      /* ── Launcher ───────────────────────────────────────────────────── */
      .cb-launcher {
        position: fixed;
        bottom: 1.25rem;
        right: 1.25rem;
        z-index: 9998;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, var(--rs-brand, #2563eb) 0%, color-mix(in srgb, var(--rs-brand, #2563eb) 75%, #000) 100%);
        color: #fff;
        box-shadow: 0 6px 24px color-mix(in srgb, var(--rs-brand, #2563eb) 40%, transparent);
        transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
        -webkit-tap-highlight-color: transparent;
      }
      .cb-launcher:hover {
        transform: scale(1.08);
        box-shadow: 0 8px 32px color-mix(in srgb, var(--rs-brand, #2563eb) 55%, transparent);
      }
      .cb-launcher:active { transform: scale(0.96); }
      .cb-launcher__icon { position: absolute; transition: opacity 0.15s ease, transform 0.2s ease; }
      .cb-launcher__icon--close { opacity: 0; transform: rotate(-90deg) scale(0.8); }
      .cb-launcher--active .cb-launcher__icon--open { opacity: 0; transform: rotate(90deg) scale(0.8); }
      .cb-launcher--active .cb-launcher__icon--close { opacity: 1; transform: rotate(0) scale(1); }

      /* ── Panel ──────────────────────────────────────────────────────── */
      .cb-panel {
        position: fixed;
        bottom: 5.5rem;
        right: 1.25rem;
        z-index: 9999;
        width: 380px;
        max-width: calc(100vw - 2.5rem);
        max-height: min(600px, calc(100vh - 8rem));
        display: flex;
        flex-direction: column;
        border-radius: 16px;
        overflow: hidden;
        background: var(--rs-surface, #fff);
        border: 1px solid var(--rs-border, #e5e7eb);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18), 0 4px 12px rgba(0, 0, 0, 0.08);
        opacity: 0;
        transform: translateY(16px) scale(0.96);
        pointer-events: none;
        transition: opacity 0.25s ease, transform 0.25s ease;
      }
      .cb-panel--open {
        opacity: 1;
        transform: translateY(0) scale(1);
        pointer-events: auto;
      }
      [data-skin="dark"] .cb-panel {
        background: var(--rs-surface, #1e1e2e);
        border-color: var(--rs-border, #2e2e3e);
        box-shadow: 0 20px 60px rgba(0,0,0,0.5), 0 4px 12px rgba(0,0,0,0.3);
      }

      /* ── Header ─────────────────────────────────────────────────────── */
      .cb-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.875rem 1rem;
        background: linear-gradient(135deg, var(--rs-brand, #2563eb) 0%, color-mix(in srgb, var(--rs-brand, #2563eb) 72%, #000) 100%);
        color: #fff;
        flex-shrink: 0;
      }
      .cb-header__info { display: flex; align-items: center; gap: 0.625rem; }
      .cb-header__avatar {
        width: 36px; height: 36px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: rgba(255, 255, 255, 0.18);
        flex-shrink: 0;
      }
      .cb-header__title { font-size: 0.9375rem; font-weight: 700; margin: 0; line-height: 1.2; }
      .cb-header__status { display: flex; align-items: center; gap: 0.375rem; font-size: 0.6875rem; margin: 0; opacity: 0.8; line-height: 1.2; }
      .cb-header__dot { width: 7px; height: 7px; border-radius: 50%; background: #4ade80; flex-shrink: 0; }
      .cb-header__close {
        background: none; border: none; color: rgba(255,255,255,0.8);
        cursor: pointer; padding: 4px; border-radius: 6px;
        display: flex; align-items: center; justify-content: center;
        transition: color 0.15s ease, background 0.15s ease;
      }
      .cb-header__close:hover { color: #fff; background: rgba(255,255,255,0.15); }

      /* ── Messages ───────────────────────────────────────────────────── */
      .cb-messages {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
      }
      .cb-messages::-webkit-scrollbar { width: 5px; }
      .cb-messages::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--rs-border, #ccc) 80%, transparent); border-radius: 3px; }
      .cb-messages::-webkit-scrollbar-track { background: transparent; }

      .cb-msg { display: flex; max-width: 88%; animation: cb-msg-in 0.3s ease; }
      .cb-msg--user { margin-left: auto; justify-content: flex-end; }
      .cb-msg--bot { margin-right: auto; justify-content: flex-start; }
      @keyframes cb-msg-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

      .cb-msg__bubble {
        padding: 0.625rem 0.875rem;
        border-radius: 14px;
        font-size: 0.875rem;
        line-height: 1.5;
        word-wrap: break-word;
        overflow-wrap: break-word;
      }
      .cb-msg--user .cb-msg__bubble {
        background: var(--rs-brand, #2563eb);
        color: #fff;
        border-bottom-right-radius: 4px;
      }
      .cb-msg--bot .cb-msg__bubble {
        background: color-mix(in srgb, var(--rs-brand, #2563eb) 8%, var(--rs-surface, #fff));
        color: var(--rs-text, #1f2937);
        border: 1px solid color-mix(in srgb, var(--rs-border, #e5e7eb) 60%, transparent);
        border-bottom-left-radius: 4px;
      }
      [data-skin="dark"] .cb-msg--bot .cb-msg__bubble {
        background: color-mix(in srgb, var(--rs-brand, #2563eb) 12%, var(--rs-surface, #1e1e2e));
        color: var(--rs-text, #e5e7eb);
        border-color: var(--rs-border, #2e2e3e);
      }
      .cb-msg__bubble p { margin: 0 0 0.5rem 0; }
      .cb-msg__bubble p:last-child { margin-bottom: 0; }
      .cb-msg__bubble strong { font-weight: 700; }

      .cb-source-link {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--rs-brand, #2563eb);
        text-decoration: none;
        margin-left: 0.25rem;
        transition: opacity 0.15s ease;
      }
      .cb-source-link:hover { opacity: 0.7; text-decoration: underline; }
      .cb-sources { display: inline-flex; gap: 0.5rem; flex-wrap: wrap; }

      /* ── Typing indicator ───────────────────────────────────────────── */
      .cb-typing-bubble { display: flex; gap: 4px; padding: 0.75rem 0.875rem; }
      .cb-typing-dot {
        width: 7px; height: 7px; border-radius: 50%;
        background: var(--rs-text-muted, #9ca3af);
        animation: cb-typing 1.3s infinite ease-in-out;
      }
      .cb-typing-dot:nth-child(2) { animation-delay: 0.2s; }
      .cb-typing-dot:nth-child(3) { animation-delay: 0.4s; }
      @keyframes cb-typing { 0%, 60%, 100% { opacity: 0.3; transform: translateY(0); } 30% { opacity: 1; transform: translateY(-4px); } }

      /* ── Input row ──────────────────────────────────────────────────── */
      .cb-input-row {
        display: flex;
        gap: 0.5rem;
        padding: 0.75rem;
        border-top: 1px solid color-mix(in srgb, var(--rs-border, #e5e7eb) 70%, transparent);
        flex-shrink: 0;
      }
      .cb-input {
        flex: 1;
        padding: 0.625rem 0.875rem;
        border: 1px solid var(--rs-border, #e5e7eb);
        border-radius: 10px;
        font-size: 0.875rem;
        font-family: inherit;
        background: var(--rs-surface, #fff);
        color: var(--rs-text, #1f2937);
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
      }
      .cb-input::placeholder { color: var(--rs-text-muted, #9ca3af); }
      .cb-input:focus {
        border-color: var(--rs-brand, #2563eb);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--rs-brand, #2563eb) 15%, transparent);
      }
      .cb-input:disabled { opacity: 0.6; cursor: not-allowed; }
      [data-skin="dark"] .cb-input { background: var(--rs-surface, #1e1e2e); border-color: var(--rs-border, #2e2e3e); color: var(--rs-text, #e5e7eb); }

      .cb-send {
        flex-shrink: 0;
        width: 40px; height: 40px;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        background: var(--rs-brand, #2563eb);
        color: #fff;
        transition: opacity 0.15s ease, transform 0.15s ease;
      }
      .cb-send:hover:not(:disabled) { opacity: 0.88; transform: scale(1.05); }
