---
import siteConfig from '../lib/site-config';

interface Props {
  /**
   * hero    – frosted-glass pill below trust signals; collapses to fit-content
   * sidebar – card-style block for use inside PageSidebar / BlogSidebar
   */
  variant?: 'hero' | 'sidebar';
}

const { variant = 'sidebar' } = Astro.props;

const reviewRating     = (siteConfig as any).reviewRating;
const reviewCount      = (siteConfig as any).reviewCount;
const reviewPlatform   = ((siteConfig as any).reviewPlatform  || 'Google').trim();
const reviewPlatformUrl = ((siteConfig as any).reviewPlatformUrl ?? '').trim();

// Nothing renders if reviewRating is not configured
const hasReview = !!reviewRating && String(reviewRating).trim() !== '';
if (!hasReview) return;

function formatCount(n: string | number): string {
  const num = Number(n);
  if (isNaN(num)) return String(n);
  return num.toLocaleString('en-US');
}

const ratingDisplay = String(reviewRating).trim();
const countDisplay  = reviewCount ? formatCount(reviewCount) : '';
// Build the label string server-side to avoid JSX whitespace-collapsing bugs
const reviewLabel   = countDisplay
  ? `${countDisplay} ${reviewPlatform} Reviews`
  : reviewPlatform;
const hasUrl        = reviewPlatformUrl.length > 0;
---

{variant === 'hero' ? (
  /* ── Hero: frosted-glass pill, collapses to fit-content width ──────── */
  hasUrl ? (
    <a
      href={reviewPlatformUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="rb-hero"
      aria-label={`${ratingDisplay} stars · ${reviewLabel} — opens in new tab`}
    >
      <svg class="rb-star" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="#f59e0b" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      <span class="rb-rating">{ratingDisplay}</span>
      <span class="rb-sep" aria-hidden="true">·</span>
      <span class="rb-text">{reviewLabel}</span>
      <svg class="rb-ext" xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
    </a>
  ) : (
    <div class="rb-hero" role="img" aria-label={`${ratingDisplay} stars · ${reviewLabel}`}>
      <svg class="rb-star" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="#f59e0b" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      <span class="rb-rating">{ratingDisplay}</span>
      <span class="rb-sep" aria-hidden="true">·</span>
      <span class="rb-text">{reviewLabel}</span>
    </div>
  )
) : (
  /* ── Sidebar: card block ─────────────────────────────────────────── */
  <div class="rb-card">
    <div class="rb-card-stars" aria-hidden="true">
      {Array.from({ length: 5 }).map(() => (
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#f59e0b"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      ))}
    </div>
    <div class="rb-card-row">
      <span class="rb-card-rating">{ratingDisplay}</span>
      <span class="rb-card-platform">{reviewPlatform}</span>
    </div>
    {countDisplay && (
      <p class="rb-card-count">Based on {countDisplay} reviews</p>
    )}
    {hasUrl && (
      <a href={reviewPlatformUrl} target="_blank" rel="noopener noreferrer" class="rb-card-link">
        Read reviews
        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      </a>
    )}
  </div>
)}

<style>
  /* ── Hero pill ────────────────────────────────────────────────────── */
  .rb-hero {
    /* collapse to content width — flex-column parent would otherwise stretch */
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1rem;
    padding: 0.5rem 1.1rem;
    border-radius: var(--rs-radius-pill, 999px);
    /* frosted glass — legible on any hero photo */
    background: rgba(255, 255, 255, 0.12);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.28);
    /* typography */
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1;
    color: #fff;
    text-decoration: none;
    cursor: default;
    transition: background 0.18s ease, border-color 0.18s ease;
  }
  a.rb-hero {
    cursor: pointer;
  }
  a.rb-hero:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .rb-star {
    flex-shrink: 0;
    filter: drop-shadow(0 0 3px rgba(245, 158, 11, 0.6));
  }

  .rb-rating {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    color: #fff;
  }

  .rb-sep {
    opacity: 0.45;
    font-weight: 400;
  }

  .rb-text {
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.85);
    font-weight: 600;
    font-size: 0.875rem;
  }

  .rb-ext {
    opacity: 0.5;
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.7);
  }

  /* ── Sidebar card ─────────────────────────────────────────────────── */
  .rb-card {
    border-radius: var(--radius-md, 12px);
    padding: 1.125rem 1.5rem;
    background: var(--rs-surface);
    border: 1px solid var(--rs-border);
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .rb-card-stars {
    display: flex;
    gap: 0.125rem;
    margin-bottom: 0.125rem;
  }

  .rb-card-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .rb-card-rating {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--rs-text, var(--color-text));
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .rb-card-platform {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--rs-text-muted, var(--color-text-muted));
  }

  .rb-card-count {
    font-size: 0.75rem;
    color: var(--rs-text-muted, var(--color-text-muted));
    margin: 0;
    line-height: 1.4;
  }

  .rb-card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--rs-brand-text, var(--color-brand));
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .rb-card-link:hover { opacity: 0.75; }

  @media (prefers-reduced-motion: reduce) {
    a.rb-hero, .rb-card-link { transition: none; }
  }
</style>
