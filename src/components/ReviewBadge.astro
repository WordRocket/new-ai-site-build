---
import siteConfig from '../lib/site-config';

const reviewRating      = (siteConfig as any).reviewRating;
const reviewCount       = (siteConfig as any).reviewCount;
const reviewPlatform    = ((siteConfig as any).reviewPlatform  || 'Google').trim();
const reviewPlatformUrl = ((siteConfig as any).reviewPlatformUrl ?? '').trim();

const hasReview = !!reviewRating && String(reviewRating).trim() !== '';
if (!hasReview) return;

function formatCount(n: string | number): string {
  const num = Number(n);
  return isNaN(num) ? String(n) : num.toLocaleString('en-US');
}

const ratingDisplay = String(reviewRating).trim();
const countDisplay  = reviewCount ? formatCount(reviewCount) : '';
const reviewLabel   = countDisplay
  ? `${countDisplay} ${reviewPlatform} Reviews`
  : `${reviewPlatform} Reviews`;
const hasUrl        = reviewPlatformUrl.length > 0;
---

{/* Badge pill — matches .u-badge eyebrow style; adapts to light + dark skins */}
{hasUrl ? (
  <a
    href={reviewPlatformUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="rb-hero"
    aria-label={`${ratingDisplay} stars · ${reviewLabel} — opens in new tab`}
  >
    <svg class="rb-star" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="var(--rs-star)" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
    <strong class="rb-rating">{ratingDisplay}</strong>
    <span class="rb-sep" aria-hidden="true">·</span>
    <span class="rb-text">{reviewLabel}</span>
  </a>
) : (
  <div class="rb-hero" role="img" aria-label={`${ratingDisplay} stars · ${reviewLabel}`}>
    <svg class="rb-star" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="var(--rs-star)" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
    <strong class="rb-rating">{ratingDisplay}</strong>
    <span class="rb-sep" aria-hidden="true">·</span>
    <span class="rb-text">{reviewLabel}</span>
  </div>
)}

<style>
  /* Matches .u-badge — brand-tinted pill, skin-adaptive */
  .rb-hero {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--rs-radius-pill, 999px);
    background: var(--rs-brand-tint);
    border: 1px solid var(--rs-brand-tint-border);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
    color: var(--rs-accent);
    text-decoration: none;
    cursor: default;
  }
  a.rb-hero {
    cursor: pointer;
    transition: opacity 0.15s ease;
  }
  a.rb-hero:hover { opacity: 0.75; }

  @media (min-width: 640px) {
    .rb-hero { align-self: flex-start; }
  }

  .rb-star { flex-shrink: 0; }

  .rb-rating {
    font-weight: 700;
    color: var(--rs-accent);
    font-variant-numeric: tabular-nums;
  }

  .rb-sep { opacity: 0.45; font-weight: 400; }

  .rb-text {
    font-weight: 500;
    white-space: nowrap;
    color: var(--rs-accent);
    opacity: 0.85;
  }

  @media (prefers-reduced-motion: reduce) {
    a.rb-hero { transition: none; }
  }
</style>
