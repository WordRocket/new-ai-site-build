---
/**
 * Reusable background-image layer for sections.
 * Usage:
 *   <SectionBgImage src={imageUrl} scrim="heavy" />            // FAQ dark: moody texture
 *   <SectionBgImage src={imageUrl} scrim="branded" />           // CTA: photographic mode
 *   <SectionBgImage src={imageUrl} scrim="heavy" lightScrim />  // FAQ light: white overlay
 *   <SectionBgImage src={imageUrl} scrim="heavy" hideOnLight /> // hidden on light skin
 *
 * The parent section must have: position:relative; overflow:hidden;
 * Content inside the section must have: position:relative; z-index:2;
 */
import { imgUrl, variantsSrcset, type ImageVariants } from '../lib/image';

interface Props {
  src: string;
  /** Pre-generated image variants from the upload pipeline. */
  variants?: ImageVariants;
  /** 'heavy'   = strong dark scrim (dark skin FAQ / texture)
   *  'branded' = lighter dark + brand-tinted gradient (CTA) */
  scrim?: 'heavy' | 'branded';
  /** When true, on light-skin pages the scrim switches to a soft white overlay
   *  so the photo shows through gently rather than being fully obscured. */
  lightScrim?: boolean;
  /** When true, the entire component is hidden on light-skin pages. */
  hideOnLight?: boolean;
}

const { src, variants, scrim = 'heavy', lightScrim = false, hideOnLight = false } = Astro.props;
const optimizedSrc = imgUrl(src, { w: 1440, q: 80 });
const srcset = variantsSrcset(variants);
---

<div class:list={['sbg', { 'sbg--hide-light': hideOnLight, 'sbg--light-scrim': lightScrim }]} aria-hidden="true">
  <img
    class="sbg__img"
    src={optimizedSrc}
    srcset={srcset || undefined}
    sizes={srcset ? '100vw' : undefined}
    alt=""
    role="presentation"
    loading="lazy"
    decoding="async"
    width="1440"
    height="900"
  />
  <div class={`sbg__scrim sbg__scrim--${scrim}`}></div>
</div>

<style>
  .sbg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .sbg__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Heavy scrim — dark skin FAQ texture mode */
  .sbg__scrim--heavy {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        160deg,
        rgba(4, 8, 20, 0.92) 0%,
        rgba(4, 8, 20, 0.87) 50%,
        rgba(4, 8, 20, 0.92) 100%
      );
  }

  /* Branded scrim — CTA photographic mode */
  .sbg__scrim--branded {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        105deg,
        rgba(4, 10, 28, 0.72) 0%,
        rgba(4, 10, 28, 0.68) 40%,
        color-mix(in srgb, var(--rs-brand) 10%, rgba(4, 10, 28, 0.82)) 65%,
        color-mix(in srgb, var(--rs-brand) 14%, rgba(2, 6, 20, 0.88)) 100%
      );
  }

  /* lightScrim: on light-skin pages swap heavy dark scrim for a soft white overlay
     so the photo bleeds through as subtle background texture, not a full backdrop. */
  :global([data-skin="light"]) .sbg--light-scrim .sbg__scrim {
    background: rgba(245, 249, 255, 0.82) !important;
  }

  /* hideOnLight: suppress the entire component on light-skin pages */
  :global([data-skin="light"]) .sbg--hide-light {
    display: none;
  }
</style>
