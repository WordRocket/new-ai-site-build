---
interface Props {
  quote?: string;
  author?: string;
  location?: string;
}

const {
  quote = 'Outstanding service from start to finish. Professional, timely, and the results exceeded our expectations.',
  author = 'Happy Customer',
  location = 'Local Resident',
} = Astro.props;
---

<aside
  aria-label="Customer review"
  class="mt-10 relative p-6 sm:p-8 rounded-[var(--radius-lg)]"
  style="background:var(--color-neutral-50,#f9fafb); border:1px solid #e4e4e7; border-left:4px solid var(--rs-brand);"
>
  <!-- Quote mark decoration -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="32"
    height="32"
    viewBox="0 0 24 24"
    fill="var(--color-brand)"
    aria-hidden="true"
    class="mb-3 opacity-20"
  >
    <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/>
    <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/>
  </svg>

  <blockquote class="text-base sm:text-lg italic leading-relaxed text-[var(--color-text)] mb-4">
    "{quote}"
  </blockquote>

  <footer class="flex items-center gap-3">
    <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold shrink-0" style="background-color:var(--rs-brand); color:var(--rs-on-brand);">
      {author.charAt(0).toUpperCase()}
    </div>
    <div class="flex flex-col">
      <span class="text-sm font-semibold text-[var(--color-text)]">{author}</span>
      {location && <span class="text-xs" style="color:var(--color-text-muted);">{location}</span>}
    </div>
    <!-- Star rating -->
    <div class="ml-auto flex items-center gap-0.5" role="img" aria-label="5 star rating">
      {Array.from({ length: 5 }).map(() => (
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#f59e0b" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      ))}
    </div>
  </footer>
</aside>
