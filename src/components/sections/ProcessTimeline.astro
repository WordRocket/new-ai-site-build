---
import siteConfig from '../../lib/site-config';
import { getPreset } from '../../lib/business-presets';
import { iconSvg } from '../../lib/icons';

interface Step {
  title: string;
  desc: string;
  icon?: string;
}

interface Props {
  steps: Step[];
  heading?: string;
}

const { steps, heading } = Astro.props;

if (!steps || steps.length === 0) return;

const preset = getPreset((siteConfig as any).businessType || 'other');
const displayHeading = heading ?? preset.processHeading;

const defaultIcons = ['check-circle', 'calendar', 'zap', 'star', 'trending-up', 'award'];
---

<section class="process-timeline" aria-labelledby="process-heading">
  <div class="process-timeline__inner">
    <h2 id="process-heading" class="process-timeline__heading reveal">
      {displayHeading}
    </h2>

    <ol class="process-timeline__list" aria-label={displayHeading}>
      {steps.map((step, i) => {
        const iconName = step.icon ?? defaultIcons[i % defaultIcons.length];
        return (
          <li class="process-timeline__step reveal">
            <div class="process-timeline__marker" aria-hidden="true">
              <span class="process-timeline__num">{i + 1}</span>
              <span class="process-timeline__icon">
                <Fragment set:html={iconSvg(iconName, 16)} />
              </span>
            </div>
            {i < steps.length - 1 && (
              <div class="process-timeline__line" aria-hidden="true"></div>
            )}
            <div class="process-timeline__content">
              <h3 class="process-timeline__title">{step.title}</h3>
              <p class="process-timeline__desc">{step.desc}</p>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .process-timeline {
    padding: 100px 1rem;
    background: var(--color-neutral-50);
  }

  @media (max-width: 768px) {
    .process-timeline { padding: 64px 1rem; }
  }

  .process-timeline__inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .process-timeline__heading {
    text-align: center;
    margin-bottom: 3rem;
    color: var(--color-text);
  }

  .process-timeline__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .process-timeline__step {
    display: grid;
    grid-template-columns: 48px 1fr;
    grid-template-rows: auto 1fr;
    column-gap: 1.25rem;
    padding-bottom: 2.5rem;
    position: relative;
  }

  .process-timeline__step:last-child {
    padding-bottom: 0;
  }

  .process-timeline__marker {
    grid-column: 1;
    grid-row: 1;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-light) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
  }

  .process-timeline__num {
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1;
  }

  /* Icon overlays the number on hover via opacity — pure CSS */
  .process-timeline__icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .process-timeline__step:hover .process-timeline__icon { opacity: 1; }
  .process-timeline__step:hover .process-timeline__num  { opacity: 0; }

  .process-timeline__num {
    transition: opacity 0.2s ease;
  }

  .process-timeline__line {
    grid-column: 1;
    grid-row: 2;
    width: 2px;
    background: linear-gradient(to bottom, var(--color-brand), rgba(37, 99, 235, 0.15));
    margin: 0 auto;
    min-height: 2rem;
  }

  .process-timeline__content {
    grid-column: 2;
    grid-row: 1 / 3;
    padding-top: 0.75rem;
  }

  .process-timeline__title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.35rem;
    letter-spacing: -0.01em;
  }

  .process-timeline__desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .process-timeline__icon,
    .process-timeline__num {
      transition: none;
    }
  }
</style>
