---
import siteConfig from '../../lib/site-config';
import { getPreset } from '../../lib/business-presets';

interface Step {
  title: string;
  desc: string;
}

interface Props {
  steps: Step[];
  heading?: string;
}

const { steps, heading } = Astro.props;
if (!steps || steps.length === 0) return;

const preset = getPreset((siteConfig as any).businessType || 'other');
const displayHeading = heading ?? preset.processHeading;

function splitH(h: string) {
  const words = h.trim().split(/\s+/);
  if (words.length === 1) return { main: '', last: words[0] };
  return { main: words.slice(0, -1).join(' ') + ' ', last: words[words.length - 1] };
}
const { main: hMain, last: hLast } = splitH(displayHeading);
---

<section
  class="pt section-pad"
  style="background:var(--rs-surface);"
  aria-labelledby="pt-heading"
>
  <div class="pt__wrap">
    <div class="pt__header reveal">
      <h2 id="pt-heading" style="color:var(--rs-text); margin:0;">
        {hMain}<span class="u-gradient-text">{hLast}</span>
      </h2>
    </div>

    <ol class="pt__list" aria-label={displayHeading}>
      {steps.map((step, i) => (
        <li class={`pt__step pt__step--${i}`}>
          <div class="pt__marker" aria-hidden="true">
            <span class="pt__num">{i + 1}</span>
          </div>
          <div class="pt__body">
            <h3 class="pt__title" style="color:var(--rs-text);">{step.title}</h3>
            <p class="pt__desc" style="color:var(--rs-text-muted);">{step.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .pt__wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .pt__header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  /* ── Mobile: vertical stack ── */
  .pt__list {
    list-style: none;
    padding: 0; margin: 0;
    display: flex;
    flex-direction: column;
  }

  .pt__step {
    display: grid;
    grid-template-columns: 40px 1fr;
    column-gap: 1.25rem;
    padding-bottom: 2.5rem;
    position: relative;
  }
  .pt__step:last-child { padding-bottom: 0; }

  /* Vertical connector on mobile */
  .pt__step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 19px;
    top: 40px;
    bottom: 0;
    width: 2px;
    background: linear-gradient(
      to bottom,
      var(--rs-accent),
      color-mix(in srgb, var(--rs-accent) 15%, transparent)
    );
    transform-origin: top center;
  }

  .pt__marker {
    width: 40px; height: 40px;
    border-radius: 50%;
    background: var(--rs-accent);
    color: var(--rs-accent-contrast);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    font-size: .9375rem; font-weight: 700; line-height: 1;
    box-shadow: 0 4px 12px color-mix(in srgb, var(--rs-accent) 36%, transparent);
    position: relative; z-index: 1;
  }

  .pt__body { padding-top: .5rem; }

  .pt__title {
    font-size: 1rem; font-weight: 700;
    margin: 0 0 .35rem; letter-spacing: -.01em;
  }
  .pt__desc {
    font-size: .9375rem; line-height: 1.65; margin: 0;
  }

  /* ── Desktop: horizontal row ── */
  @media (min-width: 768px) {
    .pt__list {
      flex-direction: row;
      align-items: flex-start;
    }

    .pt__step {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 0 1rem;
    }

    /* Horizontal connector: from right edge of this circle to left edge of next */
    .pt__step:not(:last-child)::after {
      left: calc(50% + 21px);
      right: calc(-50% + 21px);
      top: 19px;
      bottom: auto;
      width: auto;
      height: 2px;
      background: linear-gradient(
        to right,
        var(--rs-accent),
        color-mix(in srgb, var(--rs-accent) 25%, var(--rs-border))
      );
      transform-origin: left center;
    }

    .pt__marker { margin-bottom: 1.25rem; }
    .pt__body { padding-top: 0; }
  }

  /* ─────────────────────────────────────────────────────────────────────
     Scroll-driven staggered reveal
     Each step fades + slides up tied to the timeline section entering view.
     The ::after connector line draws in (scaleX/scaleY) just before the
     next step appears, giving a left-to-right "drawing" feel on desktop
     and a top-to-bottom draw on mobile.
     Content is always visible by default — animation is pure enhancement.
  ───────────────────────────────────────────────────────────────────── */

  @keyframes pt-step-in {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: none; }
  }

  @keyframes pt-line-draw-x {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  @keyframes pt-line-draw-y {
    from { transform: scaleY(0); }
    to   { transform: scaleY(1); }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* All steps animate relative to the section entering the viewport */
      .pt__step {
        animation: pt-step-in 0.35s ease-out both;
        animation-timeline: view();
        animation-range: entry 5% cover 35%;
      }

      /* Stagger each step by 120ms so they cascade left-to-right */
      .pt__step--0 { animation-delay:  0ms; }
      .pt__step--1 { animation-delay: 120ms; }
      .pt__step--2 { animation-delay: 240ms; }
      .pt__step--3 { animation-delay: 360ms; }
      .pt__step--4 { animation-delay: 480ms; }

      /* Mobile: connector line draws downward, delayed so it starts after
         the step above it appears and before the next step does */
      .pt__step:not(:last-child)::after {
        animation: pt-line-draw-y 0.3s ease-out both;
        animation-timeline: view();
        animation-range: entry 5% cover 35%;
      }
      .pt__step--0:not(:last-child)::after { animation-delay:  60ms; }
      .pt__step--1:not(:last-child)::after { animation-delay: 180ms; }
      .pt__step--2:not(:last-child)::after { animation-delay: 300ms; }
      .pt__step--3:not(:last-child)::after { animation-delay: 420ms; }

      /* Desktop: connector draws left-to-right */
      @media (min-width: 768px) {
        .pt__step:not(:last-child)::after {
          animation-name: pt-line-draw-x;
        }
      }
    }
  }
</style>
