---
import SmartImage from '../SmartImage.astro';
import Icon from '../Icon.astro';
import type { ImageVariants } from '../../lib/image';

interface CheckItem {
  text: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  body: string;
  checks?: CheckItem[];
  ctaText?: string;
  ctaHref?: string;
  image?: string;
  imageVariants?: ImageVariants;
  imageAlt?: string;
  imageAspect?: string;
  /** Flip image/text sides on desktop. On mobile, image always stacks above text. */
  reverse?: boolean;
  bg?: string;
  /** Floating stat badge overlaid on the image (bottom-left corner). */
  statValue?: string;
  statLabel?: string;
}

const {
  eyebrow,
  heading,
  body,
  checks = [],
  ctaText,
  ctaHref,
  image,
  imageVariants,
  imageAlt = '',
  imageAspect = '4/3',
  reverse = false,
  bg = 'var(--rs-bg, #ffffff)',
  statValue,
  statLabel,
} = Astro.props;

const showBadge = statValue && statLabel;

function splitH(h: string): { main: string; last: string } {
  const words = h.trim().split(/\s+/);
  if (words.length === 1) return { main: '', last: words[0] };
  return { main: words.slice(0, -1).join(' ') + ' ', last: words[words.length - 1] };
}
const { main: frMain, last: frLast } = splitH(heading);
---

<section class="fr-section u-reveal" style={`background:${bg};`}>
  <div class:list={['fr-inner', reverse && 'fr-inner--rev']}>

    <!-- Image column -->
    <div class="fr-media">
      <!-- fr-media-pos is position:relative without overflow:hidden so the badge isn't clipped -->
      <div class="fr-media-pos">
        <!-- fr-media-wrap clips the image to border-radius -->
        <div class="fr-media-wrap">
          <SmartImage src={image} alt={imageAlt || heading} aspect={imageAspect} variants={imageVariants} />
        </div>

        {showBadge && (
          <div class="fr-badge">
            <span class="fr-badge__value">{statValue}</span>
            <span class="fr-badge__label">{statLabel}</span>
          </div>
        )}
      </div>
    </div>

    <!-- Text column -->
    <div class="fr-text">
      {eyebrow && <span class="u-eyebrow fr-eyebrow">{eyebrow}</span>}

      <h2 class="fr-heading">{frMain}<span class="u-gradient-text">{frLast}</span></h2>

      <p class="fr-body">{body}</p>

      {checks.length > 0 && (
        <ul class="fr-checks" role="list">
          {checks.map(({ text }) => (
            <li class="fr-check-item">
              <span class="fr-check-icon" aria-hidden="true">
                <Icon name="check-circle" width={18} height={18} />
              </span>
              {text}
            </li>
          ))}
        </ul>
      )}

      {ctaText && ctaHref && (
        <a href={ctaHref} class="u-btn u-btn-primary fr-cta">
          {ctaText}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      )}
    </div>

  </div>
</section>

<style>
  .fr-section {
    padding: 96px 0;
  }
  @media (max-width: 768px) {
    .fr-section { padding: 60px 0; }
  }

  .fr-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }
  .fr-inner--rev .fr-media { order: 2; }
  .fr-inner--rev .fr-text  { order: 1; }

  @media (max-width: 900px) {
    .fr-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .fr-inner .fr-media,
    .fr-inner--rev .fr-media { order: 1; }
    .fr-inner .fr-text,
    .fr-inner--rev .fr-text  { order: 2; }
  }

  @media (min-width: 901px) and (max-width: 1100px) {
    .fr-inner { gap: 3rem; }
  }

  /* ── Media panel ────────────────────────── */
  .fr-media-pos {
    position: relative;
  }

  .fr-media-wrap {
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.10);
  }

  /* ── Floating stat badge ────────────────── */
  .fr-badge {
    position: absolute;
    bottom: 1.25rem;
    left: 1.25rem;
    background: var(--rs-surface, #f8fafc);
    border: 1px solid var(--rs-border, #e6e8ec);
    border-radius: var(--rs-radius-md, 12px);
    box-shadow: var(--rs-shadow-card);
    padding: 0.625rem 0.875rem;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 108px;
    pointer-events: none;
  }

  .fr-badge__value {
    font-size: 1.375rem;
    font-weight: 800;
    line-height: 1;
    color: var(--rs-brand-text);
    letter-spacing: -0.02em;
  }

  .fr-badge__label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.3;
    color: var(--rs-text-muted, #51607a);
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .fr-badge {
      bottom: 0.75rem;
      left: 0.75rem;
      padding: 0.5rem 0.75rem;
      min-width: 90px;
    }
    .fr-badge__value { font-size: 1.125rem; }
  }

  /* ── Text panel ─────────────────────────── */
  .fr-text {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .fr-eyebrow {
    margin-bottom: 0.875rem;
  }

  .fr-heading {
    font-size: clamp(1.75rem, 2.6vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--rs-text, var(--color-text));
    margin: 0 0 1rem;
  }

  .fr-body {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--rs-text-muted, var(--color-text-muted));
    margin: 0 0 1.5rem;
    max-width: 52ch;
  }

  .fr-checks {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .fr-check-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--rs-text, var(--color-text));
    line-height: 1.4;
  }

  .fr-check-icon {
    color: var(--rs-brand-text);
    flex-shrink: 0;
    display: flex;
  }

  .fr-cta {
    align-self: flex-start;
    padding: 0.75rem 1.5rem;
    font-size: 0.9375rem;
  }
</style>
