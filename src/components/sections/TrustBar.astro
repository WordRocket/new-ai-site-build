---
import siteConfig from '../../lib/site-config';
import { getPreset } from '../../lib/business-presets';
import { iconSvg } from '../../lib/icons';

const preset = getPreset((siteConfig as any).businessType || 'other');
const signals = preset.trustSignals;
---

{signals.length > 0 && (
  <div
    class="trust-bar"
    role="list"
    aria-label="Trust signals"
  >
    {signals.map(({ icon, label }) => (
      <div class="trust-bar__item" role="listitem">
        <span class="trust-bar__icon trust-icon" aria-hidden="true">
          <Fragment set:html={iconSvg(icon, 18)} />
        </span>
        <span class="trust-bar__label">{label}</span>
      </div>
    ))}
  </div>
)}

<style>
  .trust-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    padding: 0.5rem 1rem;
    background: var(--rs-surface);
    border-top: 1px solid var(--rs-border);
    border-bottom: 1px solid var(--rs-border);
  }

  .trust-bar__item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--rs-text);
    white-space: nowrap;
  }

  .trust-bar__icon {
    color: var(--rs-accent);
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  /* 2-col grid on narrow screens */
  @media (max-width: 480px) {
    .trust-bar {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.625rem;
      padding: 0.625rem;
    }
    .trust-bar__item {
      white-space: normal;
    }
  }
</style>
