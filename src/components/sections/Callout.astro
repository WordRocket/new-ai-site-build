---
interface Props {
  variant?: 'info' | 'tip' | 'warning' | 'tldr';
  title?: string;
}

const { variant = 'info', title } = Astro.props;

const CONFIG = {
  info: {
    color: 'var(--color-brand)',
    bg:    'rgba(37,99,235,0.06)',
    icon:  `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>`,
    label: title ?? 'Note',
  },
  tip: {
    color: '#059669',
    bg:    'rgba(5,150,105,0.06)',
    icon:  `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>`,
    label: title ?? 'Tip',
  },
  warning: {
    color: '#d97706',
    bg:    'rgba(217,119,6,0.06)',
    icon:  `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>`,
    label: title ?? 'Warning',
  },
  tldr: {
    color: '#7c3aed',
    bg:    'rgba(124,58,237,0.06)',
    icon:  `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" x2="21" y1="6" y2="6"/><line x1="8" x2="21" y1="12" y2="12"/><line x1="8" x2="21" y1="18" y2="18"/><line x1="3" x2="3.01" y1="6" y2="6"/><line x1="3" x2="3.01" y1="12" y2="12"/><line x1="3" x2="3.01" y1="18" y2="18"/></svg>`,
    label: title ?? 'TL;DR',
  },
} as const;

const cfg = CONFIG[variant];
---

<aside
  class="callout"
  style={`--callout-color:${cfg.color}; --callout-bg:${cfg.bg};`}
  role="note"
  aria-label={cfg.label}
>
  <div class="callout__header">
    <span class="callout__icon"><Fragment set:html={cfg.icon} /></span>
    <span class="callout__title">{cfg.label}</span>
  </div>
  <div class="callout__body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    border-left: 4px solid var(--callout-color);
    background: var(--callout-bg);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    font-size: 0.9375rem;
  }

  .callout__header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.4rem;
  }

  .callout__icon {
    color: var(--callout-color);
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .callout__title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--callout-color);
  }

  .callout__body {
    color: var(--color-text);
    line-height: 1.65;
  }

  .callout__body :global(p) {
    margin: 0;
  }

  .callout__body :global(p + p) {
    margin-top: 0.5em;
  }
</style>
