---
import siteConfig from '../../lib/site-config';
import { getPreset, interpolate } from '../../lib/business-presets';
import Icon from '../Icon.astro';
import SmartImage from '../SmartImage.astro';

interface Props {
  secondaryLabel?: string;
  secondaryHref?: string;
}

const { secondaryLabel, secondaryHref } = Astro.props;
const preset = getPreset((siteConfig as any).businessType || 'other');
const band = preset.ctaBand;
const phoneDigits = siteConfig.phone ? siteConfig.phone.replace(/\D/g, '') : '';
const btnHref = interpolate(band.buttonHref, {
  phone: phoneDigits,
  email: (siteConfig as any).email ?? '',
});

const ctaImage: string = ((siteConfig as any).ctaImage ?? '').trim();
const hasImage = ctaImage.length > 0;
---

<section class="cb" aria-labelledby="cb-heading" data-bg={hasImage ? 'image' : undefined}>
  {hasImage && (
    <div class="cb__bg-img" aria-hidden="true">
      <SmartImage
        src={ctaImage}
        alt=""
        aspect="16/5"
        loading="lazy"
        style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;"
      />
      <div class="cb__scrim"></div>
    </div>
  )}
  <div class="cb__inner">
    <div class="cb__icon" aria-hidden="true">
      <Icon name="zap" width={26} height={26} />
    </div>

    <h2 id="cb-heading" class="cb__heading">{band.heading}</h2>
    <p class="cb__sub">{band.subtext}</p>

    <div class="cb__btns">
      <a href={btnHref} class="u-btn cb__primary">
        {band.buttonLabel}
        <Icon name="arrow-right" width={16} height={16} aria-hidden="true" />
      </a>
      {secondaryLabel && secondaryHref && (
        <a href={secondaryHref} class="u-btn cb__ghost">{secondaryLabel}</a>
      )}
    </div>
  </div>
</section>

<style>
  .cb {
    padding: 80px 1rem;
    position: relative;
    overflow: hidden;
    background: var(--rs-surface-2);
  }

  /* Dark skin: bold accent gradient + dot grid */
  [data-skin="dark"] .cb {
    background: linear-gradient(135deg, var(--rs-grad-from), var(--rs-grad-to));
  }
  [data-skin="dark"] .cb::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
  }

  /* Image mode: suppress gradient backgrounds, let image+scrim take over */
  .cb[data-bg="image"],
  [data-skin="dark"] .cb[data-bg="image"] {
    background: transparent;
  }
  [data-skin="dark"] .cb[data-bg="image"]::before {
    display: none;
  }

  /* Background image container */
  .cb__bg-img {
    position: absolute; inset: 0; z-index: 0;
  }
  .cb__bg-img :global(picture),
  .cb__bg-img :global(img) {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Dark scrim — solid enough for legibility against any photo */
  .cb__scrim {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(
      160deg,
      rgba(0, 0, 0, 0.72) 0%,
      rgba(0, 0, 0, 0.62) 60%,
      rgba(0, 0, 0, 0.68) 100%
    );
  }

  .cb__inner {
    position: relative; z-index: 2;
    max-width: 640px; margin: 0 auto;
    text-align: center;
    display: flex; flex-direction: column;
    align-items: center; gap: 1rem;
  }

  .cb__icon {
    width: 52px; height: 52px;
    border-radius: var(--rs-radius-md);
    background: color-mix(in srgb, var(--rs-accent) 14%, transparent);
    color: var(--rs-accent);
    display: flex; align-items: center; justify-content: center;
  }
  [data-skin="dark"] .cb__icon {
    background: rgba(255,255,255,.12);
    color: color-mix(in srgb, var(--rs-brand) 30%, white);
  }

  .cb__heading {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800; letter-spacing: -.025em; line-height: 1.15; margin: 0;
    color: var(--rs-text);
  }
  [data-skin="dark"] .cb__heading { color: var(--rs-accent-contrast); }

  .cb__sub {
    font-size: 1.0625rem; line-height: 1.6; margin: 0; max-width: 480px;
    color: var(--rs-text-muted);
  }
  [data-skin="dark"] .cb__sub { color: rgba(255,255,255,.72); }

  .cb__btns {
    display: flex; flex-wrap: wrap;
    gap: .75rem; justify-content: center;
    margin-top: .5rem;
  }

  /* Primary button */
  .cb__primary {
    background: var(--rs-accent);
    color: var(--rs-accent-contrast);
    border: 2px solid var(--rs-accent);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--rs-accent) 32%, transparent);
  }
  .cb__primary:hover {
    box-shadow: 0 6px 20px color-mix(in srgb, var(--rs-accent) 44%, transparent);
  }
  [data-skin="dark"] .cb__primary {
    background: #ffffff;
    color: oklch(from var(--rs-brand) clamp(0, l, 0.4) c h);
    border-color: #ffffff;
    box-shadow: 0 4px 14px rgba(0,0,0,.2);
  }

  /* Ghost button */
  .cb__ghost {
    background: transparent;
    color: var(--rs-accent);
    border: 2px solid var(--rs-accent);
  }
  .cb__ghost:hover {
    background: color-mix(in srgb, var(--rs-accent) 8%, transparent);
  }
  [data-skin="dark"] .cb__ghost {
    color: var(--rs-on-brand);
    border-color: color-mix(in srgb, var(--rs-on-brand) 55%, transparent);
  }
  [data-skin="dark"] .cb__ghost:hover {
    background: color-mix(in srgb, var(--rs-on-brand) 12%, transparent);
  }

  .cb__primary:focus-visible,
  .cb__ghost:focus-visible {
    outline: 3px solid var(--rs-accent);
    outline-offset: 3px;
  }

  /* ── Image mode overrides — declared LAST so source order beats equal-
     specificity skin rules on both light and dark skins. The Astro scoped
     attribute adds one attribute selector to every rule; [data-skin] rules
     compiled form is [data-skin="dark"] [data-astro-cid] .cb__heading
     (2 attrs + 1 class). The image-mode rules below are
     .cb[data-bg="image"] [data-astro-cid] .cb__heading (1 attr + 2 classes),
     equal specificity — source order (last wins) is what makes these win. ── */
  .cb[data-bg="image"] .cb__icon {
    background: rgba(255,255,255,.12);
    color: color-mix(in srgb, var(--rs-brand) 30%, white);
  }
  .cb[data-bg="image"] .cb__heading {
    color: #ffffff;
  }
  .cb[data-bg="image"] .cb__sub {
    color: rgba(255, 255, 255, 0.82);
  }
  .cb[data-bg="image"] .cb__primary {
    background: #ffffff;
    color: oklch(from var(--rs-brand) clamp(0, l, 0.4) c h);
    border-color: #ffffff;
    box-shadow: 0 4px 14px rgba(0,0,0,.2);
  }
  .cb[data-bg="image"] .cb__ghost {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.55);
  }
  .cb[data-bg="image"] .cb__ghost:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  @media (max-width: 640px) { .cb { padding: 64px 1rem; } }
</style>
