---
import Icon from '../Icon.astro';

interface Item {
  title: string;
  desc: string;
  icon?: string;
}

interface Props {
  items: Item[];
  heading?: string;
  eyebrow?: string;
  /** 'cards' = stacked card grid (local-service default).
   *  'rows' = horizontal icon-row layout (AstroWind-inspired, general default). */
  variant?: 'cards' | 'rows';
}

const { items, heading, eyebrow, variant = 'cards' } = Astro.props;
if (!items || items.length === 0) return;

const isRows = variant === 'rows';
const fallbackIcons = ['zap', 'shield-check', 'star', 'check-circle', 'award', 'lock', 'heart', 'thumbs-up'];

function splitH(h: string) {
  const words = h.trim().split(/\s+/);
  if (words.length === 1) return { main: '', last: words[0] };
  return { main: words.slice(0, -1).join(' ') + ' ', last: words[words.length - 1] };
}
const { main: hMain, last: hLast } = heading ? splitH(heading) : { main: '', last: '' };
---

<section
  class={`fg section-pad${isRows ? ' fg--rows' : ''}`}
  style="background:var(--rs-bg);"
  aria-labelledby={heading ? 'fg-heading' : undefined}
>
  <div class="fg__wrap">
    {(eyebrow || heading) && (
      <div class="fg__header reveal">
        {eyebrow && <span class="u-eyebrow">{eyebrow}</span>}
        {heading && (
          <h2 id="fg-heading" class="fg__h2" style="color:var(--rs-text);">
            {hMain}<span class="u-gradient-text">{hLast}</span>
          </h2>
        )}
      </div>
    )}

    <ul class={`fg__grid${isRows ? ' fg__grid--rows' : ''}`} role="list">
      {items.map((item, i) => {
        const iconName = item.icon ?? fallbackIcons[i % fallbackIcons.length];
        return (
          <li class={`${isRows ? 'fg__row reveal' : 'u-card fg__card reveal'}`} role="listitem">
            <span class={`fg__chip${isRows ? ' fg__chip--row' : ''}`} aria-hidden="true">
              <Icon name={iconName} width={isRows ? 24 : 22} height={isRows ? 24 : 22} />
            </span>
            <div class="fg__body">
              <h3 class="fg__title" style="color:var(--rs-text);">{item.title}</h3>
              <p class="fg__desc" style="color:var(--rs-text-muted);">{item.desc}</p>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .fg__wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .fg__header {
    text-align: center;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .75rem;
  }

  .fg__h2 { margin: 0; }

  /* ── Cards variant (local-service, unchanged) ─────────────────────────── */
  .fg__grid {
    list-style: none;
    padding: 0; margin: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 560px) {
    .fg__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 900px) {
    .fg__grid { grid-template-columns: repeat(3, 1fr); }
  }

  .fg__grid:has(> :nth-child(1):last-child) {
    grid-template-columns: minmax(0, 400px);
    justify-content: center;
  }
  .fg__grid:has(> :nth-child(2):last-child) {
    grid-template-columns: repeat(2, minmax(0, 400px));
    justify-content: center;
  }

  .fg__card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: .75rem;
  }

  .fg__chip {
    width: 48px; height: 48px;
    border-radius: var(--rs-radius-sm);
    background: color-mix(in srgb, var(--rs-accent) 12%, transparent);
    color: var(--rs-accent);
    display: inline-flex;
    align-items: center; justify-content: center;
    flex-shrink: 0;
    transition: background .2s ease, color .2s ease;
  }

  .fg__card:hover .fg__chip {
    background: var(--rs-accent);
    color: var(--rs-accent-contrast);
  }

  .fg__title {
    font-size: 1rem; font-weight: 700;
    margin: 0; letter-spacing: -.01em;
  }
  .fg__desc {
    font-size: .9375rem; line-height: 1.65; margin: 0;
  }

  /* ── Rows variant (general, AstroWind-inspired) ───────────────────────── */
  .fg--rows .fg__header { margin-bottom: 3rem; }

  .fg__grid--rows {
    list-style: none;
    padding: 0; margin: 0;
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    max-width: 80rem;
    margin-left: auto;
    margin-right: auto;
  }
  @media (min-width: 560px) {
    .fg__grid--rows { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 900px) {
    .fg__grid--rows { grid-template-columns: repeat(3, 1fr); }
  }

  .fg__row {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 1rem;
    max-width: 28rem;
  }

  .fg__chip--row {
    width: 44px; height: 44px;
    border-radius: var(--rs-radius-pill);
    background: var(--rs-accent);
    color: var(--rs-accent-contrast);
  }

  .fg__row .fg__body {
    display: flex;
    flex-direction: column;
    gap: .5rem;
    margin-top: .125rem;
  }

  .fg__row .fg__title {
    font-size: 1.125rem; font-weight: 700;
  }
  .fg__row .fg__desc {
    font-size: .9375rem; line-height: 1.65;
  }

  @media (prefers-reduced-motion: reduce) {
    .fg__chip { transition: none; }
  }
</style>
