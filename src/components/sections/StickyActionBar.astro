---
import siteConfig from '../../lib/site-config';
import { getPreset, interpolate } from '../../lib/business-presets';

const preset = getPreset((siteConfig as any).businessType || 'other');
const bar = preset.stickyBar;

if (!bar.show) return;

const phoneDigits = siteConfig.phone ? siteConfig.phone.replace(/\D/g, '') : '';
const vars = { phone: phoneDigits, email: siteConfig.email ?? '' };

function resolveHref(raw: string): string {
  const href = interpolate(raw, vars);
  // If a tel: link resolved to no number, fall back to /contact
  if (href === 'tel:' || href === 'tel: ') return '/contact';
  return href;
}

const primaryHref   = resolveHref(bar.primaryHref);
const secondaryHref = resolveHref(bar.secondaryHref);
---

<div class="sticky-bar" role="navigation" aria-label="Quick actions">
  <a
    href={primaryHref}
    class="sticky-bar__btn sticky-bar__btn--primary"
    aria-label={bar.primaryLabel}
  >
    {bar.primaryLabel}
  </a>
  <a
    href={secondaryHref}
    class="sticky-bar__btn sticky-bar__btn--secondary"
    aria-label={bar.secondaryLabel}
  >
    {bar.secondaryLabel}
  </a>
</div>

<style>
  .sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: var(--rs-surface);
    border-top: 1px solid var(--rs-border);
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
    /* safe area for notched phones */
    padding-bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));
  }

  /* Hide on desktop — sidebar replaces it at ≥1024px */
  @media (min-width: 1024px) {
    .sticky-bar {
      display: none;
    }
  }

  .sticky-bar__btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    border-radius: var(--radius-md);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .sticky-bar__btn:focus-visible {
    outline: 3px solid var(--color-brand);
    outline-offset: 2px;
  }

  .sticky-bar__btn:active {
    transform: scale(0.97);
    opacity: 0.9;
  }

  .sticky-bar__btn--primary {
    background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-light) 100%);
    color: white;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
  }

  .sticky-bar__btn--secondary {
    background: transparent;
    color: var(--color-brand);
    border: 2px solid var(--color-brand);
  }

  .sticky-bar__btn--secondary:hover {
    background: var(--color-brand);
    color: white;
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-bar__btn {
      transition: none;
    }
  }
</style>

<style is:global>
  /* Prevent the fixed bar from obscuring footer content on mobile */
  @media (max-width: 1023px) {
    body:has(.sticky-bar) {
      padding-bottom: 80px;
    }
  }
</style>
