---
import siteConfig, { formatPhone } from '../lib/site-config';
import { getPreset } from '../lib/business-presets';
import { iconSvg } from '../lib/icons';

interface CategoryItem {
  slug: string;
  title: string;
}

interface Props {
  currentSlug: string;
  categories: CategoryItem[];
  articleCount: number;
  hasFaq: boolean;
}

const { currentSlug, categories, articleCount, hasFaq } = Astro.props;

const preset = getPreset((siteConfig as any).businessType || 'other');
const signals = preset.trustSignals;

const phoneDigits = siteConfig.phone ? siteConfig.phone.replace(/\D/g, '') : '';
const showPhone = !!siteConfig.phone;
const sidebarImage: string = ((siteConfig as any).sidebarImage ?? '').trim();
const hasSidebarImage = sidebarImage.length > 0;

const showCategories = categories.length > 0;
const showCta = true;
const showTrust = signals.length > 0;

const reviewRating = (siteConfig as any).reviewRating;
const reviewCount = (siteConfig as any).reviewCount;
const reviewPlatform = ((siteConfig as any).reviewPlatform || 'Google').trim();
const reviewPlatformUrl = ((siteConfig as any).reviewPlatformUrl ?? '').trim();
const hasReview = !!reviewRating && String(reviewRating).trim() !== '';

function formatCount(n: string | number): string {
  const num = Number(n);
  return isNaN(num) ? String(n) : num.toLocaleString('en-US');
}
const ratingDisplay = hasReview ? String(reviewRating).trim() : '';
const countDisplay = hasReview && reviewCount ? formatCount(reviewCount) : '';
---

<div class="sb-wrap">

  <!-- ① CTA card -->
  {showCta && (
    <div class="sb-card sb-cta-card" data-has-image={hasSidebarImage ? 'true' : undefined}>
      {hasSidebarImage && (
        <div class="sb-cta-bg" aria-hidden="true">
          <img
            src={sidebarImage}
            alt=""
            loading="lazy"
            decoding="async"
            style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;"
          />
          <div class="sb-cta-scrim"></div>
        </div>
      )}
      <div class="sb-cta-content">
        <p class="sb-eyebrow">Prefer to talk?</p>
        {showPhone && (
          <a href={`tel:${phoneDigits}`} class="sb-phone" aria-label={`Call ${siteConfig.name}`}>
            {formatPhone(siteConfig.phone)}
          </a>
        )}
        <a href="/contact" class="sb-cta-btn">Get in Touch</a>
      </div>
    </div>
  )}

  <!-- ② Browse Categories -->
  {showCategories && (
    <div class="sb-card sb-links-card">
      <p class="sb-block-heading">Browse Categories</p>
      <ul class="sb-link-list">
        {categories.map((cat) => (
          <li>
            <a
              href={`/category/${cat.slug}`}
              class:list={['sb-link', cat.slug === currentSlug ? 'sb-link--active' : '']}
            >
              <span>{cat.title}</span>
              <svg class="sb-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}

  <!-- ③ Category info card -->
  <div class="sb-card sb-info-card">
    <p class="sb-block-heading">Category Info</p>
    <div class="sb-info-row">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
      <span>{articleCount} {articleCount === 1 ? 'Article' : 'Articles'}</span>
    </div>
    {hasFaq && (
      <div class="sb-info-row">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
        <span>FAQ Available</span>
      </div>
    )}
  </div>

  <!-- ④ Trust badges -->
  {showTrust && (
    <div class="sb-card sb-trust-card sb-trust-mobile-hide" aria-label="Why choose us">
      {signals.slice(0, 4).map(({ icon, label }) => (
        <div class="sb-trust-item">
          <span class="sb-trust-icon" aria-hidden="true">
            <Fragment set:html={iconSvg(icon, 16)} />
          </span>
          <span class="sb-trust-label">{label}</span>
        </div>
      ))}
    </div>
  )}

  <!-- ⑤ Review card -->
  {hasReview && (
    <div class="sb-card sb-review-card sb-trust-mobile-hide" aria-label="Customer reviews">
      <div class="sb-rv-stars" aria-label={`${ratingDisplay} out of 5 stars`}>
        {Array.from({ length: 5 }).map(() => (
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="var(--rs-star)" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        ))}
      </div>
      <div class="sb-rv-header">
        <span class="sb-rv-rating">{ratingDisplay}</span>
        <span class="sb-rv-platform">{reviewPlatform} Rating</span>
      </div>
      {countDisplay && <p class="sb-rv-count">Based on {countDisplay} reviews</p>}
    </div>
  )}

</div>

<style>
  .sb-wrap { display: flex; flex-direction: column; gap: 1rem; }
  .sb-card { border-radius: var(--radius-md, 12px); overflow: hidden; }

  /* CTA card */
  .sb-cta-card {
    position: relative;
    background: var(--rs-brand-subtle);
    border: 1px solid var(--rs-brand-tint-border);
    display: flex; flex-direction: column;
  }
  .sb-cta-card[data-has-image] { background: none; border-color: transparent; }
  .sb-cta-bg { position: absolute; inset: 0; z-index: 0; border-radius: inherit; overflow: hidden; }
  .sb-cta-scrim { position: absolute; inset: 0; background: rgba(0,0,0,0.6); z-index: 1; }
  .sb-cta-content { position: relative; z-index: 2; padding: 1.5rem; display: flex; flex-direction: column; gap: 0.875rem; }
  .sb-cta-card[data-has-image] .sb-eyebrow { color: rgba(255,255,255,0.75); }
  .sb-cta-card[data-has-image] .sb-phone { color: #fff; }
  .sb-eyebrow { font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; color: var(--rs-text-muted); margin: 0; line-height: 1; }
  .sb-phone { display: block; font-size: 1.625rem; font-weight: 800; line-height: 1.1; color: var(--rs-brand-text); text-decoration: none; letter-spacing: -0.02em; transition: opacity 0.15s ease; }
  .sb-phone:hover { opacity: 0.75; }
  .sb-cta-btn {
    display: flex; align-items: center; justify-content: center;
    min-height: 44px; padding: 0.625rem 1rem;
    border-radius: var(--radius-md, 8px);
    background: linear-gradient(135deg, var(--rs-accent) 0%, color-mix(in srgb, var(--rs-accent) 78%, #fff) 100%);
    color: var(--rs-on-brand); font-size: 0.9375rem; font-weight: 700;
    text-decoration: none; text-align: center;
    box-shadow: 0 4px 14px color-mix(in srgb, var(--rs-accent) 28%, transparent);
    transition: opacity 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .sb-cta-btn:hover { opacity: 0.92; transform: translateY(-1px); box-shadow: 0 6px 20px color-mix(in srgb, var(--rs-accent) 40%, transparent); }
  .sb-cta-btn:active { transform: none; opacity: 1; }

  /* Info card */
  .sb-info-card { padding: 1.25rem 1.5rem; background: var(--rs-surface); border: 1px solid var(--rs-border); display: flex; flex-direction: column; gap: 0.625rem; }
  .sb-info-row { display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; color: var(--rs-text); font-weight: 500; }
  .sb-info-row svg { color: var(--rs-text-muted); flex-shrink: 0; }

  /* Links card */
  .sb-links-card { padding: 1.25rem 1.5rem; background: var(--rs-surface); border: 1px solid var(--rs-border); }
  .sb-block-heading { font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; color: var(--rs-text-muted); margin: 0 0 0.875rem; padding-bottom: 0.75rem; border-bottom: 2px solid color-mix(in srgb, var(--rs-accent) 18%, transparent); }
  .sb-link-list { list-style: none; margin: 0; padding: 0; }
  .sb-link-list li + li { border-top: 1px solid color-mix(in srgb, var(--rs-border) 70%, transparent); }
  .sb-link { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0.5625rem 0; font-size: 0.875rem; font-weight: 500; color: var(--rs-text); text-decoration: none; transition: color 0.15s ease, padding-left 0.15s ease; }
  .sb-link:hover { color: var(--rs-brand-text); padding-left: 0.25rem; }
  .sb-link--active { color: var(--rs-brand-text); font-weight: 600; }
  .sb-chevron { flex-shrink: 0; opacity: 0.35; transition: opacity 0.15s ease, transform 0.15s ease; }
  .sb-link:hover .sb-chevron { opacity: 1; transform: translateX(2px); }
  .sb-link--active .sb-chevron { opacity: 0.65; }

  /* Trust card */
  .sb-trust-card { padding: 1.25rem 1.5rem; background: var(--rs-surface); border: 1px solid var(--rs-border); display: flex; flex-direction: column; gap: 0.75rem; }
  @media (max-width: 1023px) { .sb-trust-mobile-hide { display: none; } }
  .sb-trust-item { display: flex; align-items: center; gap: 0.625rem; }
  .sb-trust-icon { flex-shrink: 0; color: var(--rs-brand-text); display: flex; align-items: center; }
  .sb-trust-label { font-size: 0.875rem; font-weight: 600; color: var(--rs-text); line-height: 1.3; }

  /* Review card */
  .sb-review-card { padding: 1.25rem 1.5rem; background: var(--rs-surface); border: 1px solid var(--rs-border); display: flex; flex-direction: column; gap: 0.375rem; }
  .sb-rv-stars { display: flex; gap: 0.125rem; margin-bottom: 0.25rem; }
  .sb-rv-header { display: flex; align-items: baseline; gap: 0.5rem; }
  .sb-rv-rating { font-size: 1.625rem; font-weight: 800; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; color: var(--rs-text); line-height: 1; }
  .sb-rv-platform { font-size: 0.8125rem; font-weight: 600; color: var(--rs-text-muted); }
  .sb-rv-count { font-size: 0.8125rem; color: var(--rs-text-muted); margin: 0; line-height: 1.4; }

  @media (prefers-reduced-motion: reduce) {
    .sb-link, .sb-phone, .sb-cta-btn, .sb-chevron { transition: none; }
    .sb-link:hover { padding-left: 0; }
    .sb-cta-btn:hover { transform: none; }
  }
</style>
