---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  schemas?: object[];
  schemaJsonld?: string;
}

const { title, description, ogImage, canonical, noindex, schemas, schemaJsonld } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  canonical={canonical}
  noindex={noindex}
  schemas={schemas}
  schemaJsonld={schemaJsonld}
>
  <main>
    <slot />
  </main>
</BaseLayout>
