---
import { ClientRouter } from 'astro:transitions';
import SeoHead from '../components/SeoHead.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import StickyActionBar from '../components/sections/StickyActionBar.astro';
import siteConfig from '../data/site-config.json';
import { getFontPreset } from '../lib/fonts.ts';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  schemas?: object[];
  schemaJsonld?: string;
}

const { title, description, ogImage, canonical, noindex, schemas = [], schemaJsonld } = Astro.props;

const brandColor = siteConfig.brandColor ?? '#2563eb';
// Skin: case-insensitive — Railway or the dashboard may write "Dark",
// "DARK", or "dark"; all must resolve correctly. Empty/missing falls
// back to "light", with darkMode:true as a secondary opt-in.
const rawSkin = (siteConfig.skin ?? '').trim().toLowerCase();
const skin: 'light' | 'dark' =
  rawSkin === 'dark'  ? 'dark'  :
  rawSkin === 'light' ? 'light' :
  siteConfig.darkMode ? 'dark'  : 'light';

// Font: resolve siteConfig.fontStyle to a preset that supplies the
// --rs-font-display / --rs-font-body CSS variables. Inter is the
// default and is self-hosted; other presets load from Google Fonts.
const fontPreset = getFontPreset(siteConfig.fontStyle);
const fontVars = `--rs-font-display: ${fontPreset.display}; --rs-font-body: ${fontPreset.body};`;
const isInterFont = !fontPreset.googleFontsUrl;
---

<!doctype html>
<html lang="en" data-skin={skin} style={`--rs-brand: ${brandColor}; ${fontVars}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {/* Self-hosted font preloads — only for the default Inter preset.
        Other presets load from Google Fonts via the stylesheet link below
        and don't need these local preloads. */}
    {isInterFont && (
      <>
        <link rel="preload" as="font" type="font/woff2" href="/fonts/space-grotesk-latin.woff2" crossorigin />
        <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin.woff2" crossorigin />
      </>
    )}
    {/* Google Fonts stylesheet — only for non-Inter presets. Inter is
        fully self-hosted, so no external request is made by default. */}
    {!isInterFont && (
      <link rel="stylesheet" href={fontPreset.googleFontsUrl} />
    )}
    <meta name="theme-color" content={siteConfig.brandColor} />
    <meta name="geo.region" content={siteConfig.state} />
    <meta name="geo.placename" content={siteConfig.city} />
    <ClientRouter />
    <SeoHead
      title={title}
      description={description}
      ogImage={ogImage}
      canonical={canonical}
      noindex={noindex}
    />
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    {schemaJsonld && (
      <script type="application/ld+json" set:html={schemaJsonld} />
    )}
    {siteConfig.headerScripts && (
      <Fragment set:html={siteConfig.headerScripts} />
    )}
  </head>
  <body>
    <Navigation />
    <slot />
    <Footer />
    <StickyActionBar />
    {siteConfig.footerScripts && (
      <Fragment set:html={siteConfig.footerScripts} />
    )}
  </body>
</html>
