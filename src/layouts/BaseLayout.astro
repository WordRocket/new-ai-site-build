---
import { ClientRouter } from 'astro:transitions';
import SeoHead from '../components/SeoHead.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import siteConfig from '../data/site-config.json';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  schemas?: object[];
  schemaJsonld?: string;
}

const { title, description, ogImage, canonical, noindex, schemas = [], schemaJsonld } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta name="theme-color" content={siteConfig.brandColor} />
    <meta name="geo.region" content={siteConfig.state} />
    <meta name="geo.placename" content={siteConfig.city} />
    <ClientRouter />
    <SeoHead
      title={title}
      description={description}
      ogImage={ogImage}
      canonical={canonical}
      noindex={noindex}
    />
    <meta property="og:image" content={ogImage ?? 'https://placeholder.com/og-default.svg'} />
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    {schemaJsonld && (
      <script type="application/ld+json" set:html={schemaJsonld} />
    )}
  </head>
  <body>
    <Navigation />
    <slot />
    <Footer />
    <script>
      const observer = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            observer.unobserve(e.target);
          }
        }),
        { threshold: 0.1 }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
