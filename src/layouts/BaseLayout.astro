---
import { ClientRouter } from 'astro:transitions';
import SeoHead from '../components/SeoHead.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import StickyActionBar from '../components/sections/StickyActionBar.astro';
import siteConfig from '../data/site-config.json';
import { resolveFont } from '../lib/fonts.ts';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  schemas?: object[];
  schemaJsonld?: string;
}

const { title, description, ogImage, canonical, noindex, schemas = [], schemaJsonld } = Astro.props;

const brandColor = siteConfig.brandColor ?? '#2563eb';
// Secondary + accent brand colors. Both fall back to the primary brand
// color when the publish payload doesn't include them, so existing sites
// render unchanged. Flow into --rs-brand-secondary / --rs-brand-accent so
// sections can reference them consistently alongside --rs-brand.
const brandColorSecondary = (siteConfig as any).brandColorSecondary ?? brandColor;
const brandColorAccent = (siteConfig as any).brandColorAccent ?? brandColor;
// Skin: case-insensitive — Railway or the dashboard may write "Dark",
// "DARK", or "dark"; all must resolve correctly. Empty/missing falls
// back to "light", with darkMode:true as a secondary opt-in.
const rawSkin = (siteConfig.skin ?? '').trim().toLowerCase();
const skin: 'light' | 'dark' =
  rawSkin === 'dark'  ? 'dark'  :
  rawSkin === 'light' ? 'light' :
  siteConfig.darkMode ? 'dark'  : 'light';

// Font: resolve the final font config. A custom uploaded font
// (customFontUrl) takes priority over any Google Fonts preset; both
// paths flow through the same --rs-font-display / --rs-font-body CSS
// variables so the choice applies everywhere the existing wiring does.
const font = resolveFont({
  fontStyle: siteConfig.fontStyle,
  customFontUrl: (siteConfig as any).customFontUrl,
  customFontFamilyName: (siteConfig as any).customFontFamilyName,
});
const fontVars = `--rs-font-display: ${font.display}; --rs-font-body: ${font.body};`;
const isInterFont = font.isInterFont;

// Uniform font mode: when true, the accent labels that are normally
// monospace (eyebrows, badges, stat labels, review pill) inherit the
// display font instead. Default false — missing/null stays monospace.
const uniformFontMode = (siteConfig as any).uniformFontMode === true;
---

<!doctype html>
<html lang="en" data-skin={skin} class:list={[uniformFontMode && 'uniform-fonts']} style={`--rs-brand: ${brandColor}; --rs-brand-secondary: ${brandColorSecondary}; --rs-brand-accent: ${brandColorAccent}; ${fontVars}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {/* Self-hosted font preloads — only for the default Inter preset.
        Other presets load from Google Fonts via the stylesheet link below
        and don't need these local preloads. */}
    {isInterFont && (
      <>
        <link rel="preload" as="font" type="font/woff2" href="/fonts/space-grotesk-latin.woff2" crossorigin />
        <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin.woff2" crossorigin />
      </>
    )}
    {/* Custom uploaded font — @font-face is emitted inline so it loads
        from the user-supplied URL. Takes priority over any preset. */}
    {font.hasCustomFont && (
      <style set:html={font.customFontFace} />
    )}
    {/* Google Fonts stylesheet — only for non-Inter presets with no
        custom font. Inter is fully self-hosted; custom fonts load via
        the @font-face block above. */}
    {!isInterFont && !font.hasCustomFont && (
      <link rel="stylesheet" href={font.googleFontsUrl} />
    )}
    <meta name="theme-color" content={siteConfig.brandColor} />
    <meta name="geo.region" content={siteConfig.state} />
    <meta name="geo.placename" content={siteConfig.city} />
    <ClientRouter />
    <SeoHead
      title={title}
      description={description}
      ogImage={ogImage}
      canonical={canonical}
      noindex={noindex}
    />
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    {schemaJsonld && (
      <script type="application/ld+json" set:html={schemaJsonld} />
    )}
    {siteConfig.headerScripts && (
      <Fragment set:html={siteConfig.headerScripts} />
    )}
  </head>
  <body>
    <Navigation />
    <slot />
    <Footer />
    <StickyActionBar />
    {siteConfig.footerScripts && (
      <Fragment set:html={siteConfig.footerScripts} />
    )}
  </body>
</html>
