---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig, { formatPhone, cleanTitle, resolveSiteImage } from '../lib/site-config';
import { getCollection, getEntry } from 'astro:content';
import { getPreset, interpolate } from '../lib/business-presets';
import Icon from '../components/Icon.astro';
import { iconSvg, getServiceIcon } from '../lib/icons';
import FeatureRow from '../components/sections/FeatureRow.astro';
import FeatureGrid from '../components/sections/FeatureGrid.astro';
import ProcessTimeline from '../components/sections/ProcessTimeline.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import { getFAQSchema } from '../lib/schema';
import LeadForm from '../components/LeadForm.astro';
import ServiceCard from '../components/ServiceCard.astro';
import SmartImage from '../components/SmartImage.astro';
import SectionBgImage from '../components/SectionBgImage.astro';
import ReviewBadge from '../components/ReviewBadge.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import { imgUrl, imgSrcset, variantsSrcset, type ImageVariants } from '../lib/image';
import PageBlockRenderer from '../components/PageBlockRenderer.astro';
import { getValidatedSchema, type PageSchemas } from '../lib/block-renderer';
import { TestimonialsMarquee, RoiCalculator } from '@ranksite/blocks';

const serviceEntries = await getCollection('services').catch(() => []);
const locationEntries = await getCollection('locations').catch(() => []);
const categoryEntries = await getCollection('categories').catch(() => []);
const publishedCategoryEntries = categoryEntries
  .filter((c) => c.data.published !== false)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
const allProjectEntries = await getCollection('projects').catch(() => []);
const featuredProjects = allProjectEntries
  .filter(p => p.data.published !== false && p.data.featured === true)
  .sort((a, b) => {
    if (a.data.date && b.data.date) return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
    if (a.data.date) return -1;
    if (b.data.date) return 1;
    return 0;
  })
  .slice(0, 3);
const extraCities = [...new Set(
  locationEntries
    .map(e => e.data.city?.trim())
    .filter(Boolean)
    .filter(c => c.toLowerCase() !== siteConfig.city.toLowerCase())
    .map(c => c)
)];

// Build grouped service areas for the split map section
type AreaEntry = { city: string; links: Array<{ label: string; slug: string }> };
const areaGroups: AreaEntry[] = [
  {
    city: siteConfig.city,
    links: locationEntries
      .filter(e => e.data.city?.trim().toLowerCase() === siteConfig.city.toLowerCase())
      .map(e => ({ label: cleanTitle((e.data as any).title ?? e.slug), slug: e.slug })),
  },
  ...extraCities.map(city => ({
    city,
    links: locationEntries
      .filter(e => e.data.city?.trim().toLowerCase() === city.toLowerCase())
      .map(e => ({ label: cleanTitle((e.data as any).title ?? e.slug), slug: e.slug })),
  })),
];
const areaMapQ = encodeURIComponent((siteConfig.address ? siteConfig.address + ', ' : '') + siteConfig.city + ' ' + siteConfig.state);
const areaMapSrc = `https://maps.google.com/maps?q=${areaMapQ}&output=embed&z=11`;
const homeEntry = await getEntry('pages', 'home').catch(() => null);
const hp = homeEntry?.data;

function stripMd(text: string): string {
  return text
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/\*\*([^*]+)\*\*/g, '$1')
    .replace(/\*([^*]+)\*/g, '$1')
    .replace(/^#{1,6}\s+/gm, '')
    .replace(/`([^`]+)`/g, '$1')
    .trim();
}

const nicheLabel = siteConfig.niche || 'professional service';
const phoneDigits = siteConfig.phone ? siteConfig.phone.replace(/\D/g, '') : '';
const primaryCta = siteConfig.phone ? `tel:${phoneDigits}` : '/contact';

const preset = getPreset((siteConfig as any).businessType || 'other');
const vars = { city: siteConfig.city, niche: nicheLabel };
const isLocalService = (siteConfig as any).businessType === 'local-service';

// Compute heroImage early so it can be used as the card image fallback below.
const heroImage = (hp?.heroImage || (siteConfig as any).heroImage || '') as string;
const heroImageVariants = (hp?.heroImageVariants ?? (siteConfig as any).heroImageVariants) as ImageVariants | undefined;
// Hero src for the LCP <img>; srcset is built from pre-generated variants when
// available, otherwise from CDN-generated responsive widths (640/960/1440/1920).
// AVIF is preferred (≈50% smaller than WebP); a WebP fallback is provided via
// <picture> for browsers without AVIF support.
const heroSrcAvif    = heroImage ? imgUrl(heroImage, { w: 1440, q: 72, fm: 'avif' }) : '';
const heroSrcWebp    = heroImage ? imgUrl(heroImage, { w: 1440, q: 72, fm: 'webp' }) : '';
const heroSrcsetAvif =
  heroImageVariants ? variantsSrcset(heroImageVariants)
  : heroImage ? imgSrcset(heroImage, [640, 960, 1440, 1920], { q: 72, fm: 'avif' })
  : '';
const heroSrcsetWebp =
  heroImageVariants ? ''
  : heroImage ? imgSrcset(heroImage, [640, 960, 1440, 1920], { q: 72, fm: 'webp' })
  : '';
// Keep heroSrc for backward compatibility (used as fallback <img src> inside <picture>)
const heroSrc = heroSrcWebp || heroSrcAvif;
const heroSrcset = heroSrcsetWebp || heroSrcsetAvif;

const placeholderServices = [
  {
    slug: null, num: '01',
    icon: iconSvg(getServiceIcon(nicheLabel), 22),
    title: `${nicheLabel.charAt(0).toUpperCase() + nicheLabel.slice(1)} Services`,
    description: `Professional ${nicheLabel} services tailored to your needs in ${siteConfig.city}, ${siteConfig.state}. Reliable results, every time.`,
    image: heroImage,
    imageVariants: heroImageVariants,
  },
  {
    slug: null, num: '02',
    icon: iconSvg('check-circle', 22),
    title: 'Free Estimates',
    description: `Honest, transparent quotes before any work begins — no surprises, no hidden fees. Call us to book your free assessment.`,
    image: heroImage,
    imageVariants: heroImageVariants,
  },
  {
    slug: null, num: '03',
    icon: iconSvg('clock', 22),
    title: 'Fast Response',
    description: `We respect your time. Prompt scheduling and reliable arrival — when you need us, we show up prepared and ready.`,
    image: heroImage,
    imageVariants: heroImageVariants,
  },
];

const displayServices = serviceEntries.length > 0
  ? serviceEntries.map((e, i) => ({
      slug: e.slug,
      num: String(i + 1).padStart(2, '0'),
      icon: iconSvg(getServiceIcon(e.data.title), 22),
      title: cleanTitle(e.data.title),
      description: e.data.description ?? '',
      image: e.data.heroImage || e.data.sectionImage || heroImage,
      imageVariants: (e.data.heroImageVariants ?? e.data.sectionImageVariants ?? heroImageVariants) as ImageVariants | undefined,
    }))
  : placeholderServices;

const features = isLocalService ? [
  { title: 'Same-Day Service Available', desc: 'Urgent situations happen — we respond fast and show up when it matters most.', icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>` },
  { title: 'Licensed & Fully Insured',    desc: 'Full coverage for your peace of mind. We stand behind every job we do.',           icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>` },
  { title: 'Upfront Transparent Pricing', desc: 'Clear quotes before work begins — no hidden costs or surprises, ever.',           icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>` },
  { title: 'Satisfaction Guaranteed',    desc: "We don't consider the job done until you're completely happy with the results.",    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>` },
] : [
  { title: 'Thoughtful, Well-Crafted Work', desc: `Everything ${siteConfig.name} delivers is done with care, attention to detail, and real commitment.`, icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>` },
  { title: 'Reliable & Consistent',         desc: 'We communicate clearly and deliver on schedule, every time.',                       icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>` },
  { title: 'Direct, Honest Communication',  desc: 'No jargon or runaround — just straightforward answers and realistic expectations.', icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>` },
  { title: 'Built Around Your Needs',       desc: 'We tailor our approach to your goals and situation — not a one-size-fits-all template.', icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>` },
];

const defaultFaqs = isLocalService ? [
  { question: `What ${nicheLabel} services do you offer?`, answer: `${siteConfig.name} offers a full range of ${nicheLabel} services for residential and commercial clients in ${siteConfig.city}, ${siteConfig.state} and surrounding areas. Contact us to discuss your specific needs.` },
  { question: 'How do I get a free estimate?', answer: `Getting a free estimate is easy. ${siteConfig.phone ? `Call us at ${formatPhone(siteConfig.phone)} or fill` : 'Fill'} out our contact form and we'll get back to you within one business day to schedule an assessment at no cost.` },
  { question: 'Are you licensed and insured?', answer: `Yes. ${siteConfig.name} is fully licensed and insured. We carry comprehensive liability coverage so you're protected throughout every job.` },
  { question: 'What areas do you serve?', answer: `We primarily serve ${siteConfig.city}, ${siteConfig.state} and the surrounding area. Contact us to confirm service availability in your specific location.` },
  { question: 'How quickly can you respond?', answer: 'We aim to respond to all inquiries within one business day and can typically schedule an estimate within the week. For urgent situations, call us directly for faster scheduling.' },
] : [
  { question: `What does ${siteConfig.name} do?`, answer: `${siteConfig.name} creates ${nicheLabel || 'content'} and resources designed to inform, engage, and add value. Explore the site to learn more, or reach out with specific questions.` },
  { question: 'How can I get in touch?', answer: `Use our contact form or ${siteConfig.email ? `email us at ${siteConfig.email}` : 'reach out via the contact page'} and we'll respond within one business day.` },
  { question: 'Do you work with new audiences or clients?', answer: `Yes. We're always happy to explore new collaborations. ${siteConfig.phone ? `Call ${formatPhone(siteConfig.phone)} or ` : ''}send a message and we'll take it from there.` },
  { question: 'Where can I find your latest writing?', answer: 'The blog is updated regularly with new posts, guides, and updates. Bookmark the blog page or subscribe to stay current.' },
  { question: 'How quickly do you respond?', answer: 'We aim to respond to all inquiries within one business day. For time-sensitive matters, mention that in your message.' },
];
const faqs = (hp?.faq && hp.faq.length > 0) ? hp.faq : defaultFaqs;
const faqSchema = faqs.length > 0 ? getFAQSchema(faqs) : null;

const defaultFeatureGrid = isLocalService ? [
  { icon: 'clock',        title: 'Same-Day Service Available',  desc: 'Urgent situations happen — we respond fast and show up when it matters most.' },
  { icon: 'shield-check', title: 'Licensed & Fully Insured',    desc: 'Full coverage for your complete peace of mind. We stand behind every job we do.' },
  { icon: 'badge-check',  title: 'Upfront Transparent Pricing', desc: 'Clear quotes before work begins — no hidden costs or surprises, ever.' },
  { icon: 'star',         title: 'Satisfaction Guaranteed',      desc: "We don't consider the job done until you're completely happy with the results." },
  { icon: 'award',        title: 'Experienced Local Team',       desc: `Skilled professionals who know ${siteConfig.city} and the unique needs of this community.` },
  { icon: 'file-text',    title: 'Free Estimates',               desc: 'Honest, obligation-free quotes so you can make informed decisions without pressure.' },
] : [
  { icon: 'compass',        title: 'What We Do',                  desc: `${siteConfig.name} provides professional ${nicheLabel} services in ${siteConfig.city}, ${siteConfig.state}. We focus on delivering reliable results tailored to your needs.` },
  { icon: 'check-circle',   title: 'How We Work',                  desc: 'We start with a conversation, follow a clear plan, and deliver quality work on schedule — no guesswork, no surprises.' },
  { icon: 'message-square', title: 'Personalized Approach',        desc: 'Every project is different. We listen to your goals and tailor our work to fit your specific situation and budget.' },
  { icon: 'star',           title: 'Quality You Can Trust',        desc: "We stand behind everything we do. If something isn't right, we make it right — that's our commitment to you." },
  { icon: 'thumbs-up',      title: 'Local & Accessible',           desc: `Based in ${siteConfig.city}, we're easy to reach and quick to respond. Local service with a personal touch.` },
  { icon: 'sparkles',       title: 'Always Improving',             desc: 'We refine our approach based on feedback and experience, so the service you get today is better than yesterday.' },
];
const featureGridItems = (
  (hp?.featureGrid && hp.featureGrid.length > 0) ? hp.featureGrid :
  ((siteConfig as any).featureGrid?.length > 0) ? (siteConfig as any).featureGrid :
  defaultFeatureGrid
);

const defaultProcessSteps = isLocalService ? [
  { title: 'Book & Schedule',    desc: 'Reach us by phone or the contact form. We confirm your appointment quickly and work around your schedule.' },
  { title: 'On-Site Assessment', desc: 'Our team arrives on time, evaluates the job, and walks you through exactly what needs to be done and why.' },
  { title: 'Service Delivery',   desc: 'We carry out the work with care, using quality materials and proven techniques — no shortcuts, no guesswork.' },
  { title: 'Quality Check',      desc: 'Before we pack up, we inspect the finished work against our standards and address anything that needs attention.' },
  { title: 'Final Walkthrough',  desc: "We walk you through the completed job so you're fully satisfied and know exactly what was done." },
] : [
  { title: 'Reach Out',         desc: `Contact ${siteConfig.name} by phone, email, or our contact form. Tell us what you need and we'll listen.` },
  { title: 'We Plan Together',  desc: 'We discuss your goals, answer your questions, and outline a clear approach that fits your timeline and budget.' },
  { title: 'We Get to Work',    desc: 'Our team executes the plan with care and professionalism, keeping you informed throughout the process.' },
  { title: 'Review & Follow-Up', desc: 'We make sure everything meets your expectations and check in after the work is done to ensure you\'re satisfied.' },
];
const processStepsItems = (
  (hp?.processSteps && hp.processSteps.length > 0) ? hp.processSteps :
  ((siteConfig as any).processSteps?.length > 0) ? (siteConfig as any).processSteps :
  defaultProcessSteps
);
const processHeadingText = hp?.processHeading || (siteConfig as any).processHeading || preset.processHeading;

const hasTestimonial = !!(siteConfig as any).testimonial_text;
const testimonialText   = (siteConfig as any).testimonial_text   ?? '';
const testimonialAuthor = (siteConfig as any).testimonial_author ?? 'Happy Customer';
const testimonialNeighborhood = (siteConfig as any).testimonial_neighborhood ?? siteConfig.city;

const statsItems = [
  siteConfig.yearsInBusiness ? { value: `${siteConfig.yearsInBusiness}+`, label: 'Years Experience' } : { value: '100%', label: 'Satisfaction Guaranteed' },
  { value: 'Licensed', label: '& Insured' },
  { value: 'Free', label: 'Estimates' },
  { value: siteConfig.city, label: 'Local & Trusted' },
];

// Hero headline: gradient accent on the last word of the business name
const nameParts = siteConfig.name.trim().split(/\s+/);
const heroNameLast = nameParts[nameParts.length - 1];
const heroNameMain = nameParts.length > 1 ? nameParts.slice(0, -1).join(' ') : '';

const formEndpoint: string = ((siteConfig as any).formEndpoint ?? '').trim();
const formConnected = formEndpoint !== '';
const ctaImage: string = ((siteConfig as any).ctaImage ?? '').trim();
const ctaImageVariants = (siteConfig as any).ctaImageVariants as ImageVariants | undefined;
const hasCtaImage = ctaImage.length > 0;
const faqBg = resolveSiteImage(
  ['faqImage', 'faq_image', 'faqBackground', 'faqBackgroundImage', 'faqSectionImage'],
  ['faqImageVariants', 'faq_image_variants', 'faqBackgroundVariants', 'faqBackgroundImageVariants', 'faqSectionImageVariants'],
);
const faqBgImage = faqBg.src;
const faqBgVariants = faqBg.variants;
const hasFaqBgImage = faqBgImage.length > 0;
const hasHeroImage = !!heroImage;

function splitH(h: string): { main: string; last: string } {
  const words = h.trim().split(/\s+/);
  if (words.length === 1) return { main: '', last: words[0] };
  return { main: words.slice(0, -1).join(' ') + ' ', last: words[words.length - 1] };
}

const servicesHeadingText = interpolate(preset.servicesHeading, vars);
const { main: svcMain, last: svcLast } = splitH(servicesHeadingText);
// Derive skin here (same logic as BaseLayout) so the hero template can set
// skin-aware attributes directly on elements — avoids relying on the
// [data-skin="dark"] CSS ancestor selector which can fail in Astro scoped CSS.
const skin: 'light' | 'dark' =
  (siteConfig as any).skin === 'dark'  ? 'dark'  :
  (siteConfig as any).skin === 'light' ? 'light' :
  (siteConfig as any).darkMode         ? 'dark'  : 'light';
const heroServiceOptions = serviceEntries.length > 0
  ? serviceEntries.map((e) => ({ value: e.slug, label: e.data.title }))
  : [{ value: 'general-inquiry', label: 'General Inquiry' }];

// Block-based rendering: if siteConfig includes a validated pageSchemas
// entry for the "home" page type, render blocks from @ranksite/blocks.
// Otherwise, fall through to the fixed template — zero behavior change.
const cfgPageSchemas = (siteConfig as any).pageSchemas as PageSchemas | undefined;
const blockSchema = getValidatedSchema(cfgPageSchemas, 'home');

// Build testimonials marquee rows from siteConfig.testimonials (array) or
// fall back to the single testimonial_text/author fields. Each row is an
// array of cards; the marquee component auto-duplicates rows shorter than 4.
type TestimonialCard = { quote: string; name: string; meta: string; initials: string };
function buildTestimonialRows(): TestimonialCard[][] {
  const explicit = (siteConfig as any).testimonials as any[] | undefined;
  const cards: TestimonialCard[] = [];
  if (explicit && explicit.length > 0) {
    for (const t of explicit) {
      const name = t.name || t.author || 'Happy Customer';
      cards.push({
        quote: t.quote || t.text || '',
        name,
        meta: t.meta || t.role || t.neighborhood || siteConfig.city || '',
        initials: t.initials || name.split(' ').map((w: string) => w[0]).slice(0, 2).join('').toUpperCase() || '★',
      });
    }
  } else if (hasTestimonial) {
    cards.push({
      quote: testimonialText,
      name: testimonialAuthor,
      meta: testimonialNeighborhood,
      initials: testimonialAuthor.split(' ').map((w: string) => w[0]).slice(0, 2).join('').toUpperCase() || '★',
    });
  }
  if (cards.length === 0) return [];
  // Split into 2 rows for a dual-track marquee
  const mid = Math.ceil(cards.length / 2);
  return [cards.slice(0, mid), cards.slice(mid)];
}
const testimonialRows = buildTestimonialRows();
const hasMarquee = testimonialRows.length > 0;

// Homepage section visibility — shown when real data exists; homepageSections can opt out.
const homepageSections = (siteConfig as any).homepageSections ?? {};
const showTestimonialsMarquee = homepageSections.testimonials !== false;

// ROI calculator: only render when the site has real roi* fields populated,
// so no fake placeholder numbers ever appear on a live site.
const hasRoiData = !!(
  (siteConfig as any).roiMonthlyLeads ??
  (siteConfig as any).roiCloseRate ??
  (siteConfig as any).roiAvgDealSize ??
  (siteConfig as any).roiMonthlyCost
);
const showRoiCalculator = homepageSections.roiCalculator !== false && hasRoiData;

const roiDefaults = {
  monthlyLeads: ((siteConfig as any).roiMonthlyLeads as number) ?? 50,
  closeRate: ((siteConfig as any).roiCloseRate as number) ?? 20,
  avgDealSize: ((siteConfig as any).roiAvgDealSize as number) ?? 2500,
  monthlyCost: ((siteConfig as any).roiMonthlyCost as number) ?? 2000,
};
---

<BaseLayout
  title={`${siteConfig.name} | ${siteConfig.tagline}`}
  description={siteConfig.description}
  schemas={faqSchema ? [faqSchema] : []}
>
<body class="homepage">

<main id="main">

{blockSchema ? (
  <PageBlockRenderer pageSchemas={cfgPageSchemas} pageType="home" />
) : (
<>

<!-- ─── HERO ─────────────────────────────────────────────────────────── -->
{!isLocalService ? (

<!-- ── HERO: general template (centered, text-over-image) ─────────── -->
<section class={`hero-general${hasHeroImage ? ' hero-general--img' : ''}`} aria-label="Hero" data-hero-skin={skin}>
  {hasHeroImage && (
    <picture>
      {heroSrcsetAvif && <source srcset={heroSrcsetAvif} sizes="100vw" type="image/avif" />}
      {heroSrcsetWebp && <source srcset={heroSrcsetWebp} sizes="100vw" type="image/webp" />}
      <img
        class="hero-general__bg"
        src={heroSrc}
        srcset={heroSrcset}
        sizes="100vw"
        alt=""
        role="presentation"
        aria-hidden="true"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="1440"
        height="900"
      />
    </picture>
  )}
  {hasHeroImage && <div class="hero-general__scrim" data-scrim-skin={skin} aria-hidden="true"></div>}
  <div class="hero-general__inner">
    <div class="hero-general__content">
      <p class="hero-general__tagline reveal">{nicheLabel}</p>
      <h1 class="hero-general__title reveal">
        {heroNameMain ? `${heroNameMain} ` : ''}<span class="u-gradient-text">{heroNameLast}</span>
      </h1>
      <p class="hero-general__subtitle reveal">{siteConfig.tagline}</p>
      <div class="hero-general__actions reveal">
        <a href={primaryCta} class="u-btn u-btn-primary">{preset.heroCta}</a>
        <a href="/about" class="u-btn u-btn-ghost">{preset.heroCtaSecondary} &rarr;</a>
      </div>
    </div>
  </div>
</section>

) : formConnected ? (

<!-- ── HERO: form variant (endpoint configured) ─────────────────────── -->
<section
  class={`hero-split hero-split--form u-glow-bg cinematic-hero${hasHeroImage ? ' cinematic-hero--img' : ''}`}
  style={!hasHeroImage ? 'background: linear-gradient(135deg, color-mix(in srgb, var(--rs-accent) 18%, var(--rs-bg)) 0%, var(--rs-bg) 100%);' : ''}
  data-hero-skin={skin}
  aria-label="Hero"
>

  {/* Full-bleed background image — LCP-optimised, decorative */}
  {hasHeroImage && (
    <picture>
      {heroSrcsetAvif && <source srcset={heroSrcsetAvif} sizes="100vw" type="image/avif" />}
      {heroSrcsetWebp && <source srcset={heroSrcsetWebp} sizes="100vw" type="image/webp" />}
      <img
        class="hero-cin-img"
        src={heroSrc}
        srcset={heroSrcset}
        sizes="100vw"
        alt=""
        role="presentation"
        aria-hidden="true"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="1440"
        height="900"
      />
    </picture>
  )}
  {/* Skin-aware scrim: left→right gradient keeps text legible over any photo */}
  <div class="hero-cin-scrim" data-scrim-skin={skin} aria-hidden="true"></div>

  <!-- Left: text (unchanged) -->
  <div class="hero-left-panel flex flex-col justify-start px-6 sm:px-10 lg:px-10 pt-14 pb-12 relative z-10">

    <div class="mb-6">
      <span class="u-badge">
        <span class="u-badge__dot" aria-hidden="true"></span>
