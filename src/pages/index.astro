        Contact {siteConfig.name} today for a free estimate. {preset.contactSubtext}
      </p>
      {siteConfig.phone
        ? (
          <a href={`tel:${phoneDigits}`} class="btn-primary justify-center sm:justify-start font-bold text-lg px-8 py-4 rounded-[var(--radius-md)] w-full sm:w-auto">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.36a2 2 0 0 1 1.99-2.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.06 6.06l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            {formatPhone(siteConfig.phone)}
          </a>
        ) : (
          <a href="/contact" class="btn-primary justify-center sm:justify-start font-bold text-lg px-8 py-4 rounded-[var(--radius-md)] w-full sm:w-auto">
            {preset.contactCta}
          </a>
        )
      }
      {siteConfig.email && (
        <a href={`mailto:${siteConfig.email}`} class="text-sm font-medium transition-colors hover:opacity-80 hp-cta-sub">{siteConfig.email}</a>
      )}
    </div>

    <!-- Right: contact info panel -->
    <div class="hp-cta-right">
      <div class="flex flex-col gap-5 w-full max-w-xs">
        {siteConfig.address && (
          <div class="flex items-start gap-3">
            <span class="hp-cta-icon-badge flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider mb-0.5 hp-cta-label">Address</p>
              <p class="text-sm hp-cta-value">{siteConfig.address}, {siteConfig.city}, {siteConfig.state}</p>
            </div>
          </div>
        )}
        {siteConfig.phone && (
          <div class="flex items-start gap-3">
            <span class="hp-cta-icon-badge flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.36a2 2 0 0 1 1.99-2.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.06 6.06l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </span>
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider mb-0.5 hp-cta-label">Phone</p>
              <a href={`tel:${phoneDigits}`} class="text-sm hp-cta-value hover:opacity-80 transition-opacity">{siteConfig.phone}</a>
            </div>
          </div>
        )}
        {siteConfig.email && (
          <div class="flex items-start gap-3">
            <span class="hp-cta-icon-badge flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </span>
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider mb-0.5 hp-cta-label">Email</p>
              <a href={`mailto:${siteConfig.email}`} class="text-sm hp-cta-value hover:opacity-80 transition-opacity">{siteConfig.email}</a>
            </div>
          </div>
        )}
      </div>
    </div>

  </div>
</section>
</>
) : (
<!-- ─── CTA — centered card (general sites) ──────────────────────────── -->
<section class="gen-cta-card section-pad" aria-labelledby="cta-heading">
  <div class="gen-cta-card__inner u-reveal">
    <h2 id="cta-heading" class="gen-cta-card__heading">
      Let's <span class="u-gradient-text">Connect.</span>
    </h2>
    <p class="gen-cta-card__sub">{preset.contactSubtext}</p>
    <div class="gen-cta-card__btns">
      <a href="/contact" class="u-btn u-btn-primary gen-cta-card__primary">
        {preset.contactCta}
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      {siteConfig.phone && (
        <a href={`tel:${phoneDigits}`} class="u-btn u-btn-ghost">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.36a2 2 0 0 1 1.99-2.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.06 6.06l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          {formatPhone(siteConfig.phone)}
        </a>
      )}
    </div>
  </div>
</section>
)}


</>
)}

</main>
</body>
</BaseLayout>

<style>
  /* Pull the hero flush against the fixed nav by cancelling the spacer div.
     The spacer is 100px (top-bar 36px + nav 64px) when the top-bar is shown,
     64px when it is hidden. We use -100px as the worst-case safe value; on
     sites without a top-bar the hero simply starts 36px earlier (fine).     */
  .hero-split {
    margin-top: -100px;
  }
  .hero-general--ls {
    margin-top: -100px;
  }

  /* ── Local-service centered hero (no contact form) ───────────────────────
     Reuses the .hero-general shell but is taller (near full viewport) so the
     local-service hero keeps its commanding presence without the form column.
     Content is centered and trust signals sit below the CTAs in a pill row. */
  .hero-general--ls {
    min-height: calc(100vh - 120px);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-general--ls .hero-general__inner {
    width: 100%;
    padding-top: 4rem;
    padding-bottom: 4rem;
  }
  @media (min-width: 1024px) {
    .hero-general--ls .hero-general__inner {
      padding-top: 5rem;
      padding-bottom: 6rem;
    }
  }
  /* No-image fallback: branded tinted gradient instead of flat bg */
  .hero-general--ls:not(.hero-general--img) {
    background: linear-gradient(135deg,
      color-mix(in srgb, var(--rs-accent) 16%, var(--rs-bg)) 0%,
      var(--rs-bg) 100%);
  }

  .hero-ls-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  .hero-ls-content .hero-general__tagline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hero-ls-badge { margin: 0.25rem 0 0.25rem; }

  .hero-ls-trust { justify-content: center; }

  /* Trust signal pills — centered responsive row */
  .hero-ls-signals {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
  .hero-ls-signal {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.4rem 0.9rem;
    border-radius: var(--rs-radius-pill, 999px);
    background: color-mix(in srgb, var(--rs-bg) 72%, transparent);
    border: 1px solid var(--rs-border);
    color: var(--rs-text-muted);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .hero-ls-signal__icon { color: var(--rs-brand-text); flex-shrink: 0; }

  /* Dark skin image mode: brighter muted text + readable pills */
  .hero-general--ls[data-hero-skin="dark"].hero-general--img .hero-ls-content {
    --rs-text-muted: rgba(246,248,253,.82);
    --rs-border: rgba(255,255,255,.18);
  }
  .hero-general--ls[data-hero-skin="dark"].hero-general--img .hero-ls-signal {
    background: rgba(255,255,255,.08);
    color: rgba(246,248,253,.88);
  }
  .hero-general--ls[data-hero-skin="dark"].hero-general--img .trust-cluster__text {
    color: rgba(246,248,253,.78);
  }
  .hero-general--ls[data-hero-skin="dark"].hero-general--img .hero-ls-content h1,
  .hero-general--ls[data-hero-skin="dark"].hero-general--img .hero-ls-content p,
  .hero-general--ls[data-hero-skin="dark"].hero-general--img .hero-ls-content .hero-ls-signal,
  .hero-general--ls[data-hero-skin="dark"].hero-general--img .trust-cluster__count,
  .hero-general--ls[data-hero-skin="dark"].hero-general--img .trust-cluster__text {
    text-shadow: 0 2px 16px rgba(0,0,0,.48);
  }

  /* ── Cinematic hero — full-bleed background image treatment ─────────────

     LAYER ORDER (bottom → top):
       section bg-color  — transparent; fallback via inline style when no photo
       .hero-cin-img     z-index 0  — absolute, inset:0, full cover
       .hero-cin-scrim   z-index 1  — absolute, left→right gradient overlay
       content columns   z-index 2  — relative, text + form/graphic on top

     CRITICAL: .cinematic-hero MUST have background:transparent so the
     hero-split base background-color does not show through the photo.
     .cinematic-hero .hero-form-panel MUST have background:transparent so the
     global navy panel gradient does not block the right half of the image.
     ─────────────────────────────────────────────────────────────────────── */

  .cinematic-hero {
    overflow: hidden;
    position: relative;          /* belt-and-suspenders; u-glow-bg also sets this */
    isolation: isolate;
    /* Must override hero-split { background-color: var(--rs-bg) } */
    background-color: transparent;
  }

  /* ── Layer 1: background image — full section, below everything ────── */
  .hero-cin-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* ── Layer 2: skin-aware scrim — left opaque → right transparent ───── *
   *  Dark skin:  dense dark left cover, photo shows on the right.         *
   *  Light skin: dense light left cover, photo shows on the right.        *
   *  DEFAULT is light (matches data-skin="" / no skin set).               */
  .hero-cin-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      100deg,
      rgba(246,248,253,.97) 0%,
      rgba(246,248,253,.82) 38%,
      rgba(246,248,253,.18) 100%
    );
  }
  .hero-cin-scrim[data-scrim-skin="dark"] {
    background: linear-gradient(
      100deg,
      rgba(8,12,26,.96) 0%,
      rgba(8,12,26,.74) 42%,
      rgba(8,12,26,.24) 100%
    );
  }

  /* ── Layer 3: content columns above scrim ────────────────────────────── */
  .cinematic-hero .hero-left-panel,
  .cinematic-hero .hero-form-panel,
  .cinematic-hero .hero-right {
    position: relative;
    z-index: 2;
  }

  @media (min-width: 901px) {
    .cinematic-hero .hero-left-panel {
      grid-column: 1;
      grid-row: 1;
    }
    .cinematic-hero .hero-form-panel {
      grid-column: 2;
      grid-row: 1;
    }
  }

  /* THE CRITICAL FIX: strip the global navy panel behind the form.
     The card (.hero-form-card) keeps its own solid bg; only the column
     WRAPPER that was blocking the right half of the photo is cleared.     */
  .cinematic-hero .hero-form-panel {
    background: transparent;
    border-left: none;
  }

  /* ── Form card: strong floating shadow so it lifts off the photo ─────── */
  .cinematic-hero .hero-form-card {
    box-shadow:
      0 2px 8px rgba(15,20,40,.14),
      0 26px 60px -18px rgba(15,20,40,.42);
  }
  .cinematic-hero[data-hero-skin="dark"] .hero-form-card {
    box-shadow:
      0 0 0 1px rgba(255,255,255,.09),
      0 26px 60px -18px rgba(0,0,0,.62);
  }

  /* ── Dark skin: local token overrides for cinematic context ────────────
     --rs-text-muted in dark skin is #97a3b6 (mid-gray), designed for dark
     UI surfaces, not photos. In cinematic mode the left column sits over a
     dark scrim, so we need a brighter muted value. Overriding the custom
     property here cascades automatically to every inline style="color:var(
     --rs-text-muted)" descendant — no !important, no HTML changes needed.
     --rs-border gets the same treatment: the default rgba(255,255,255,.08)
     is nearly invisible over the scrim; .18 gives the stats divider weight. */
  .cinematic-hero[data-hero-skin="dark"] .hero-left-panel {
    --rs-text-muted: rgba(246,248,253,.80);
    --rs-border:     rgba(255,255,255,.18);
  }

  /* Trust cluster copy: color comes from scoped CSS (not inline style),
     so it needs its own explicit override to pick up the brighter value.   */
  .cinematic-hero[data-hero-skin="dark"] .trust-cluster__text {
    color: rgba(246,248,253,.78);
  }

  /* ── Dark skin: text-shadow — extended to all left-column text ─────────
     Badge, cluster count/text, and icon labels added alongside h1/p/ul.   *
   * No text-shadow in light skin — scrim opacity is sufficient.           */
  .cinematic-hero[data-hero-skin="dark"] .hero-left-panel h1,
  .cinematic-hero[data-hero-skin="dark"] .hero-left-panel p,
  .cinematic-hero[data-hero-skin="dark"] .hero-left-panel ul,
  .cinematic-hero[data-hero-skin="dark"] .hero-left-panel .u-badge,
  .cinematic-hero[data-hero-skin="dark"] .trust-cluster__count,
  .cinematic-hero[data-hero-skin="dark"] .trust-cluster__text {
    text-shadow: 0 2px 16px rgba(0,0,0,.48);
  }

  /* ── Non-form variant: hero-right is always transparent in cinematic ──── *
   * The solid brand-gradient right panel would block the photo.            *
   * Floating cards (.hero-float-card) keep their own backgrounds.          */
  .cinematic-hero .hero-right {
    background: transparent;
  }
  .cinematic-hero .hero-right-pattern,
  .cinematic-hero .hero-right-icon {
    display: none;
  }

  /* ── Mobile (≤900px): stronger full scrim — single-column stacked ──────
     Targets both .hero-split and .hero-split--form (global already resets
     the grid to 1fr at this breakpoint; this only overrides the scrim).    */
  @media (max-width: 900px) {
    .hero-cin-scrim {
      background: linear-gradient(
        180deg,
        rgba(246,248,253,.97) 0%,
        rgba(246,248,253,.94) 100%
      );
    }
    .hero-cin-scrim[data-scrim-skin="dark"] {
      background: linear-gradient(
        180deg,
        rgba(8,12,26,.94) 0%,
        rgba(8,12,26,.91) 100%
      );
    }
    .hero-general--ls { min-height: auto; }
  }

  /* ── Avatar trust cluster ────────────────────────────────────────────── */
  .trust-cluster {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .trust-cluster__avatars {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .trust-avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    /* --rs-bg border creates the overlap gap that adapts to both skins */
    border: 2.5px solid var(--rs-bg, #ffffff);
    display: flex;
    align-items: center;
    justify-content: center;
    /* icon always adapts to brand fill */
    color: var(--rs-on-brand);
    flex-shrink: 0;
  }
  .trust-avatar + .trust-avatar { margin-left: -0.6rem; }

  /* Subtle shade variation so each circle reads as a distinct person */
  .ta-1 { background: var(--rs-brand); }
  .ta-2 { background: color-mix(in srgb, var(--rs-brand) 82%, #0f172a); }
  .ta-3 { background: color-mix(in srgb, var(--rs-brand) 66%, #0f172a); }
  .ta-4 { background: color-mix(in srgb, var(--rs-brand) 50%, #0f172a); }

  .trust-cluster__copy {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
  }

  .trust-cluster__count {
    font-size: 0.9375rem;
    font-weight: 800;
    line-height: 1.1;
    color: var(--rs-text, var(--color-text));
  }

  .trust-cluster__text {
    font-size: 0.75rem;
    line-height: 1.2;
    color: var(--rs-text-muted, var(--color-text-muted));
  }

  /* ── Service area split layout ──────────────────────────────────────── */
  .area-split-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .area-map-wrap {
    border-radius: var(--radius-lg);
    overflow: hidden;
    height: 400px;
    border: 1px solid var(--rs-border);
    box-shadow: var(--rs-shadow-card);
  }

  .area-city-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .area-city-item {
    padding: 1rem 0;
  }

  .area-city-item--border {
    border-bottom: 1px solid var(--rs-border);
  }

  .area-city-name {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--rs-text);
    margin: 0 0 0.5rem 0;
  }

  .area-service-links {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
  }

  .area-service-link {
    font-size: 0.8125rem;
    color: var(--rs-brand-text);
    text-decoration: none;
    transition: text-decoration-color 0.15s;
  }

  .area-service-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .area-split-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .area-map-wrap {
      height: 280px;
    }
  }

  /* ── END service area ────────────────────────────────────────────────── */

  /* ── Homepage CTA section — full-bleed, skin-reactive ───────────────── */

  /* Wave above the section: the wave path fill matches the section bg so
     there's no white gap between wave and full-bleed section edge. */
  .cta-wave-top {
    background: var(--color-dark-navy);
  }
  .cta-wave-top svg path {
    fill: var(--color-dark-navy);
  }
  [data-skin="light"] .cta-wave-top svg path {
    fill: var(--rs-surface-2);
  }

  /* The section itself IS the full-bleed background — no wrapper card */
  .hp-cta-section {
    position: relative;
    overflow: hidden;
    padding: 80px 0;
    /* No-image fallback: dark navy (matches original card) */
    background: var(--color-dark-navy);
  }
  [data-skin="light"] .hp-cta-section {
    background: var(--rs-surface-2);
  }

  /* Image mode: suppress flat bg so photo+scrim take over */
  .hp-cta-section[data-bg="image"],
  [data-skin="light"] .hp-cta-section[data-bg="image"] {
    background: transparent;
  }

  /* Inner: centered max-width content grid — background stays full-bleed */
  .hp-cta-inner {
    position: relative;
    z-index: 2;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .hp-cta-inner {
      grid-template-columns: 1fr 1fr;
      gap: 0;
      padding: 0 2rem;
    }
  }

  /* Left column */
  .hp-cta-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
    padding: 0;
  }
  @media (min-width: 1024px) {
    .hp-cta-left { padding: 2rem 4rem 2rem 2rem; }
  }

  /* Right column */
  .hp-cta-right {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }
  @media (min-width: 1024px) {
    .hp-cta-right {
      padding: 2rem 2rem 2rem 4rem;
      border-left: 1px solid rgba(255,255,255,0.10);
    }
  }
  [data-skin="light"] .hp-cta-right {
    border-left-color: var(--rs-border);
  }

  /* Text colors — dark default */
  .hp-cta-heading { color: #ffffff; font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.02em; margin: 0; }
  .hp-cta-sub     { color: #94a3b8; margin: 0; }
  .hp-cta-label   { color: #475569; }
  .hp-cta-value   { color: #ffffff; }

  /* Light skin — no image */
  [data-skin="light"] .hp-cta-heading { color: var(--rs-text); }
  [data-skin="light"] .hp-cta-sub     { color: var(--rs-text-muted); }
  [data-skin="light"] .hp-cta-label   { color: var(--rs-text-muted); }
  [data-skin="light"] .hp-cta-value   { color: var(--rs-text); }

  /* Image mode: force white text on both skins (scrim ensures legibility) */
  .hp-cta-section[data-bg="image"] .hp-cta-heading { color: #ffffff; }
  .hp-cta-section[data-bg="image"] .hp-cta-sub     { color: rgba(255,255,255,0.82); }
  .hp-cta-section[data-bg="image"] .hp-cta-label   { color: rgba(255,255,255,0.55); }
  .hp-cta-section[data-bg="image"] .hp-cta-value   { color: #ffffff; }

