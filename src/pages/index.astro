<style>
  /* Pull the hero flush against the fixed nav by cancelling the spacer div.
     The spacer is 100px (top-bar 36px + nav 64px) when the top-bar is shown,
     64px when it is hidden. We use -100px as the worst-case safe value; on
     sites without a top-bar the hero simply starts 36px earlier (fine).     */
  .hero-split {
    margin-top: -100px;
  }

  /* ── Cinematic hero — full-bleed background image treatment ─────────────

     LAYER ORDER (bottom → top):
       section bg-color  — transparent; fallback via inline style when no photo
       .hero-cin-img     z-index 0  — absolute, inset:0, full cover
       .hero-cin-scrim   z-index 1  — absolute, left→right gradient overlay
       content columns   z-index 2  — relative, text + form/graphic on top

     CRITICAL: .cinematic-hero MUST have background:transparent so the
     hero-split base background-color does not show through the photo.
     .cinematic-hero .hero-form-panel MUST have background:transparent so the
     global navy panel gradient does not block the right half of the image.
     ─────────────────────────────────────────────────────────────────────── */

  .cinematic-hero {
    overflow: hidden;
    position: relative;          /* belt-and-suspenders; u-glow-bg also sets this */
    isolation: isolate;
    /* Must override hero-split { background-color: var(--rs-bg) } */
    background-color: transparent;
  }

  /* ── Layer 1: background image — full section, below everything ────── */
  .hero-cin-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* ── Layer 2: skin-aware scrim — left opaque → right transparent ───── *
   *  Dark skin:  dense dark left cover, photo shows on the right.         *
   *  Light skin: dense light left cover, photo shows on the right.        *
   *  DEFAULT is light (matches data-skin="" / no skin set).               */
  .hero-cin-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      100deg,
      rgba(246,248,253,.97) 0%,
      rgba(246,248,253,.82) 38%,
      rgba(246,248,253,.18) 100%
    );
  }
  .hero-cin-scrim[data-scrim-skin="dark"] {
    background: linear-gradient(
      100deg,
      rgba(8,12,26,.96) 0%,
      rgba(8,12,26,.74) 42%,
      rgba(8,12,26,.24) 100%
    );
  }

  /* ── Layer 3: content columns above scrim ────────────────────────────── */
  .cinematic-hero .hero-left-panel,
  .cinematic-hero .hero-form-panel,
  .cinematic-hero .hero-right {
    position: relative;
    z-index: 2;
  }

  /* THE CRITICAL FIX: strip the global navy panel behind the form.
     The card (.hero-form-card) keeps its own solid bg; only the column
     WRAPPER that was blocking the right half of the photo is cleared.     */
  .cinematic-hero .hero-form-panel {
    background: transparent;
    border-left: none;
  }

  /* ── Form card: strong floating shadow so it lifts off the photo ─────── */
  .cinematic-hero .hero-form-card {
    box-shadow:
      0 2px 8px rgba(15,20,40,.14),
      0 26px 60px -18px rgba(15,20,40,.42);
  }
  .cinematic-hero[data-hero-skin="dark"] .hero-form-card {
    box-shadow:
      0 0 0 1px rgba(255,255,255,.09),
      0 26px 60px -18px rgba(0,0,0,.62);
  }

  /* ── Dark skin: local token overrides for cinematic context ────────────
     --rs-text-muted in dark skin is #97a3b6 (mid-gray), designed for dark
     UI surfaces, not photos. In cinematic mode the left column sits over a
     dark scrim, so we need a brighter muted value. Overriding the custom
     property here cascades automatically to every inline style="color:var(
     --rs-text-muted)" descendant — no !important, no HTML changes needed.
     --rs-border gets the same treatment: the default rgba(255,255,255,.08)
     is nearly invisible over the scrim; .18 gives the stats divider weight. */
  .cinematic-hero[data-hero-skin="dark"] .hero-left-panel {
    --rs-text-muted: rgba(246,248,253,.80);
    --rs-border:     rgba(255,255,255,.18);
  }

  /* Trust cluster copy: color comes from scoped CSS (not inline style),
     so it needs its own explicit override to pick up the brighter value.   */
  .cinematic-hero[data-hero-skin="dark"] .trust-cluster__text {
    color: rgba(246,248,253,.78);
  }

  /* ── Dark skin: text-shadow — extended to all left-column text ─────────
     Badge, cluster count/text, and icon labels added alongside h1/p/ul.   *
   * No text-shadow in light skin — scrim opacity is sufficient.           */
  .cinematic-hero[data-hero-skin="dark"] .hero-left-panel h1,
  .cinematic-hero[data-hero-skin="dark"] .hero-left-panel p,
  .cinematic-hero[data-hero-skin="dark"] .hero-left-panel ul,
  .cinematic-hero[data-hero-skin="dark"] .hero-left-panel .u-badge,
  .cinematic-hero[data-hero-skin="dark"] .trust-cluster__count,
  .cinematic-hero[data-hero-skin="dark"] .trust-cluster__text {
    text-shadow: 0 2px 16px rgba(0,0,0,.48);
  }

  /* ── Non-form variant: hero-right is always transparent in cinematic ──── *
   * The solid brand-gradient right panel would block the photo.            *
   * Floating cards (.hero-float-card) keep their own backgrounds.          */
  .cinematic-hero .hero-right {
    background: transparent;
  }
  .cinematic-hero .hero-right-pattern,
  .cinematic-hero .hero-right-icon {
    display: none;
  }

  /* ── Mobile (≤900px): stronger full scrim — single-column stacked ──────
     Targets both .hero-split and .hero-split--form (global already resets
     the grid to 1fr at this breakpoint; this only overrides the scrim).    */
  @media (max-width: 900px) {
    .hero-cin-scrim {
      background: linear-gradient(
        180deg,
        rgba(246,248,253,.97) 0%,
        rgba(246,248,253,.94) 100%
      );
    }
    .hero-cin-scrim[data-scrim-skin="dark"] {
      background: linear-gradient(
        180deg,
        rgba(8,12,26,.94) 0%,
        rgba(8,12,26,.91) 100%
      );
    }
  }

  /* ── Avatar trust cluster ────────────────────────────────────────────── */
  .trust-cluster {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .trust-cluster__avatars {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .trust-avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    /* --rs-bg border creates the overlap gap that adapts to both skins */
    border: 2.5px solid var(--rs-bg, #ffffff);
    display: flex;
    align-items: center;
    justify-content: center;
    /* icon always adapts to brand fill */
    color: var(--rs-on-brand);
    flex-shrink: 0;
  }
  .trust-avatar + .trust-avatar { margin-left: -0.6rem; }

  /* Subtle shade variation so each circle reads as a distinct person */
  .ta-1 { background: var(--rs-brand); }
  .ta-2 { background: color-mix(in srgb, var(--rs-brand) 82%, #0f172a); }
  .ta-3 { background: color-mix(in srgb, var(--rs-brand) 66%, #0f172a); }
  .ta-4 { background: color-mix(in srgb, var(--rs-brand) 50%, #0f172a); }

  .trust-cluster__copy {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
  }

  .trust-cluster__count {
    font-size: 0.9375rem;
    font-weight: 800;
    line-height: 1.1;
    color: var(--rs-text, var(--color-text));
  }

  .trust-cluster__text {
    font-size: 0.75rem;
    line-height: 1.2;
    color: var(--rs-text-muted, var(--color-text-muted));
  }

  /* ── Service area split layout ──────────────────────────────────────── */
  .area-split-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .area-map-wrap {
    border-radius: var(--radius-lg);
    overflow: hidden;
    height: 400px;
    border: 1px solid var(--rs-border);
    box-shadow: var(--rs-shadow-card);
  }

  .area-city-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .area-city-item {
    padding: 1rem 0;
  }

  .area-city-item--border {
    border-bottom: 1px solid var(--rs-border);
  }

  .area-city-name {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--rs-text);
    margin: 0 0 0.5rem 0;
  }

  .area-service-links {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
  }

  .area-service-link {
    font-size: 0.8125rem;
    color: var(--rs-brand-text);
    text-decoration: none;
