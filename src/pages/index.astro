---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../lib/site-config';
import { getCollection } from 'astro:content';

const serviceEntries = await getCollection('services').catch(() => []);

const nicheLabel = siteConfig.niche || 'professional';

const placeholderServices = [
  {
    slug: null,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
    title: `${nicheLabel.charAt(0).toUpperCase() + nicheLabel.slice(1)} Services`,
    description: `Professional ${nicheLabel} services tailored to your needs in ${siteConfig.city}, ${siteConfig.state}.`,
  },
  {
    slug: null,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: 'Free Estimates',
    description: `We provide honest, transparent quotes before any work begins. No surprises, no hidden fees.`,
  },
  {
    slug: null,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>`,
    title: 'Fast Response',
    description: `We respect your time. Prompt scheduling and reliable arrival — when you need us, we're there.`,
  },
];

const displayServices = serviceEntries.length > 0
  ? serviceEntries.map((e) => ({
      slug: e.slug,
      icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
      title: e.data.title,
      description: e.data.description ?? '',
    }))
  : placeholderServices;

const trustItems = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
    stat: 'Locally Owned',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    stat: 'Licensed & Insured',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
    stat: 'Free Estimates',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
    stat: `${siteConfig.city}, ${siteConfig.state}`,
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
    stat: '5-Star Rated',
  },
];

const steps = [
  {
    number: '01',
    title: 'Local Experts',
    description: `We know ${siteConfig.city} and the surrounding area — our team lives and works here too.`,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
  },
  {
    number: '02',
    title: 'Licensed & Insured',
    description: 'Full coverage for your peace of mind. We stand behind every job we do.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  },
  {
    number: '03',
    title: 'Fast Response',
    description: 'We show up when you need us — on time, prepared, and ready to get the job done right.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>`,
  },
];

const features = [
  { title: 'Quality Workmanship', description: 'Every job is completed to the highest standard, the first time.' },
  { title: 'Transparent Pricing', description: 'Clear quotes before work begins — no hidden costs or surprises.' },
  { title: 'Licensed & Certified', description: 'Fully licensed, bonded, and insured for your protection.' },
  { title: 'Local & Trusted', description: `Serving ${siteConfig.city} and surrounding communities with pride.` },
  { title: 'Satisfaction Guaranteed', description: "We don't consider the job done until you're happy with the results." },
  { title: 'Emergency Services Available', description: 'Urgent situations happen — we\'re here when you need us most.' },
];

const faqs = [
  {
    question: `What ${nicheLabel} services do you offer?`,
    answer: `${siteConfig.name} offers a full range of ${nicheLabel} services for residential and commercial clients in ${siteConfig.city}, ${siteConfig.state} and surrounding areas. Contact us to discuss your specific needs.`,
  },
  {
    question: 'How do I get a free estimate?',
    answer: `Getting a free estimate is easy. Call us at ${siteConfig.phone} or fill out our contact form and we'll get back to you within one business day to schedule an assessment at no cost.`,
  },
  {
    question: 'Are you licensed and insured?',
    answer: `Yes. ${siteConfig.name} is fully licensed and insured. We carry comprehensive liability coverage so you're protected throughout every job.`,
  },
  {
    question: 'What areas do you serve?',
    answer: `We primarily serve ${siteConfig.city}, ${siteConfig.state} and the surrounding area. Contact us to confirm service availability in your specific location.`,
  },
  {
    question: 'How quickly can you respond?',
    answer: 'We aim to respond to all inquiries within one business day and can typically schedule an estimate within the week. For urgent situations, call us directly for faster scheduling.',
  },
];
---

<BaseLayout
  title={`${siteConfig.name} | ${siteConfig.tagline}`}
  description={siteConfig.description}
>
  <body class="homepage">

  <!-- ─── HERO ─────────────────────────────────────────────────────────── -->
  <section class="hero-section relative overflow-hidden">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-36 text-center relative z-10">
      <h1 class="hero-h1-gradient font-extrabold tracking-tight leading-[1.1] mb-6">
        {siteConfig.name}
      </h1>
      <p class="text-lg sm:text-xl text-[var(--color-text-muted)] max-w-2xl mx-auto mb-10 leading-relaxed">
        {siteConfig.tagline}
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/contact"
          class="btn-primary w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 rounded-lg text-base font-semibold text-white"
        >
          Get a Free Quote
        </a>
        <a
          href="/services"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-lg text-base font-semibold text-[var(--color-text)] border border-neutral-200 bg-white hover:bg-neutral-50 transition-colors"
        >
          Our Services
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ─── TRUST BAR ─────────────────────────────────────────────────────── -->
  <section style="background:#f4f4f5; border-top:1px solid #e4e4e7; border-bottom:1px solid #e4e4e7;">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-5">
      <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
        {trustItems.map(({ icon, stat }, i) => (
          <li class="flex items-center gap-2.5 text-sm font-medium text-[var(--color-text-muted)]">
            <span class="trust-icon text-[var(--color-brand)]" aria-hidden="true" style={`animation-delay:${i * 0.3}s`}>
              <Fragment set:html={icon} />
            </span>
            <span class="font-semibold text-[var(--color-text)]">{stat}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ─── SERVICES GRID ─────────────────────────────────────────────────── -->
  <section class="py-20 sm:py-[80px] bg-[var(--color-neutral-50)]">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="reveal text-[var(--color-text)] mb-4">
          Our Services
        </h2>
        <p class="text-[var(--color-text-muted)] text-lg max-w-2xl mx-auto">
          Professional {nicheLabel} services in {siteConfig.city}
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {displayServices.map(({ slug, icon, title, description }) => (
          <div class="reveal card-hover bg-white p-7 rounded-[var(--radius-md)] flex flex-col gap-4">
            <span class="inline-flex items-center justify-center w-11 h-11 rounded-lg text-[var(--color-brand)]" style="background:#eff6ff;">
              <Fragment set:html={icon} />
            </span>
            <h3 class="text-base font-semibold text-[var(--color-text)]">{title}</h3>
            <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{description}</p>
            {slug && (
              <a
                href={`/services/${slug}`}
                class="mt-auto text-sm font-semibold transition-colors hover:opacity-80"
                style="color:var(--color-brand);"
              >
                Learn More →
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- wave: neutral-50 → white -->
  <div class="wave-divider" style="background:var(--color-neutral-50);" aria-hidden="true">
    <svg viewBox="0 0 1440 48" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none"><path d="M0,24 C360,48 1080,0 1440,24 L1440,48 L0,48 Z" fill="white"/></svg>
  </div>

  <!-- ─── WHY CHOOSE US ─────────────────────────────────────────────────── -->
  <section id="how-it-works" class="py-20 sm:py-[80px] bg-white">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="reveal text-[var(--color-text)] mb-4">
          Why Choose {siteConfig.name}
        </h2>
        <p class="text-[var(--color-text-muted)] text-lg max-w-2xl mx-auto">
          Serving {siteConfig.city} with integrity and expertise.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
        <div class="hidden md:block absolute top-10 left-[calc(16.67%+1.5rem)] right-[calc(16.67%+1.5rem)] h-px" style="background: linear-gradient(90deg, transparent, #e4e4e7 20%, #e4e4e7 80%, transparent);"></div>
        {steps.map(({ number, title, description, icon }) => (
          <div class="reveal flex flex-col items-center text-center gap-4 relative">
            <div class="relative z-10 flex items-center justify-center w-20 h-20 rounded-full bg-white border-2 border-[var(--color-brand)] text-[var(--color-brand)]" style="box-shadow:var(--shadow-sm);">
              <Fragment set:html={icon} />
            </div>
            <span class="text-xs font-bold tracking-widest uppercase text-[var(--color-brand)] opacity-60">{number}</span>
            <h3 class="text-lg font-semibold text-[var(--color-text)]">{title}</h3>
            <p class="text-sm leading-relaxed text-[var(--color-text-muted)] max-w-xs">{description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- wave: white → neutral-50 -->
  <div class="wave-divider" style="background:white;" aria-hidden="true">
    <svg viewBox="0 0 1440 48" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none"><path d="M0,24 C360,0 1080,48 1440,24 L1440,48 L0,48 Z" fill="var(--color-neutral-50)"/></svg>
  </div>

  <!-- ─── OUR COMMITMENT ───────────────────────────────────────────────── -->
  <section class="py-20 sm:py-[80px] bg-[var(--color-neutral-50)]">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="reveal text-[var(--color-text)] mb-4">
          Our Commitment to You
        </h2>
        <p class="text-[var(--color-text-muted)] text-lg max-w-2xl mx-auto">
          Every decision we make is guided by your satisfaction.
        </p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <ul class="flex flex-col gap-5">
          {features.map(({ title, description }) => (
            <li class="reveal flex items-start gap-4">
              <span class="mt-0.5 flex-shrink-0 inline-flex items-center justify-center w-6 h-6 rounded-full text-white text-xs" style="background-color:var(--color-brand);">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <div>
                <span class="text-sm font-semibold text-[var(--color-text)]">{title}</span>
                <span class="text-sm text-[var(--color-text-muted)]"> — {description}</span>
              </div>
            </li>
          ))}
        </ul>
        <!-- Business card placeholder -->
        <div class="card-hover rounded-[var(--radius-lg)] overflow-hidden" style="box-shadow:var(--shadow-md);">
          <div class="flex items-center gap-1.5 px-4 py-3 border-b border-neutral-100" style="background:#f9fafb;">
            <span class="w-3 h-3 rounded-full bg-red-300"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-300"></span>
            <span class="w-3 h-3 rounded-full bg-green-300"></span>
            <span class="flex-1 mx-4 h-5 rounded-full bg-neutral-200 text-center text-[10px] leading-5 text-neutral-400 font-mono overflow-hidden">{siteConfig.name}</span>
          </div>
          <div class="bg-neutral-100 flex flex-col items-center justify-center gap-3 aspect-[4/3]">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#c4c4c8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
            <span class="text-sm font-medium text-neutral-400">{siteConfig.name}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- wave: neutral-50 → white -->
  <div class="wave-divider" style="background:var(--color-neutral-50);" aria-hidden="true">
    <svg viewBox="0 0 1440 48" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none"><path d="M0,24 C360,48 1080,0 1440,24 L1440,48 L0,48 Z" fill="white"/></svg>
  </div>

  <!-- ─── FAQ ──────────────────────────────────────────────────────────── -->
  <section id="faq" class="py-20 sm:py-[80px] bg-white">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="reveal text-[var(--color-text)] mb-4">
          Frequently Asked Questions About {nicheLabel} in {siteConfig.city}
        </h2>
        <p class="text-[var(--color-text-muted)] text-lg max-w-2xl mx-auto">
          Everything you need to know before getting started.
        </p>
      </div>
      <div class="max-w-3xl mx-auto flex flex-col divide-y divide-neutral-100" id="faq-list">
        {faqs.map(({ question, answer }, i) => (
          <div class="reveal faq-item py-5">
            <button
              type="button"
              class="faq-trigger w-full flex items-center justify-between gap-4 text-left text-base font-semibold text-[var(--color-text)] hover:text-[var(--color-brand)] transition-colors"
              aria-expanded="false"
              aria-controls={`faq-answer-${i}`}
              id={`faq-btn-${i}`}
            >
              <span>{question}</span>
              <svg class="faq-chevron flex-shrink-0 transition-transform duration-200" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div
              id={`faq-answer-${i}`}
              role="region"
              aria-labelledby={`faq-btn-${i}`}
              class="faq-answer overflow-hidden max-h-0 transition-[max-height] duration-300 ease-in-out"
            >
              <p class="pt-3 pb-1 text-sm leading-relaxed text-[var(--color-text-muted)]">{answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── CTA BANNER ───────────────────────────────────────────────────── -->
  <section style="background-color:var(--color-brand);" class="py-20 sm:py-[80px]">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="reveal font-bold tracking-tight text-white mb-4">
        Ready to Get Started?
      </h2>
      <p class="text-blue-100 text-lg max-w-xl mx-auto mb-10">
        Contact {siteConfig.name} today for a free estimate.
      </p>
      <a
        href={`tel:${siteConfig.phone.replace(/\D/g, '')}`}
        class="inline-flex items-center justify-center px-8 py-4 rounded-lg text-base font-semibold text-[var(--color-brand)] bg-white transition-all duration-200 hover:shadow-lg hover:-translate-y-0.5"
      >
        Call Us Now
      </a>
    </div>
  </section>

  </body>
</BaseLayout>

<script>
  const triggers = document.querySelectorAll<HTMLButtonElement>('.faq-trigger');

  triggers.forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const answerId = btn.getAttribute('aria-controls')!;
      const answer = document.getElementById(answerId)!;
      const chevron = btn.querySelector<SVGElement>('.faq-chevron')!;

      if (expanded) {
        btn.setAttribute('aria-expanded', 'false');
        answer.style.maxHeight = '0';
        chevron.style.transform = '';
      } else {
        triggers.forEach((other) => {
          if (other !== btn && other.getAttribute('aria-expanded') === 'true') {
            other.setAttribute('aria-expanded', 'false');
            const otherId = other.getAttribute('aria-controls')!;
            const otherAnswer = document.getElementById(otherId)!;
            const otherChevron = other.querySelector<SVGElement>('.faq-chevron')!;
            otherAnswer.style.maxHeight = '0';
            otherChevron.style.transform = '';
          }
        });

        btn.setAttribute('aria-expanded', 'true');
        answer.style.maxHeight = answer.scrollHeight + 'px';
        chevron.style.transform = 'rotate(180deg)';
      }
    });
  });
</script>
