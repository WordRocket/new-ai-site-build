---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AffiliateProductCard from '../components/AffiliateProductCard.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import siteConfig from '../lib/site-config';
import { getBreadcrumbSchema, getOrganizationSchema } from '../lib/schema';
import PageBlockRenderer from '../components/PageBlockRenderer.astro';
import { getValidatedSchema, type PageSchemas } from '../lib/block-renderer';

const affiliateEnabled = (siteConfig as any).affiliateLinksEnabled === true;

if (!affiliateEnabled) {
  return Astro.redirect('/404');
}

const products = (await getCollection('affiliateProducts').catch(() => []))
  .sort((a, b) => (a.data.priority ?? 100) - (b.data.priority ?? 100));

const siteUrl = (import.meta.env.SITE ?? siteConfig.url ?? 'https://example.com').replace(/\/+$/, '');
const pageUrl = `${siteUrl}/resources`;

const breadcrumbSchema = getBreadcrumbSchema([
  { name: 'Home', url: siteUrl },
  { name: 'Resources', url: pageUrl },
]);
const orgSchema = getOrganizationSchema({
  name: siteConfig.name,
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
});
const schemas: object[] = [breadcrumbSchema, orgSchema];

const hasProducts = products.length > 0;

const cfgPageSchemas = (siteConfig as any).pageSchemas as PageSchemas | undefined;
const blockSchema = getValidatedSchema(cfgPageSchemas, 'resources');
---

<BaseLayout
  title={`Resources | ${siteConfig.name}`}
  description={`Recommended products and tools from ${siteConfig.name}.`}
  canonical={pageUrl}
  schemas={schemas}
>
  <main>
{blockSchema ? (
  <PageBlockRenderer pageSchemas={cfgPageSchemas} pageType="resources" />
) : (
<>
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="border-b" style="background:var(--rs-surface); border-color:var(--rs-border);">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <ol class="flex items-center gap-2 text-sm text-[var(--color-text-muted)]">
          <li><a href="/" class="hover:text-[var(--rs-brand-text)] transition-colors">Home</a></li>
          <li aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </li>
          <li><span class="text-[var(--color-text)] font-medium" aria-current="page">Resources</span></li>
        </ol>
      </div>
    </nav>

    <!-- Header -->
    <section class="py-14 sm:py-20 text-center" style="background:var(--rs-surface-2);">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-[var(--color-text)] mb-4"><span class="u-gradient-text">Resources</span></h1>
        <p class="text-[var(--color-text-muted)] text-lg max-w-xl mx-auto">
          Recommended products and tools we trust.
        </p>
      </div>
    </section>

    <!-- Disclosure banner -->
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 pt-8">
      <AffiliateDisclosure />
    </div>

    <!-- Product grid -->
    <section class="py-12 sm:py-16">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
        {hasProducts ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {products.map((p) => (
              <AffiliateProductCard
                name={p.data.name}
                pitch={p.data.pitch}
                affiliateUrl={p.data.affiliateUrl}
                image={p.data.image}
                priceNote={p.data.priceNote}
                ctaLabel={p.data.ctaLabel}
              />
            ))}
          </div>
        ) : (
          <div class="flex flex-col items-center justify-center gap-4 py-24 text-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#d4d4d8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
            <p class="text-[var(--color-text-muted)] text-lg font-medium">No products yet</p>
            <p class="text-sm text-[var(--color-text-muted)]">Check back soon — we're curating our recommendations.</p>
          </div>
        )}
      </div>
    </section>

</>
)}
  </main>
</BaseLayout>
