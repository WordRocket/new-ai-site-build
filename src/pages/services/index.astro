---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const all = await getCollection('services');
const services = all.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Our Services | SiteName"
  description="Explore our full range of professional services designed to help your business grow online."
>
  <main>
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="border-b border-neutral-100" style="background:#fafafa;">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <ol class="flex items-center gap-2 text-sm text-[var(--color-text-muted)]">
          <li><a href="/" class="hover:text-[var(--color-brand)] transition-colors">Home</a></li>
          <li aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </li>
          <li><span class="text-[var(--color-text)] font-medium" aria-current="page">Services</span></li>
        </ol>
      </div>
    </nav>

    <!-- Header -->
    <section class="py-14 sm:py-20 text-center" style="background:var(--color-neutral-50, #f9fafb);">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-[var(--color-text)] mb-4">Our Services</h1>
        <p class="text-[var(--color-text-muted)] text-lg max-w-xl mx-auto">
          Professional services built to help your business rank, grow, and convert.
        </p>
      </div>
    </section>

    <!-- Service grid -->
    <section class="py-16 sm:py-20">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
        {services.length === 0 ? (
          <div class="flex flex-col items-center justify-center gap-4 py-24 text-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#d4d4d8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
            <p class="text-[var(--color-text-muted)] text-lg font-medium">Services coming soon</p>
            <p class="text-sm text-[var(--color-text-muted)]">We're putting together something great — check back shortly.</p>
          </div>
        ) : (
          <ul class="svc-grid" role="list">
            {services.map((service) => {
              const desc = service.data.shortDescription || service.data.description;
              const icon = service.data.icon;
              return (
                <li>
                  <article class="svc-card u-card">
                    <div class="svc-card__icon" aria-hidden="true">
                      {icon ? (
                        /* emoji / text icon */
                        <span class="svc-card__emoji">{icon}</span>
                      ) : (
                        /* default inline SVG */
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>
                      )}
                    </div>

                    <h2 class="svc-card__title">{service.data.title}</h2>

                    {desc && (
                      <p class="svc-card__desc">{desc}</p>
                    )}

                    <a
                      href={`/services/${service.slug}`}
                      class="svc-card__link"
                      aria-label={`Learn more about ${service.data.title}`}
                    >
                      Learn More
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                    </a>
                  </article>
                </li>
              );
            })}
          </ul>
        )}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .svc-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
    align-items: stretch;
  }
  @media (min-width: 640px) {
    .svc-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .svc-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .svc-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    height: 100%;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .svc-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px -4px rgba(0,0,0,.12), 0 4px 10px -2px rgba(0,0,0,.07);
  }
  @media (prefers-reduced-motion: reduce) {
    .svc-card { transition: box-shadow 0.2s ease; }
    .svc-card:hover { transform: none; }
  }

  .svc-card__icon {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: color-mix(in srgb, var(--color-brand) 10%, transparent);
    color: var(--color-brand);
  }

  .svc-card__emoji {
    font-size: 1.25rem;
    line-height: 1;
  }

  .svc-card__title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-text);
    margin: 0;
  }

  .svc-card__desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .svc-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-brand);
    transition: color 0.15s ease;
    margin-top: auto;
    padding-top: 0.5rem;
    text-decoration: none;
  }
  .svc-card__link:hover {
    color: var(--color-brand-dark, var(--color-brand));
  }
</style>
