---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { iconSvg, getServiceIcon } from '../../lib/icons';
import ServiceCard from '../../components/ServiceCard.astro';
import siteConfig, { cleanTitle } from '../../lib/site-config';
import { getPreset, interpolate } from '../../lib/business-presets';
import { isLocalSite } from '../../lib/siteMode';

const isLocalService = isLocalSite();

// General-type sites are blog-first and should not have a /services route.
// Redirect to 404 so the route effectively doesn't exist in the site tree.
if (!isLocalService) {
  return Astro.redirect('/404');
}

const preset = getPreset((siteConfig as any).businessType || 'other');
const vars = { city: siteConfig.city, niche: siteConfig.niche || 'services' };

const all = await getCollection('services').catch(() => []);
const services = all.sort((a, b) => a.data.order - b.data.order);

const servicesIntro: string = ((siteConfig as any).servicesIntro as string | undefined)?.trim() || '';
const servicesHeading = interpolate(preset.servicesHeading, vars);
const servicesDescription = servicesIntro ||
  `${siteConfig.name} provides professional ${(siteConfig as any).niche || 'services'} in ${siteConfig.city}, ${siteConfig.state}. Browse all available services below.`;
---

<BaseLayout
  title={`${servicesHeading} | ${siteConfig.name}`}
  description={servicesDescription}
>
  <main>
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="border-b" style="background:var(--rs-surface); border-color:var(--rs-border);">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <ol class="flex items-center gap-2 text-sm text-[var(--color-text-muted)]">
          <li><a href="/" class="hover:text-[var(--color-brand)] transition-colors">Home</a></li>
          <li aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </li>
          <li><span class="text-[var(--color-text)] font-medium" aria-current="page">Services</span></li>
        </ol>
      </div>
    </nav>

    <!-- Header -->
    <section class="py-14 sm:py-20 text-center" style="background:var(--rs-surface);">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-[var(--color-text)] mb-4">{servicesHeading}</h1>
        <p class="text-[var(--color-text-muted)] text-lg max-w-xl mx-auto">
          {servicesDescription}
        </p>
      </div>
    </section>

    <!-- Service grid -->
    <section class="py-16 sm:py-20">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
        {services.length === 0 ? (
          <div class="flex flex-col items-center justify-center gap-4 py-24 text-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#d4d4d8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
            <p class="text-[var(--color-text-muted)] text-lg font-medium">Services coming soon</p>
            <p class="text-sm text-[var(--color-text-muted)]">We're putting together something great — check back shortly.</p>
          </div>
        ) : (
          <ul class="svc-grid" role="list">
            {services.map((service) => {
              const desc = service.data.shortDescription || service.data.description;
              const image = service.data.heroImage || service.data.sectionImage;
              const icon = iconSvg(getServiceIcon(service.data.title), 22);
              return (
                <li>
                  <ServiceCard
                    title={cleanTitle(service.data.title)}
                    description={desc}
                    image={image}
                    href={`/services/${service.slug}`}
                    icon={icon}
                  />
                </li>
              );
            })}
          </ul>
        )}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .svc-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
    align-items: stretch;
  }
  @media (min-width: 640px) {
    .svc-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .svc-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
