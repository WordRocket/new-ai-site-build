---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, getCollection } from 'astro:content';
import { getBreadcrumbSchema } from '../lib/schema';
import siteConfig from '../lib/site-config';
import { getPreset } from '../lib/business-presets';
import LeadForm from '../components/LeadForm.astro';

const siteUrl = import.meta.env.SITE ?? siteConfig.url;
const pageUrl = `${siteUrl}/contact`;

const contactEntry = await getEntry('pages', 'contact').catch(() => null);
const cp = contactEntry?.data;

const serviceEntries = await getCollection('services').catch(() => []);
const serviceOptions = serviceEntries.length > 0
  ? serviceEntries.map((s) => ({ value: s.slug, label: s.data.title }))
  : [{ value: 'general-inquiry', label: 'General Inquiry' }];

const contactPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contact ${siteConfig.name}`,
  url: pageUrl,
  description: `Get in touch with ${siteConfig.name}. We respond to all inquiries within one business day.`,
  mainEntity: {
    '@type': 'Organization',
    name: siteConfig.name,
    url: siteUrl,
    telephone: siteConfig.phone,
    email: siteConfig.email,
    sameAs: [
      siteConfig.linkedinUrl,
      siteConfig.facebookUrl,
      siteConfig.twitterUrl,
    ].filter(Boolean),
    address: {
      '@type': 'PostalAddress',
      streetAddress: siteConfig.address,
      addressLocality: siteConfig.city,
      addressRegion: siteConfig.state,
      postalCode: siteConfig.zip,
      addressCountry: siteConfig.country,
    },
  },
};

const breadcrumbSchema = getBreadcrumbSchema([
  { name: 'Home', url: siteUrl },
  { name: 'Contact', url: pageUrl },
]);

const preset = getPreset((siteConfig as any).businessType || 'other');
const isLocalService = (siteConfig as any).businessType === 'local-service';

const openingHours: Array<{ days: string; hours: string }> = (siteConfig as any).openingHours || [];
const formEndpoint: string = ((siteConfig as any).formEndpoint ?? '').trim();
const formConnected = formEndpoint !== '';

const customEmbedHtml: string = ((cp as any)?.customEmbedHtml ?? '').trim();
const hideDefaultContactForm: boolean = !!(cp as any)?.hideDefaultContactForm;
const showLeadForm = formConnected && !hideDefaultContactForm;
const showCustomEmbed = customEmbedHtml !== '';

const mapQueryParts = [siteConfig.address, siteConfig.city, siteConfig.state, siteConfig.zip].filter(Boolean);
const mapQuery = mapQueryParts.length > 0 ? encodeURIComponent(mapQueryParts.join(', ')) : '';
const mapSrc = mapQuery ? `https://maps.google.com/maps?q=${mapQuery}&output=embed` : '';
---

<BaseLayout
  title={`Contact Us | ${siteConfig.name}`}
  description={`Contact ${siteConfig.name} in ${siteConfig.city}, ${siteConfig.state}. ${siteConfig.description}`}
  canonical={pageUrl}
  schemas={[contactPageSchema, breadcrumbSchema]}
>
  <main>
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="border-b" style="background:var(--rs-surface); border-color:var(--rs-border);">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <ol class="flex items-center gap-2 text-sm text-[var(--color-text-muted)]">
          <li><a href="/" class="hover:text-[var(--rs-brand-text)] transition-colors">Home</a></li>
          <li aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </li>
          <li><span class="text-[var(--color-text)] font-medium" aria-current="page">Contact</span></li>
        </ol>
      </div>
    </nav>

    <!-- Header -->
    <section class="py-14 sm:py-20 text-center" style="background:var(--rs-surface);">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-[var(--color-text)] mb-4">{cp?.title || 'Get In Touch'}</h1>
        <p class="text-[var(--color-text-muted)] text-lg max-w-xl mx-auto">
          {cp?.description || (preset.contactSubtext + ' We respond to all inquiries within one business day.')}
        </p>
      </div>
    </section>

    <!-- Two-column layout -->
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_400px] gap-12">

        <!-- Left: Contact form and/or custom embed -->
        <div class="flex flex-col gap-10">
          {showLeadForm && (
            <div>
              <h2 class="text-xl font-bold text-[var(--color-text)] mb-6">Send Us a Message</h2>
              <LeadForm
                formId="contact-form"
                endpoint={formEndpoint}
                siteName={siteConfig.name}
                serviceOptions={serviceOptions}
                submitLabel={preset.contactCta}
                phone={siteConfig.phone}
                email={siteConfig.email}
                compact={false}
              />
            </div>
          )}

          {showCustomEmbed && (
            <div class="contact-custom-embed" set:html={customEmbedHtml} />
          )}
        </div>

        <!-- Right: Business info -->
        <aside class="flex flex-col gap-6">
          <div class="p-6 rounded-[var(--radius-lg)] flex flex-col gap-5" style="background:var(--rs-surface); border:1px solid var(--rs-border);">
            <h2 class="text-lg font-bold text-[var(--color-text)]">Contact Information</h2>

            <address class="not-italic flex flex-col gap-4 text-sm text-[var(--color-text-muted)]">
              <div class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--rs-brand-text)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 flex-shrink-0" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                <div>
                  <p class="font-medium text-[var(--color-text)]">Office Address</p>
                  <p>{siteConfig.address}</p>
                  <p>{siteConfig.city}, {siteConfig.state} {siteConfig.zip}</p>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--rs-brand-text)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.5 12.72 19.79 19.79 0 0 1 1.08 4.1 2 2 0 0 1 3.05 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <a href={`tel:${siteConfig.phone.replace(/\D/g, '')}`} class="hover:text-[var(--rs-brand-text)] transition-colors">{siteConfig.phone}</a>
              </div>
              <div class="flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--rs-brand-text)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                <a href={`mailto:${siteConfig.email}`} class="hover:text-[var(--rs-brand-text)] transition-colors">{siteConfig.email}</a>
              </div>
            </address>

            {openingHours.length > 0 && (
            <div class="pt-4 border-t" style="border-color:var(--rs-border);">
              <p class="text-sm font-semibold text-[var(--color-text)] mb-3">Opening Hours</p>
              <ul class="flex flex-col gap-2">
                {openingHours.map((row) => (
                  <li class="flex justify-between text-sm">
                    <span class="text-[var(--color-text-muted)]">{row.days}</span>
                    <span class="font-medium text-[var(--color-text)]">{row.hours}</span>
                  </li>
                ))}
              </ul>
            </div>
            )}
          </div>

          {siteConfig.gbpUrl && (
            <a
              href={siteConfig.gbpUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-sm font-semibold transition-colors hover:opacity-80"
              style="color:var(--rs-brand-text);"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/><line x1="9" y1="3" x2="9" y2="18"/><line x1="15" y1="6" x2="15" y2="21"/></svg>
              View on Google Maps
            </a>
          )}
        </aside>

      </div>
    </div>

    <!-- Full-width map strip — local-service only -->
    {isLocalService && mapSrc && (
      <div class="contact-map-strip" aria-label="Service area map">
        <iframe
          src={mapSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          style="border:0; display:block; width:100%; height:100%;"
          title={`Map showing ${siteConfig.name} location`}
        ></iframe>
      </div>
    )}
  </main>
</BaseLayout>

<style>
  .contact-map-strip {
    width: 100%;
    height: 450px;
    overflow: hidden;
    border-top: 1px solid var(--rs-border);
    border-bottom: 1px solid var(--rs-border);
  }

  @media (max-width: 768px) {
    .contact-map-strip {
      height: 280px;
    }
  }
</style>
