---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import { getOrganizationSchema, getBreadcrumbSchema } from '../lib/schema';
import siteConfig from '../lib/site-config';
import { getPreset, interpolate } from '../lib/business-presets';
import SmartImage from '../components/SmartImage.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import PageBlockRenderer from '../components/PageBlockRenderer.astro';
import { getValidatedSchema, type PageSchemas } from '../lib/block-renderer';

const siteUrl = import.meta.env.SITE ?? siteConfig.url;
const pageUrl = `${siteUrl}/about`;

const aboutEntry = await getEntry('pages', 'about').catch(() => null);
const ap = aboutEntry?.data;
let AboutContent: any = null;
if (aboutEntry) {
  const rendered = await aboutEntry.render();
  AboutContent = rendered.Content;
}

const orgSchema = getOrganizationSchema({
  name: siteConfig.name,
  url: siteUrl,
  logo: siteConfig.logo || `${siteUrl}/favicon.svg`,
  description: siteConfig.description,
  telephone: siteConfig.phone,
  email: siteConfig.email,
  address: {
    streetAddress: siteConfig.address,
    addressLocality: siteConfig.city,
    addressRegion: siteConfig.state,
    postalCode: siteConfig.zip,
    addressCountry: siteConfig.country,
  },
  sameAs: [
    siteConfig.linkedinUrl,
    siteConfig.facebookUrl,
    siteConfig.twitterUrl,
  ].filter(Boolean) as string[],
});

const breadcrumbSchema = getBreadcrumbSchema([
  { name: 'Home', url: siteUrl },
  { name: 'About', url: pageUrl },
]);

const nicheLabel = siteConfig.niche || 'service';
const preset = getPreset((siteConfig as any).businessType || 'other');
const vars = { city: siteConfig.city, niche: nicheLabel };
const isLocalService = (siteConfig as any).businessType === 'local-service';

const hasStats = Boolean(siteConfig.yearsInBusiness || siteConfig.clientsServed);

// Capability highlights derived from the active business preset so they adapt
// to whatever business type is configured (restaurant, professional, ecommerce, etc.)
const capabilities: Array<{ label: string }> = preset.trustSignals.map((ts) => ({ label: ts.label }));
// Ensure at least a few items so the grid isn't empty
if (capabilities.length === 0) {
  capabilities.push(
    { label: 'Quality Service' },
    { label: 'Trusted & Reliable' },
    { label: 'Customer Focused' },
    { label: `${siteConfig.city || 'Local'} Based` },
  );
}

function splitH(h: string): { main: string; last: string } {
  const words = h.trim().split(/\s+/);
  if (words.length === 1) return { main: '', last: words[0] };
  return { main: words.slice(0, -1).join(' ') + ' ', last: words[words.length - 1] };
}
const aboutTitle = ap?.title || ('About ' + siteConfig.name);
const { main: aboutMain, last: aboutLast } = splitH(aboutTitle);
const whyTitle = 'Why Choose ' + siteConfig.name;
const { main: whyMain, last: whyLast } = splitH(whyTitle);

const trustSignals = [
  siteConfig.yearsInBusiness && { value: siteConfig.yearsInBusiness, label: 'Years in Business' },
  siteConfig.clientsServed && { value: siteConfig.clientsServed, label: 'Clients Served' },
  ...(isLocalService
    ? [
        { value: '5★', label: 'Rated' },
        { value: '100%', label: 'Satisfaction Guarantee' },
      ]
    : [
        { value: '★', label: 'Reputation' },
        { value: '100%', label: 'Dedication' },
      ]),
].filter(Boolean) as Array<{ value: string; label: string }>;

const teamItems: Array<{ name: string; role?: string; title?: string; bio: string; photo?: string; image?: string }> =
  Array.isArray((siteConfig as any).teamMembers) ? (siteConfig as any).teamMembers : [];

const whyUs = isLocalService ? [
  {
    title: 'Locally Owned & Operated',
    body: `${siteConfig.name} is based in ${siteConfig.city}, ${siteConfig.state} — we're your neighbors and we're invested in our community.`,
  },
  {
    title: 'Licensed & Insured',
    body: 'We carry full licensing and insurance so every project is protected from start to finish.',
  },
  {
    title: 'Transparent Pricing',
    body: 'We provide honest, upfront quotes with no hidden fees. You know exactly what you\'re paying before work begins.',
  },
  {
    title: 'Satisfaction Guaranteed',
    body: "We stand behind our work. If you're not satisfied, we make it right — no questions asked.",
  },
] : [
  {
    title: 'Quality You Can Count On',
    body: `${siteConfig.name} is committed to delivering ${nicheLabel || 'quality'} results that meet a high standard, every time.`,
  },
  {
    title: 'Personalized Approach',
    body: `We take the time to understand what you need and tailor our ${nicheLabel || 'services'} accordingly — no one-size-fits-all solutions.`,
  },
  {
    title: `Rooted in ${siteConfig.city || 'Our Community'}`,
    body: `We're proud to serve ${siteConfig.city || 'our area'} and build lasting relationships with the people we work with.`,
  },
  {
    title: 'Reliable & Responsive',
    body: `When you reach out to ${siteConfig.name}, you can expect a prompt, professional response and follow-through from start to finish.`,
  },
];

const cfgPageSchemas = (siteConfig as any).pageSchemas as PageSchemas | undefined;
const blockSchema = getValidatedSchema(cfgPageSchemas, 'about');
---

<BaseLayout
  title={`About Us | ${siteConfig.name}`}
  description={`Learn about ${siteConfig.name}${isLocalService ? ` — your trusted ${nicheLabel} experts in ${siteConfig.city}, ${siteConfig.state}.` : ` — what we do and why we do it.`}`}
  canonical={pageUrl}
  schemas={[orgSchema, breadcrumbSchema]}
>
  <main>
{blockSchema ? (
  <PageBlockRenderer pageSchemas={cfgPageSchemas} pageType="about" />
) : (
<>
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="border-b" style="background:var(--rs-surface); border-color:var(--rs-border);">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <ol class="flex items-center gap-2 text-sm text-[var(--color-text-muted)]">
          <li><a href="/" class="hover:text-[var(--rs-brand-text)] transition-colors">Home</a></li>
          <li aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </li>
          <li><span class="text-[var(--color-text)] font-medium" aria-current="page">About</span></li>
        </ol>
      </div>
    </nav>

    <!-- Hero intro -->
    <section class="py-16 sm:py-24 text-center" style="background:var(--rs-surface);">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-[var(--color-text)] mb-5">
          {aboutMain}<span class="u-gradient-text">{aboutLast}</span>
        </h1>
        <p class="text-[var(--color-text-muted)] text-lg sm:text-xl max-w-2xl mx-auto leading-relaxed">
          {ap?.description || (isLocalService ? ('Your trusted ' + nicheLabel + ' experts in ' + siteConfig.city + ', ' + siteConfig.state) : (siteConfig.description || `Learn about ${siteConfig.name} — what we do, why we do it, and the people behind it.`))}
        </p>
      </div>
    </section>

    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 flex flex-col gap-20">

      <!-- Trust signals — only shown when stats are configured -->
      {hasStats && (
        <section aria-label="Trust signals">
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
            {trustSignals.map((s) => (
              <div class="flex flex-col items-center text-center gap-1 p-6 rounded-[var(--radius-md)]" style="background:var(--rs-surface); box-shadow:var(--rs-shadow-card); border:1px solid var(--rs-border);">
                <span class="text-3xl font-bold" style="color:var(--rs-brand-text);">{s.value}</span>
                <span class="text-sm text-[var(--color-text-muted)] font-medium">{s.label}</span>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Our Story — Option B: single-column, image between heading and prose -->
      <section>
        <div class="max-w-[740px] mx-auto flex flex-col gap-6">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-text)]">Our <span class="u-gradient-text">Story</span></h2>
          <div class="rounded-[var(--radius-lg)] overflow-hidden" style="max-width:640px;">
            <SmartImage
              src={ap?.heroImage ?? ''}
              alt={`${siteConfig.name} team`}
              aspect="16/9"
              loading="lazy"
            />
          </div>
          <div class="flex flex-col gap-4 text-[var(--color-text-muted)] leading-relaxed">
            {AboutContent ? (
              <div class="prose prose-neutral prose-lg max-w-none">
                <AboutContent />
              </div>
            ) : (
              <>
                {isLocalService ? (
                  <>
                    <p>
                      {siteConfig.name} is a locally owned {nicheLabel} business serving {siteConfig.city} and the surrounding area. We are committed to providing quality service with honest pricing and professional results.
                    </p>
                    <p>
                      Our team takes pride in every job we complete — from the smallest task to the largest project. We treat every customer's home or business with the respect and care it deserves.
                    </p>
                    <p>
                      When you choose {siteConfig.name}, you're choosing a team that stands behind its work and is dedicated to your complete satisfaction.
                    </p>
                  </>
                ) : (
                  <>
                    <p>
                      {siteConfig.name} is a {nicheLabel || 'business'} based in {siteConfig.city}{siteConfig.state ? `, ${siteConfig.state}` : ''}. {siteConfig.description || `We pride ourselves on delivering quality ${nicheLabel || 'service'} and building lasting relationships with the people we work with.`}
                    </p>
                    <p>
                      Our approach is simple: understand what you need, deliver it well, and stand behind our work. Whether it's a quick question or a larger project, we give every client the same level of attention and care.
                    </p>
                    <p>
                      We're proud to be part of the {siteConfig.city || 'local'} community and grateful for every person who chooses {siteConfig.name}.
                    </p>
                  </>
                )}
              </>
            )}
          </div>
        </div>
      </section>

      <!-- Trust highlights -->
      {capabilities.length > 0 && (
      <section>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-text)] mb-8 text-center">{splitH(preset.servicesHeading).main}<span class="u-gradient-text">{splitH(preset.servicesHeading).last}</span></h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {capabilities.map((cap) => (
            <div class="flex items-center gap-3 p-5 rounded-[var(--radius-md)]" style="background:var(--rs-surface); box-shadow:var(--rs-shadow-card); border:1px solid var(--rs-border);">
              <div class="flex-shrink-0 w-8 h-8 rounded-lg flex items-center justify-center" style="background:color-mix(in srgb, var(--rs-accent) 12%, transparent);">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--rs-brand-text)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <span class="text-sm font-semibold text-[var(--color-text)]">{cap.label}</span>
            </div>
          ))}
        </div>
      </section>
      )}

      <!-- Our Team -->
      {teamItems.length > 0 && (
      <section>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-text)] mb-8 text-center">Our <span class="u-gradient-text">Team</span></h2>
        <div class={`grid grid-cols-1 gap-8 ${teamItems.length === 1 ? 'max-w-sm mx-auto' : teamItems.length === 2 ? 'sm:grid-cols-2 max-w-2xl mx-auto' : 'sm:grid-cols-3'}`}>
          {teamItems.map((member) => (
            <div class="flex flex-col items-center text-center gap-4 p-6 rounded-[var(--radius-md)]" style="background:var(--rs-surface); box-shadow:var(--rs-shadow-card); border:1px solid var(--rs-border);">
              <div class="flex-shrink-0 w-20 h-20 rounded-full overflow-hidden flex items-center justify-center" style={(member.photo || member.image) ? '' : 'background-color:var(--rs-accent); color:var(--rs-on-brand);'}>
                {(member.photo || member.image)
                  ? <img src={member.photo ?? member.image} alt={member.name} class="w-full h-full object-cover" loading="lazy" />
                  : <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                }
              </div>
              <div>
                <p class="font-semibold text-[var(--color-text)]">{member.name}</p>
                <p class="text-sm font-medium" style="color:var(--rs-brand-text);">{member.role ?? member.title}</p>
              </div>
              <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{member.bio}</p>
            </div>
          ))}
        </div>
      </section>
      )}

      <!-- Why Choose Us -->
      <section>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-text)] mb-8 text-center">{whyMain}<span class="u-gradient-text">{whyLast}</span></h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {whyUs.map((item) => (
            <div class="flex items-start gap-4 p-6 rounded-[var(--radius-md)]" style="background:var(--rs-surface); box-shadow:var(--rs-shadow-card); border:1px solid var(--rs-border);">
              <div class="flex-shrink-0 w-8 h-8 rounded-lg flex items-center justify-center" style="background:color-mix(in srgb, var(--rs-accent) 12%, transparent);">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--rs-brand-text)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-[var(--color-text)] mb-1">{item.title}</h3>
                <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{item.body}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

    </div>

    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <RelatedLinks links={ap?.relatedLinks ?? []} />
    </div>

    <!-- Closing CTA -->
    <section class="py-16 sm:py-20 text-center" style="background:var(--rs-surface); border-top:1px solid var(--rs-border);">
      <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center gap-5">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-text)]">
          {(() => { const c = splitH(preset.ctaBand.heading); return <>{c.main}<span class="u-gradient-text">{c.last}</span></>; })()}
        </h2>
        <p class="text-[var(--color-text-muted)] text-lg leading-relaxed">
          {preset.ctaBand.subtext}
        </p>
        <a href={preset.ctaBand.buttonHref} class="u-btn u-btn-primary" style="padding:.875rem 2rem; font-size:1rem;">
          {preset.ctaBand.buttonLabel}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </section>


</>
)}
  </main>
</BaseLayout>
