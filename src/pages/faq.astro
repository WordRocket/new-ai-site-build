---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFAQSchema, getBreadcrumbSchema } from '../lib/schema';
import siteConfig from '../lib/site-config';
import { getEntry } from 'astro:content';

const siteUrl = import.meta.env.SITE ?? siteConfig.url;
const pageUrl = `${siteUrl}/faq`;

const entry = await getEntry('pages', 'faq').catch(() => undefined);
if (!entry) return Astro.redirect('/404', 404);

const { faq = [], faqCategories, faqPageTitle, faqPageDescription } = entry.data;

// Build a normalised categories array regardless of which shape Railway wrote
type FaqItem = { question: string; answer: string };
type Category = { id: string; label: string; items: FaqItem[] };

const categories: Category[] = faqCategories
  ? faqCategories.map((c, i) => ({ id: `cat${i}`, label: c.label, items: c.items }))
  : faq.length > 0
    ? [{ id: 'cat0', label: '', items: faq }]
    : [];

const allItems: FaqItem[] = categories.flatMap((c) => c.items);

const pageTitle = faqPageTitle ?? `Frequently Asked Questions | ${siteConfig.name}`;
const pageDescription = faqPageDescription ?? `Find answers to common questions about ${siteConfig.name}.`;

const faqSchema = allItems.length > 0 ? getFAQSchema(allItems) : null;
const breadcrumbSchema = getBreadcrumbSchema([
  { name: 'Home', url: siteUrl },
  { name: 'FAQ', url: pageUrl },
]);
const schemas = [breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={pageUrl}
  schemas={schemas}
>
  <main>
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="border-b" style="background:var(--rs-surface); border-color:var(--rs-border);">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <ol class="flex items-center gap-2 text-sm text-[var(--color-text-muted)]">
          <li><a href="/" class="hover:text-[var(--rs-brand-text)] transition-colors">Home</a></li>
          <li aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </li>
          <li><span class="text-[var(--color-text)] font-medium" aria-current="page">FAQ</span></li>
        </ol>
      </div>
    </nav>

    <!-- Header -->
    <section class="py-14 sm:py-20 text-center" style="background:var(--rs-surface-2);">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-[var(--color-text)] mb-4">Frequently Asked Questions</h1>
        <p class="text-[var(--color-text-muted)] text-lg max-w-xl mx-auto">
          Everything you need to know. Can't find your answer?{' '}
          <a href="/contact" class="underline hover:text-[var(--rs-brand-text)]">Ask us directly.</a>
        </p>
      </div>
    </section>

    <!-- FAQ body -->
    <div class="max-w-[800px] mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 flex flex-col gap-14">
      {categories.length === 0 ? (
        <p class="text-center text-[var(--color-text-muted)]">No questions available yet.</p>
      ) : (
        categories.map((cat) => (
          <section aria-labelledby={cat.label ? `cat-${cat.id}` : undefined}>
            {cat.label && (
              <h2 id={`cat-${cat.id}`} class="text-xl font-bold text-[var(--color-text)] mb-6 pb-3" style="border-bottom:1px solid var(--rs-border);">
                {cat.label}
              </h2>
            )}
            <div class="flex flex-col">
              {cat.items.map((item, i) => {
                return (
                  <details class="rs-faq-item">
                    <summary class="rs-faq-q">
                      <h3 class="text-base font-semibold m-0">{item.question}</h3>
                      <svg class="rs-faq-chevron" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </summary>
                    <div class="rs-faq-a"><div><p>{item.answer}</p></div></div>
                  </details>
                );
              })}
            </div>
          </section>
        ))
      )}

      <!-- CTA -->
      <div class="text-center py-10 px-6 rounded-[var(--radius-lg)]" style="background:var(--rs-surface-2); border:1px solid var(--rs-border);">
        <p class="text-base font-semibold text-[var(--color-text)] mb-1">Have another question?</p>
        <p class="text-sm text-[var(--color-text-muted)] mb-5">Our team usually responds within one business day.</p>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-[var(--radius-md)] text-sm font-semibold transition-opacity hover:opacity-90"
          style="background-color:var(--rs-accent); color:var(--rs-on-brand);"
        >
          Contact Us
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
