---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteConfig, { cleanTitle } from '../../lib/site-config';
import SmartImage from '../../components/SmartImage.astro';

const isGeneral = (siteConfig as any).businessType === 'general';
if (!isGeneral) {
  return Astro.redirect('/404');
}

const all = await getCollection('categories');
const categories = all
  .filter((c) => c.data.published !== false)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));

// Get post counts per category
const allPosts = await getCollection('blog').catch(() => []);
const postCountByCategory: Record<string, number> = {};
for (const post of allPosts) {
  const cat = (post.data.category || '').trim().toLowerCase();
  if (cat) postCountByCategory[cat] = (postCountByCategory[cat] || 0) + 1;
}

const blogIntro: string = ((siteConfig as any).blogIntro as string | undefined)?.trim() || '';
const description = blogIntro || `Explore all categories from ${siteConfig.name}.`;
const totalArticles = allPosts.length;
---

<BaseLayout
  title={`Categories | ${siteConfig.name}`}
  description={description}
>
  <main>
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="border-b" style="background:var(--rs-surface); border-color:var(--rs-border);">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <ol class="flex items-center gap-2 text-sm text-[var(--color-text-muted)]">
          <li><a href="/" class="hover:text-[var(--rs-brand-text)] transition-colors">Home</a></li>
          <li aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </li>
          <li><span class="text-[var(--color-text)] font-medium" aria-current="page">Categories</span></li>
        </ol>
      </div>
    </nav>

    <!-- Header -->
    <section class="cat-index-hero">
      <div class="cat-index-hero__inner">
        <span class="cat-index-hero__eyebrow u-eyebrow">Browse Topics</span>
        <h1 class="cat-index-hero__title">Categories</h1>
        <p class="cat-index-hero__desc">{description}</p>
        {categories.length > 0 && (
          <div class="cat-index-hero__stats">
            <div class="cat-index-hero__stat">
              <span class="cat-index-hero__stat-value">{categories.length}</span>
              <span class="cat-index-hero__stat-label">{categories.length === 1 ? 'Category' : 'Categories'}</span>
            </div>
            {totalArticles > 0 && (
              <div class="cat-index-hero__stat-divider" aria-hidden="true"></div>
            )}
            {totalArticles > 0 && (
              <div class="cat-index-hero__stat">
                <span class="cat-index-hero__stat-value">{totalArticles}</span>
                <span class="cat-index-hero__stat-label">{totalArticles === 1 ? 'Article' : 'Articles'}</span>
              </div>
            )}
          </div>
        )}
      </div>
    </section>

    <!-- Category grid -->
    <section class="py-16 sm:py-20">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
        {categories.length === 0 ? (
          <div class="cat-empty">
            <div class="cat-empty__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/></svg>
            </div>
            <h2 class="cat-empty__title">Categories coming soon</h2>
            <p class="cat-empty__text">We're organizing our content — check back shortly for topics and articles.</p>
          </div>
        ) : (
          <ul class="cat-grid" role="list">
            {categories.map((cat) => {
              const desc = cat.data.shortDescription || cat.data.description;
              const image = cat.data.featuredImage || cat.data.heroImage || cat.data.sectionImage;
              const variants = cat.data.featuredImageVariants || cat.data.heroImageVariants || cat.data.sectionImageVariants;
              const postCount = postCountByCategory[cat.data.title.trim().toLowerCase()] || 0;
              return (
                <li>
                  <a href={`/category/${cat.slug}`} class="cat-gen-card" style="text-decoration:none;">
                    <div class="cat-gen-card__img">
                      <SmartImage
                        src={image}
                        alt={cat.data.title}
                        aspect="16/9"
                        imgWidth={400}
                        variants={variants}
                        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                      />
                      <span class="cat-gen-card__count">{postCount} {postCount === 1 ? 'Article' : 'Articles'}</span>
                    </div>
                    <div class="cat-gen-card__body">
                      <span class="cat-gen-card__cat">Category</span>
                      <h2 class="cat-gen-card__title">{cleanTitle(cat.data.title)}</h2>
                      {desc && <p class="cat-gen-card__excerpt">{desc}</p>}
                      <span class="cat-gen-card__cta">
                        Explore
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                      </span>
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        )}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* Hero */
  .cat-index-hero {
    background: var(--rs-surface);
    border-bottom: 1px solid var(--rs-border);
    padding: 3rem 1rem 3.5rem;
    text-align: center;
  }
  .cat-index-hero__inner {
    max-width: 640px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .cat-index-hero__eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--rs-brand-text);
  }
  .cat-index-hero__title {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0;
    color: var(--rs-heading-color);
  }
  .cat-index-hero__desc {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--rs-text-muted);
    margin: 0;
    max-width: 480px;
  }
  .cat-index-hero__stats {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 0.5rem;
  }
  .cat-index-hero__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
  }
  .cat-index-hero__stat-value {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--rs-heading-color);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .cat-index-hero__stat-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--rs-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .cat-index-hero__stat-divider {
    width: 1px;
    height: 32px;
    background: var(--rs-border);
  }

  /* Grid */
  .cat-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
    align-items: stretch;
  }
  @media (min-width: 640px) { .cat-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .cat-grid { grid-template-columns: repeat(3, 1fr); } }

  /* Empty state */
  .cat-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 4rem 1rem;
    text-align: center;
  }
  .cat-empty__icon {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--rs-brand) 8%, transparent);
    color: var(--rs-brand);
  }
  .cat-empty__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--rs-text);
    margin: 0;
  }
  .cat-empty__text {
    font-size: 0.9375rem;
    color: var(--rs-text-muted);
    margin: 0;
    max-width: 360px;
  }
</style>
